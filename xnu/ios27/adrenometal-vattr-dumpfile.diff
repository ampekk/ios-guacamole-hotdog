+// 2026-11-19 (ios-sweet): MTLFunction's vertexAttributes / stageInputAttributes. bgfx (Minecraft's Renderdragon) builds each
+// pipeline's vertex descriptor from vertexAttributes; unanswered, every descriptor was empty and nothing drew. -1: nil.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_function_attribute_count(function: *const NmbFunction, stage_input: bool) -> i32 {
+    guard(-1, || {
+        let f = &get(function)?.0;
+        let list = (if stage_input { f.stage_input_attributes() } else { f.vertex_attributes() }).map_err(e("function attributes"))?;
+        Ok(list.map_or(-1, |l| l.len() as i32))
+    })
+}
+
+/// Attribute `at`: its name (NUL-terminated in `capacity` bytes), `[[attribute(n)]]`, MTLDataType, and flags (1 active, 2 patch
+/// data, 4 patch control point data).
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_function_attribute_at(function: *const NmbFunction, stage_input: bool, at: u32, name: *mut c_char, capacity: usize,
+                                            index: *mut u64, data_type: *mut u64, flags: *mut u32) -> bool {
+    guard(false, || {
+        let f = &get(function)?.0;
+        let list = (if stage_input { f.stage_input_attributes() } else { f.vertex_attributes() }).map_err(e("function attributes"))?;
+        let list = list.ok_or("no attributes")?;
+        let a = list.get(at as usize).ok_or("no such attribute")?;
+        if name.is_null() || capacity == 0 || index.is_null() || data_type.is_null() || flags.is_null() {
+            return Err("null out".into());
+        }
+        let bytes = a.name().as_bytes();
+        let n = bytes.len().min(capacity - 1);
+        // SAFETY: the caller gives `capacity` bytes at `name` and one word at each other pointer.
+        unsafe {
+            std::ptr::copy_nonoverlapping(bytes.as_ptr(), name as *mut u8, n);
+            *name.add(n) = 0;
+            *index = u64::from(a.attribute_index());
+            *data_type = u64::from(a.attribute_type().as_raw());
+            *flags = u32::from(a.is_active()) | (u32::from(a.is_patch_data()) << 1) | (u32::from(a.is_patch_control_point_data()) << 2);
+        }
+        Ok(true)
+    })
+}
