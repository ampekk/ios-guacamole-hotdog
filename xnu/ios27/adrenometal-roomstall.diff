+ /// handed and not taken, until the lowering thread takes one (the module docs); where `worker`,
+ /// the device's lowering thread, is none, lowers no more or left the slot, or the process exits,
+ /// lower them on this thread instead.
+-fn wait_for_room(slot: &LoweringSlot, device: &Device, worker: Option<&LoweringWorker>) {
++///
++/// A wait that sees no progress for [`exit_guard::WAKE`] (the slot not being lowered and its
++/// batches still all handed) hands the slot to the thread again, and after two more such waits
++/// lowers the batches on this thread, as where the thread lowers no more. (ios-sweet guacamole,
++/// 2026-11-19: Candy Crush froze 10 s at a time with its main thread here, the slot `queued`, and
++/// the lowering thread parked with an empty queue: a hand-off lost somewhere. A slot handed twice
++/// is harmless: the thread finds nothing left the second time and leaves it unqueued.) Each such
++/// recovery is counted in [`ROOM_STALLS`].
++fn wait_for_room(slot: &Arc<LoweringSlot>, device: &Device, worker: Option<&LoweringWorker>) {
+     let mut state = lock(&slot.state);
+     device.shared().counts.render_log_waited();
++    let mut stalls = 0u32;
+     loop {
+         if state.handed.len() < HANDED_BATCHES {
+             return;
+@@ -989,11 +998,33 @@
+         if !lowers || exit_guard::closed() || state.panicked {
+             break;
+         }
+-        state = (slot.handed_back.wait(state)).unwrap_or_else(std::sync::PoisonError::into_inner);
++        let handed = state.handed.len();
++        let (next, waited) = (slot.handed_back.wait_timeout(state, exit_guard::WAKE))
++            .unwrap_or_else(std::sync::PoisonError::into_inner);
++        state = next;
++        if !waited.timed_out() || state.busy || state.handed.len() < handed {
++            stalls = 0;
++            continue;
++        }
++        stalls += 1;
++        ROOM_STALLS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
++        if stalls >= 3 {
++            break;
++        }
++        if stalls == 1 {
++            if let Some(worker) = worker {
++                drop(state);
++                worker.hand(slot);
++                state = lock(&slot.state);
++            }
++        }
+     }
+     slot.drain_locked(state, 0, |_, _| ());
+ }
