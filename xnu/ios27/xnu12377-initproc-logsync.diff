--- research/ios27.2/kernel-backup/sweet_ufs.c.before-logsync	2026-11-14 06:54:52.353014267 +0000
+++ work/xnu-12377/bsd/dev/sweet_ufs.c	2026-11-14 06:54:52.373300139 +0000
@@ -828,6 +828,32 @@
 	uint64_t total, seq;
 };
 
+static uint64_t _Atomic sweet_log_flushed;
+static bool sweet_log_running;
+
+/*
+ * SWEET: write everything logged so far to the partition now and wait (up to ms)
+ * for it. For paths that are about to panic in a normal thread context (initproc
+ * exit, kern_exit.c), so the last lines (launchd's own abort message, CRASH lines)
+ * reach the disk instead of dying in the ring between two periodic flushes.
+ */
+void sweet_log_sync(uint32_t ms);
+void
+sweet_log_sync(uint32_t ms)
+{
+	if (!sweet_log_running) {
+		return;
+	}
+	uint64_t want = os_atomic_load(&sweet_log_total, relaxed);
+	for (uint32_t waited = 0; waited < ms; waited += 10) {
+		if (os_atomic_load(&sweet_log_flushed, relaxed) >= want) {
+			return;
+		}
+		wakeup(&sweet_log_chan);
+		delay(10 * 1000);
+	}
+}
+
 static void
 sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -875,6 +901,7 @@
 			return;
 		}
 		flushed = total;
+		os_atomic_store(&sweet_log_flushed, flushed, relaxed);
 	}
 }
 
@@ -893,6 +920,7 @@
 		sweet_log_secs = SWEET_LOG_SECS;
 	}
 	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		sweet_log_running = true;
 		thread_deallocate(thread);
 	}
 }
