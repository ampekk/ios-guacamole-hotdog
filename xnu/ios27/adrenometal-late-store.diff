+/// `setColorStoreAction:atIndex:` (which 0, index), `setDepthStoreAction:` (1), `setStencilStoreAction:` (2): the store
+/// action of an attachment the pass descriptor left `Unknown` (2026-11-18: Unity begins every pass that way and names the
+/// action just before endEncoding; without this the action stayed `Unknown`, lowered as `DontCare`, and nothing it drew
+/// reached the drawable: Subway Surfers all black).
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_encoder_set_store_action(encoder: *mut NmbEncoder, which: u32, index: u32, action: u64) -> bool {
+    guard(false, || {
+        let action = StoreAction::from_raw(action).map_err(e("store action"))?;
+        match get_mut(encoder)? {
+            NmbEncoder::Render(r) => match which {
+                0 => r.set_color_store_action(action, index),
+                1 => r.set_depth_store_action(action),
+                2 => r.set_stencil_store_action(action),
+                _ => return Err(format!("store action of attachment kind {which}")),
+            },
+            _ => return Err("store action on an encoder that is not a render encoder".to_string()),
+        }
+        .map_err(e("set store action"))?;
+        Ok(true)
+    })
+}
