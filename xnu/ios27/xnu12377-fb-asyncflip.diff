+/*
+ * 2026-11-17 async flip: every 0.5 ms while a flip is outstanding. Programs it once the blit's fence has passed, notices
+ * when the display took it, and then shows the frame that came in meanwhile (the latest swap, fDirty), as the swap
+ * itself would have. Runs on the work loop, like vsyncFired.
+ */
+void
+AppleCLCD::flipFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	if (!sweet_fbflip.ok || fb->fPresentLock == NULL) {
+		return;
+	}
+	if (!IOLockTryLock(fb->fPresentLock)) {
+		sender->setTimeoutUS(500);
+		return;
+	}
+	bool settled = fbflip_settled();
+	IOLockUnlock(fb->fPresentLock);
+	if (!settled) {
+		sender->setTimeoutUS(500);
+		return;
+	}
+	uint8_t *rec = NULL;
+	IOLockLock(fb->fLock);
+	if (fb->fDirty && !fb->fPowerOff && sweet_fb_metal) {
+		rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+		if (rec != NULL) {
+			memcpy(rec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
+		}
+	}
+	IOLockUnlock(fb->fLock);
+	if (rec == NULL) {
+		return;
+	}
+	int shown = 0;
+	if (IOLockTryLock(fb->fPresentLock)) {
+		shown = fb->presentGPU(rec);           /* re-arms this timer itself when it has to wait again */
+		IOLockUnlock(fb->fPresentLock);
+	} else {
+		sender->setTimeoutUS(500);
+	}
+	if (shown > 0) {
+		sweet_fb_stats.at_swap++;
+		IOLockLock(fb->fLock);
+		if (memcmp(fb->fPending, rec, SWEET_FB_SWAP_REC_SIZE) == 0) {
+			fb->fDirty = false;
+		}
+		IOLockUnlock(fb->fLock);
+		fb->shown(rec);
+	}
+	IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+}
