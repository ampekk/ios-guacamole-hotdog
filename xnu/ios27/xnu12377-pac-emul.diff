+	/*
+	 * FEAT_PAuth (v8.3) outside the HINT space: the iOS 27 userland is arm64e-only and JavaScriptCore's JIT emits
+	 * these at run time (the lowering only rewrote the code on disk). The A76/A55 have no pointer authentication,
+	 * so nothing is ever signed here: PAC* / AUT* / XPAC* leave the register as it is, the authenticated branches
+	 * and loads are the plain ones. (PACIASP, AUTIBSP, XPACLRI etc. are HINTs: NOPs on this CPU, no trap.)
+	 */
+	if ((instr & 0xfe1ff800) == 0xd61f0800) {       /* BRAA(Z)/BRAB(Z), BLRAA(Z)/BLRAB(Z), RETAA/RETAB */
+		unsigned z = (instr >> 24) & 1, opc = (instr >> 21) & 7, rn = (instr >> 5) & 31, rm = instr & 31;
+		uint64_t pc = saved_state64(state)->pc, target;
+		if (opc == 2 && !z && rn == 31 && rm == 31) {
+			target = sweet_xreg(state, 30, false);
+			sweet_emul_note("RETAx", state, instr);
+		} else if (opc <= 1 && (z || rm == 31)) {
+			target = sweet_xreg(state, rn, false);
+			if (opc == 1) {
+				sweet_set_xreg(state, 30, pc + 4);
+			}
+			sweet_emul_note(opc == 1 ? "BLRAx" : "BRAx", state, instr);
+		} else {
+			goto undef;
+		}
+		saved_state64(state)->pc = target;
+		return true;
+	}
+	if ((instr & 0xffff8000) == 0xdac10000 && ((instr >> 10) & 0x3f) <= 0x11) {
+		/* PACIA..AUTDB, PACIZA..AUTDZB, XPACI/XPACD: Rd keeps its value */
+		sweet_emul_note("PAC/AUT/XPAC", state, instr);
+		goto done;
+	}
+	if ((instr & 0xffe0fc00) == 0x9ac03000) {       /* PACGA Xd, Xn, Xm|SP: a 32-bit code in the top half */
+		uint64_t h = sweet_xreg(state, (instr >> 5) & 31, false) * 0x9e3779b97f4a7c15ull;
+		h ^= sweet_xreg(state, (instr >> 16) & 31, true) + 0x632be59bd9b4e019ull + (h << 6) + (h >> 2);
+		h *= 0xbf58476d1ce4e5b9ull;
+		sweet_set_xreg(state, instr & 31, (h ^ (h >> 29)) & 0xffffffff00000000ull);
+		sweet_emul_note("PACGA", state, instr);
+		goto done;
+	}
+	if ((instr & 0xff200400) == 0xf8200400) {       /* LDRAA/LDRAB Xt, [Xn|SP, #simm10*8]{!} */
+		unsigned rn = (instr >> 5) & 31, rt = instr & 31, w = (instr >> 11) & 1;
+		int64_t off = (int64_t)((((instr >> 22) & 1) << 9) | ((instr >> 12) & 0x1ff));
+		off = (off << 54) >> 54;
+		user_addr_t addr = (user_addr_t)(sweet_xreg(state, rn, true) + (uint64_t)(off * 8));
+		uint64_t v;
+		if (copyin(addr, &v, 8) != 0) {
+			return false;
+		}
+		if (w) {
+			if (rn == 31) {
+				saved_state64(state)->sp = addr;
+			} else {
+				sweet_set_xreg(state, rn, addr);
+			}
+		}
+		sweet_set_xreg(state, rt, v);
+		sweet_emul_note("LDRAx", state, instr);
+		goto done;
+	}
+	if ((instr & 0xfffffc00) == 0x1e7e0000 && current_thread()->machine.uNeon != NULL) {
+		/* FJCVTZS Wd, Dn (FEAT_JSCVT): double -> int32 as JavaScript's ToInt32, Z = exact */
+		arm_neon_saved_state64_t *ns = neon_state64(current_thread()->machine.uNeon);
+		uint64_t bits = ((uint64_t *)&ns->v.q[(instr >> 5) & 31])[0];
+		unsigned exp = (unsigned)((bits >> 52) & 0x7ff);
+		uint64_t mant = bits & ((1ull << 52) - 1);
+		bool neg = bits >> 63, exact = false;
+		uint32_t r = 0;
+		if (exp == 0x7ff) {
+			r = 0;
+		} else if (exp == 0) {
+			exact = mant == 0 && !neg;      /* +0 exact; -0 and denormals are not */
+		} else {
+			mant |= 1ull << 52;
+			int sh = (int)exp - 1075;
+			uint64_t ip;
+			bool frac = false, big = false;
+			if (sh >= 0) {
+				ip = sh >= 64 ? 0 : mant << sh;
+				big = sh > 10;          /* |value| >= 2^63 > int32 */
+			} else if (sh <= -64) {
+				ip = 0; frac = true;
+			} else {
+				ip = mant >> -sh; frac = (mant & ((1ull << -sh) - 1)) != 0;
+			}
+			r = (uint32_t)ip;
+			if (neg) {
+				r = (uint32_t)-r;
+			}
+			exact = !frac && !big && (neg ? ip <= 0x80000000ull : ip <= 0x7fffffffull) && !(neg && ip == 0);
+		}
+		sweet_set_xreg(state, instr & 31, r);
+		cpsr &= ~(SWEET_PSR_N | SWEET_PSR_Z | SWEET_PSR_C | SWEET_PSR_V);
+		cpsr |= exact ? SWEET_PSR_Z : 0;
+		sweet_emul_note("FJCVTZS", state, instr);
+		goto flags;
+	}
