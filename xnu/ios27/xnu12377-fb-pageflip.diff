 /* Read-only probe of the physical framebuffer scanned by the panel. Five bands,
  * each four full-width rows; run once a second only when explicitly enabled. */
+/*
+ * 2026-11-17 page flip. The panel (DSI command mode) is refreshed from ONE buffer, ABL's splash at 0x9c000000, which the
+ * display controller re-reads on every TE (INTF1 autorefresh, 59.86 Hz); the GPU present wrote CoreAnimation's frame
+ * into that same buffer whenever a swap came, and its writes leave the colour cache 64 bytes at a time over a few
+ * milliseconds, so a refresh taken meanwhile sent the panel a scatter of old and new lines (user photos 11-17: dashes
+ * and trails where things move; iOS screenshots of the same moments are clean). Now two buffers: the blit goes into
+ * the one the pipes do not read, and once its fence has passed the two source pipes are pointed at it (VIG0 feeds LM0,
+ * the left 720 columns; VIG1 feeds LM1 with SRC_XY 720: scanprobe 11-17, both SRC0_ADDR 0x9c000000, stride 5760),
+ * CTL0 FLUSH bits 0|1, which the controller takes at the next frame start (FLUSH reads 0 again then). A buffer is
+ * written again only after the flip away from it was taken. The second buffer is 18 MB into ABL's 36 MB cont-splash
+ * region (msmnile: 0x9c000000 + 0x2400000), which XNU does not use (its RAM is the high bank) and which the display
+ * already reads from (the DSI packet buffer at 0x9d124000 lies past the first frame). CPU paths (compose, present,
+ * the power-off clear) still write the first buffer: they flip back to it first.
+ * Boot-arg sweetfbflip=0: one buffer, as before.
+ */
+#define FBFLIP_MDP_PA           0x0ae00000ull   /* MDSS; the MDP block is at +0x1000 */
+#define FBFLIP_MDP_BYTES        0x8000u
+#define FBFLIP_CTL0_LAYER0      0x2000u
+#define FBFLIP_CTL0_LAYER1      0x2004u
+#define FBFLIP_CTL0_FLUSH       0x2018u
+#define FBFLIP_VIG0             0x5000u
+#define FBFLIP_VIG1             0x7000u
+#define FBFLIP_SRC0_ADDR        0x014u
+#define FBFLIP_YSTRIDE0         0x024u
+#define FBFLIP_FLUSH_BITS       0x3u            /* VIG0 | VIG1 */
+#define FBFLIP_SECOND           0x1200000ull
+
+static struct {
+	bool tried, ok;
+	volatile uint32_t *mdp;
+	uint64_t pa[2];
+	unsigned front;                 /* the buffer the pipes read (once taken) */
+	unsigned pending;               /* 1 + the buffer to flip to once pending_fence passes; 0: none */
+	uint32_t pending_fence;
+	bool latching;                  /* flip written, FLUSH bits not yet taken */
+	uint32_t flips, busy, cpu_back, slow;
+} sweet_fbflip;
+
+static inline uint32_t
+fbflip_rd(uint32_t off)
+{
+	return sweet_fbflip.mdp[off / 4];
+}
+
+static inline void
+fbflip_wr(uint32_t off, uint32_t v)
+{
+	sweet_fbflip.mdp[off / 4] = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+fbflip_program(unsigned b)
+{
+	fbflip_wr(FBFLIP_VIG0 + FBFLIP_SRC0_ADDR, (uint32_t)sweet_fbflip.pa[b]);
+	fbflip_wr(FBFLIP_VIG1 + FBFLIP_SRC0_ADDR, (uint32_t)sweet_fbflip.pa[b]);
+	fbflip_wr(FBFLIP_CTL0_FLUSH, FBFLIP_FLUSH_BITS);
+	sweet_fbflip.front = b;
+	sweet_fbflip.latching = true;
+	sweet_fbflip.flips++;
+}
+
+/* Advance: program a flip whose blit has finished, notice a flip taken. True when nothing is outstanding. */
+static bool
+fbflip_settled(void)
+{
+	if (!sweet_fbflip.ok) {
+		return true;
+	}
+	if (sweet_fbflip.pending != 0) {
+		if (sweet_gpu_wait_fence_ns(sweet_fbflip.pending_fence, 0) != 0) {
+			return false;
+		}
+		fbflip_program(sweet_fbflip.pending - 1);
+		sweet_fbflip.pending = 0;
+	}
+	if (sweet_fbflip.latching) {
+		if (fbflip_rd(FBFLIP_CTL0_FLUSH) & FBFLIP_FLUSH_BITS) {
+			return false;
+		}
+		sweet_fbflip.latching = false;
+	}
+	return true;
+}
+
+/*
+ * Up to ms milliseconds for the last flip to be programmed and taken (polling: a nonzero fence timeout would count as a
+ * hang). Called before a blit into the other buffer: the swap waits for the previous frame to reach the panel, as a
+ * double-buffered swap does, instead of leaving it to the next vsync tick (which halved the frame rate).
+ */
+static bool
+fbflip_wait(unsigned ms)
+{
+	for (unsigned i = 0; i < ms; i++) {
+		if (fbflip_settled()) {
+			return true;
+		}
+		IOSleep(1);
+	}
+	return fbflip_settled();
+}
+
+/* Before the CPU writes the panel (it writes the first buffer): everything settled, the pipes back on buffer 0. */
+static void
+fbflip_for_cpu(void)
+{
+	if (!sweet_fbflip.ok) {
+		return;
+	}
+	for (int i = 0; i < 100 && !fbflip_settled(); i++) {
+		IODelay(1000);
+	}
+	if (sweet_fbflip.pending != 0 || sweet_fbflip.latching) {
+		sweet_fbflip.slow++;
+		sweet_fbflip.pending = 0;
+	}
+	if (sweet_fbflip.front != 0) {
+		fbflip_program(0);
+		for (int i = 0; i < 50 && (fbflip_rd(FBFLIP_CTL0_FLUSH) & FBFLIP_FLUSH_BITS); i++) {
+			IODelay(1000);
+		}
+		sweet_fbflip.latching = false;
+		sweet_fbflip.cpu_back++;
+	}
+}
+
+static void fbflip_setup(uint64_t panel_pa, uint32_t row_bytes, uint64_t panel_bytes, uintptr_t panel_cpu);
+
