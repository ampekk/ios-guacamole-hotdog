+static void
+fbflip_setup(uint64_t panel_pa, uint32_t row_bytes, uint64_t panel_bytes, uintptr_t panel_cpu)
+{
+	if (sweet_fbflip.tried) {
+		return;
+	}
+	sweet_fbflip.tried = true;
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("sweetfbflip", &on, sizeof(on));
+	if (!on) {
+		IOLog("SWEET FB: page flip off (sweetfbflip=0): one panel buffer\n");
+		return;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(FBFLIP_MDP_PA, FBFLIP_MDP_BYTES, kIODirectionInOut);
+	IOMemoryMap *map = md != NULL ? md->map(kIOMapInhibitCache) : NULL;
+	if (map == NULL) {
+		IOLog("SWEET FB: page flip: display controller not mapped\n");
+		OSSafeReleaseNULL(md);
+		return;
+	}
+	sweet_fbflip.mdp = (volatile uint32_t *)map->getVirtualAddress();
+	uint32_t ver = fbflip_rd(0), l0 = fbflip_rd(FBFLIP_CTL0_LAYER0), l1 = fbflip_rd(FBFLIP_CTL0_LAYER1);
+	uint32_t a0 = fbflip_rd(FBFLIP_VIG0 + FBFLIP_SRC0_ADDR), a1 = fbflip_rd(FBFLIP_VIG1 + FBFLIP_SRC0_ADDR);
+	uint32_t s0 = fbflip_rd(FBFLIP_VIG0 + FBFLIP_YSTRIDE0), s1 = fbflip_rd(FBFLIP_VIG1 + FBFLIP_YSTRIDE0);
+	if ((ver >> 28) != 5 || l0 != 0x01000005u || l1 != 0x01000028u || a0 != (uint32_t)panel_pa ||
+	    a1 != (uint32_t)panel_pa || panel_pa >> 32 || s0 != row_bytes || s1 != row_bytes ||
+	    round_page_64(panel_bytes) > FBFLIP_SECOND ||
+	    FBGPU_PANEL_OFF + FBFLIP_SECOND + round_page_64(panel_bytes) > FBGPU_SLOT_OFF) {
+		IOLog("SWEET FB: page flip: display not as probed (MDSS %08x, LAYER %08x %08x, SRC0 %08x %08x, stride %u %u): "
+		    "one panel buffer\n", ver, l0, l1, a0, a1, s0, s1);
+		return;         /* the map stays: harmless */
+	}
+	uint64_t second = panel_pa + FBFLIP_SECOND;
+	IOMemoryDescriptor *smd = IOMemoryDescriptor::withPhysicalAddress(second, round_page_64(panel_bytes), kIODirectionInOut);
+	IOMemoryMap *smap = smd != NULL ? smd->map(kIOMapWriteCombineCache) : NULL;
+	if (smap == NULL || !fbgpu_map_contig(sweet_fbgpu.win + FBGPU_PANEL_OFF + FBFLIP_SECOND, second, round_page_64(panel_bytes))) {
+		IOLog("SWEET FB: page flip: second buffer at %#llx not mapped: one panel buffer\n", second);
+		OSSafeReleaseNULL(smap);
+		OSSafeReleaseNULL(smd);
+		return;
+	}
+	/* the second buffer starts as a copy of what is shown, for any part a later frame does not cover */
+	memcpy((void *)smap->getVirtualAddress(), (const void *)panel_cpu, (size_t)panel_bytes);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	sweet_fbflip.pa[0] = panel_pa;
+	sweet_fbflip.pa[1] = second;
+	sweet_fbflip.front = 0;
+	sweet_fbflip.ok = true;
+	IOLog("SWEET FB: page flip on: buffers %#llx and %#llx (%llu KB), pipes VIG0/VIG1, CTL0 flush %#x\n",
+	    panel_pa, second, panel_bytes >> 10, FBFLIP_FLUSH_BITS);
+}
