+		}
+		iv[il++] = b;
+	}
+	p[n++] = 0x30;
+	p[n++] = (uint8_t)(2 + klen + 2 + il);
+	p[n++] = 0x0c;
+	p[n++] = (uint8_t)klen;
+	memcpy(p + n, key, klen);
+	n += klen;
+	p[n++] = 0x02;
+	p[n++] = (uint8_t)il;
+	memcpy(p + n, iv, il);
+	return n + il;
