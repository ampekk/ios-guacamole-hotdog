+	0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
+	0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
+	0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
+	0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
+	0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
+	0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
+};
+
+static uint8_t
+gcm_xt(uint8_t x)
+{
+	return (uint8_t)((x << 1) ^ ((x & 0x80) ? 0x1b : 0));
+}
+
+/* AES-256 key schedule: 15 round keys */
+static void
+gcm_expand(const uint8_t key[32], uint8_t rk[240])
+{
+	uint8_t rcon = 1;
+	memcpy(rk, key, 32);
+	for (int i = 8; i < 60; i++) {
+		uint8_t t[4];
+		memcpy(t, rk + 4 * (i - 1), 4);
+		if (i % 8 == 0) {
+			uint8_t a = t[0];
+			t[0] = gcm_sbox[t[1]] ^ rcon;
+			t[1] = gcm_sbox[t[2]];
+			t[2] = gcm_sbox[t[3]];
+			t[3] = gcm_sbox[a];
+			rcon = gcm_xt(rcon);
+		} else if (i % 8 == 4) {
+			for (int j = 0; j < 4; j++) {
+				t[j] = gcm_sbox[t[j]];
+			}
+		}
+		for (int j = 0; j < 4; j++) {
+			rk[4 * i + j] = rk[4 * (i - 8) + j] ^ t[j];
+		}
+	}
+}
+
+static void
+gcm_block(const uint8_t rk[240], const uint8_t in[16], uint8_t out[16])
+{
+	uint8_t s[16], t[16];
+	for (int i = 0; i < 16; i++) {
+		s[i] = in[i] ^ rk[i];
+	}
+	for (int r = 1; r <= 14; r++) {
+		for (int i = 0; i < 16; i++) {          /* SubBytes + ShiftRows */
+			t[i] = gcm_sbox[s[(i + 4 * (i % 4)) % 16]];
+		}
+		if (r < 14) {                           /* MixColumns */
+			for (int c = 0; c < 4; c++) {
+				uint8_t *a = t + 4 * c, a0 = a[0], a1 = a[1], a2 = a[2], a3 = a[3], x = a0 ^ a1 ^ a2 ^ a3;
+				a[0] ^= x ^ gcm_xt(a0 ^ a1);
+				a[1] ^= x ^ gcm_xt(a1 ^ a2);
+				a[2] ^= x ^ gcm_xt(a2 ^ a3);
+				a[3] ^= x ^ gcm_xt(a3 ^ a0);
+			}
+		}
+		for (int i = 0; i < 16; i++) {
+			s[i] = t[i] ^ rk[16 * r + i];
+		}
+	}
+	memcpy(out, s, 16);
+}
+
+/* x = x * y in GF(2^128), GCM bit order */
+static void
+gcm_mul(uint8_t x[16], const uint8_t y[16])
+{
+	uint8_t z[16] = { 0 }, v[16];
+	memcpy(v, y, 16);
+	for (int i = 0; i < 128; i++) {
+		if (x[i / 8] & (0x80 >> (i % 8))) {
+			for (int j = 0; j < 16; j++) {
+				z[j] ^= v[j];
+			}
+		}
+		int lsb = v[15] & 1;
+		for (int j = 15; j > 0; j--) {
+			v[j] = (uint8_t)((v[j] >> 1) | (v[j - 1] << 7));
+		}
+		v[0] >>= 1;
+		if (lsb) {
+			v[0] ^= 0xe1;
+		}
+	}
+	memcpy(x, z, 16);
+}
+
+/* in = 16-byte IV | ciphertext (n bytes; the tag is not read). out = n bytes of plaintext. */
+static void
+gcm_decrypt16(const uint8_t key[32], const uint8_t *iv, const uint8_t *ct, size_t n, uint8_t *out)
+{
+	uint8_t rk[240], h[16] = { 0 }, j0[16], blk[16], len[16] = { 0 };
+	gcm_expand(key, rk);
+	gcm_block(rk, h, h);
+	memcpy(j0, iv, 16);                             /* J0 = GHASH(IV || 0^64 || [128]_64) */
+	gcm_mul(j0, h);
+	len[15] = 128;
+	for (int j = 0; j < 16; j++) {
+		j0[j] ^= len[j];
+	}
+	gcm_mul(j0, h);
+	for (size_t off = 0; off < n; off += 16) {
+		for (int j = 15; j >= 12; j--) {         /* inc32 */
+			if (++j0[j] != 0) {
+				break;
+			}
+		}
+		gcm_block(rk, j0, blk);
+		for (size_t j = 0; j < 16 && off + j < n; j++) {
+			out[off + j] = ct[off + j] ^ blk[j];
+		}
+	}
+	bzero(rk, sizeof(rk));
+}
+
+/*
+ * passcode17: the same, with the tag checked (no AAD: LAC 0x207c52d78 never adds any). Returns 1 when the tag
+ * matches. Used to find which key LocalAuthentication wrapped with (HKDF salt = an ACM context id).
+ */
+static int
+gcm_open16(const uint8_t key[32], const uint8_t *iv, const uint8_t *ct, size_t n, const uint8_t tag[16],
+    uint8_t *out)
+{
+	uint8_t rk[240], h[16] = { 0 }, j0[16], ctr[16], blk[16], s[16] = { 0 };
+	gcm_expand(key, rk);
+	gcm_block(rk, h, h);
+	memcpy(j0, iv, 16);
+	gcm_mul(j0, h);
+	j0[15] ^= 128;                                  /* [128]_64 in the last byte */
+	gcm_mul(j0, h);
+	memcpy(ctr, j0, 16);
+	for (size_t off = 0; off < n; off += 16) {
+		for (int j = 15; j >= 12; j--) {
+			if (++ctr[j] != 0) {
+				break;
+			}
+		}
+		gcm_block(rk, ctr, blk);
+		for (size_t j = 0; j < 16 && off + j < n; j++) {
+			s[j] ^= ct[off + j];                    /* GHASH over the ciphertext, zero padded */
+			out[off + j] = ct[off + j] ^ blk[j];
+		}
+		gcm_mul(s, h);
+	}
+	uint64_t bits = (uint64_t)n * 8;                /* len(A) = 0 || len(C) */
+	for (int j = 0; j < 8; j++) {
+		s[15 - j] ^= (uint8_t)(bits >> (8 * j));
+	}
+	gcm_mul(s, h);
+	gcm_block(rk, j0, blk);
+	uint8_t d = 0;
+	for (int j = 0; j < 16; j++) {
+		d |= (uint8_t)(blk[j] ^ s[j] ^ tag[j]);
+	}
+	bzero(rk, sizeof(rk));
+	bzero(blk, sizeof(blk));
+	return d == 0;
+}
