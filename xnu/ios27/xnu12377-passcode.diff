+/* guacamole (iOS 27): straight in /var/local (root-owned, always there): this kernel has no sweet_vfs_mkdir */
+#define PC_DIR          "/var/local"
+#define PC_FILE         PC_DIR "/passcode.v1"
+#define PC_ITER         100000
+#define PC_ITER_MIN     1000
+#define PC_ITER_MAX     10000000
+#define PC_SALT         16
+#define PC_DK           32
+#define PC_MAXLEN       128
+#define PC_FREE_FAILS   5
