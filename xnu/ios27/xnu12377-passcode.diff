+static void
+pc_init(void)
+{
+	if (pc_inited) {
+		return;
+	}
+	int v = 0;
+	if (PE_parse_boot_argn("sweetpasscode", &v, sizeof(v))) {
+		if (v < 0 || v > 3) {
+			v = 0;
+		}
+		pc_mode = v;
+		pc_pinned = (v == 0);
+	}
+	pc_inited = 1;
+	SAY("mode %d%s (boot)\n", pc_mode, pc_pinned ? " pinned by boot-arg sweetpasscode=0" : "");
+}
