--- ../../research/ios27.2/kernel-backup/systemcalls.c.before-systrace	2026-11-15 02:30:02.708464032 +0000
+++ bsd/dev/arm/systemcalls.c	2026-11-15 02:30:23.098477923 +0000
@@ -180,6 +180,37 @@
 	AUDIT_SYSCALL_ENTER(code, proc, uthread);
 	error = (*(callp->sy_call))(proc, &uthread->uu_arg[0], &(uthread->uu_rval[0]));
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * Diagnostic: boot-arg sweetsystrace=NAME logs the first 600 failing BSD syscalls of processes whose p_comm
+	 * starts with NAME: "SYSERR name[pid] sc N err E a0 a1 a2 'str0' 'str1'" (a0/a1 that point at a readable
+	 * user string are shown as strings). Finds what a daemon trips over when its own log says nothing.
+	 */
+	if (__improbable(error != 0 && error != ERESTART && error != EJUSTRETURN)) {
+		static char sweet_st_name[MAXCOMLEN + 1];
+		static int sweet_st_state;      /* 0 unparsed, 1 off, 2 on */
+		static unsigned sweet_st_count;
+		if (sweet_st_state == 0) {
+			sweet_st_state = (PE_parse_boot_argn("sweetsystrace", sweet_st_name, sizeof(sweet_st_name)) &&
+			    sweet_st_name[0]) ? 2 : 1;
+		}
+		if (sweet_st_state == 2 && sweet_st_count < 600 &&
+		    strncmp(proc->p_comm, sweet_st_name, strlen(sweet_st_name)) == 0) {
+			char s0[96] = "", s1[96] = "";
+			size_t n;
+			uint64_t a0 = uthread->uu_arg[0], a1 = uthread->uu_arg[1], a2 = uthread->uu_arg[2];
+			if (a0 > 0x100000000ULL && a0 < 0x8000000000ULL && copyinstr((user_addr_t)a0, s0, sizeof(s0), &n) != 0) {
+				s0[0] = 0;
+			}
+			if (a1 > 0x100000000ULL && a1 < 0x8000000000ULL && copyinstr((user_addr_t)a1, s1, sizeof(s1), &n) != 0) {
+				s1[0] = 0;
+			}
+			sweet_st_count++;
+			printf("SYSERR %s[%d] sc %d err %d a0 %#llx a1 %#llx a2 %#llx '%s' '%s'\n", proc->p_comm, pid, code,
+			    error, a0, a1, a2, s0, s1);
+		}
+	}
+#endif
 
