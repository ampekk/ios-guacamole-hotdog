+
+/*
+ * Per-file data protection classes on that same volume, emulated in VFS (SWEET HFS has no CONFIG_PROTECT, so
+ * hfs_vnop_getattr/setattr never handle va_dataprotect_class: F_GETPROTECTIONCLASS gave ENOTSUP and getattrlist
+ * left ATTR_CMN_DATA_PROTECT_FLAGS out even with MNT_CPROTECT shown - measured with userland/jb/urlprops).
+ * For the callers that see MNT_CPROTECT (non-root, sweet_cp_emul_visflags): a class set through VNOP_SETATTR
+ * (setattrlist, F_SETPROTECTIONCLASS, NSURL/NSFileManager) is kept in the xattr com.apple.sweet.cpclass (1 byte)
+ * and VNOP_GETATTR reports it, else class D (4) = NSFileProtectionNone, which is the truth (nothing is
+ * encrypted) and what PosterBoard's wallpaper store requires (PFPosterPathURLResourceValues). Called from
+ * kpi_vfs.c VNOP_GETATTR / VNOP_SETATTR, without filesystem locks held.
+ */
+#define SWEET_CP_XATTR  "com.apple.sweet.cpclass"
+
+static int
+sweet_cp_emul_vnode(vnode_t vp)
+{
+	return vp != NULL && (vnode_isreg(vp) || vnode_isdir(vp)) && sweet_cp_emul_visflags(vnode_mount(vp)) != 0;
+}
+
+void
+sweet_cp_emul_getattr(vnode_t vp, struct vnode_attr *vap, vfs_context_t ctx)
+{
+	if (!VATTR_IS_ACTIVE(vap, va_dataprotect_class) || VATTR_IS_SUPPORTED(vap, va_dataprotect_class) ||
+	    !sweet_cp_emul_vnode(vp)) {
+		return;
+	}
+	uint8_t b = 0;
+	size_t got = 0;
+	uint32_t cls = PROTECTION_CLASS_D;
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+	if (uio != NULL) {
+		uio_addiov(uio, CAST_USER_ADDR_T(&b), sizeof(b));
+		if (vn_getxattr(vp, SWEET_CP_XATTR, uio, &got, XATTR_NOSECURITY, ctx) == 0 && got == 1 &&
+		    cp_is_valid_class(vnode_isdir(vp), b)) {
+			cls = b;
+		}
+		uio_free(uio);
+	}
+	vap->va_dataprotect_class = cls;
+	VATTR_SET_SUPPORTED(vap, va_dataprotect_class);
+}
+
+/* Before the filesystem: take the class out of vap (returns 1 when it did); after: sweet_cp_emul_setattr_done. */
+int
+sweet_cp_emul_setattr(vnode_t vp, struct vnode_attr *vap, vfs_context_t ctx)
+{
+	if (!VATTR_IS_ACTIVE(vap, va_dataprotect_class) || !sweet_cp_emul_vnode(vp)) {
+		return 0;
+	}
+	uint8_t b = (uint8_t)(vap->va_dataprotect_class & 0x1f);   /* the effective class, as HFS CP_CLASS() */
+	VATTR_CLEAR_ACTIVE(vap, va_dataprotect_class);
+	if (cp_is_valid_class(vnode_isdir(vp), b)) {
+		uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+		if (uio != NULL) {
+			uio_addiov(uio, CAST_USER_ADDR_T(&b), sizeof(b));
+			(void)vn_setxattr(vp, SWEET_CP_XATTR, uio, XATTR_NOSECURITY, ctx);
+			uio_free(uio);
+		}
+	}
+	return 1;
+}
+
+void
+sweet_cp_emul_setattr_done(struct vnode_attr *vap)
+{
+	VATTR_SET_ACTIVE(vap, va_dataprotect_class);
+	VATTR_SET_SUPPORTED(vap, va_dataprotect_class);
+}
 #endif
 
