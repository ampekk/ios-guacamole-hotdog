--- a/osfmk/kern/sched_clutch.c
+++ b/osfmk/kern/sched_clutch.c
@@ -3199,6 +3199,46 @@
 
 #endif /* !SCHED_TEST_HARNESS */
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * sweet 2026-11-17 (big-first, take 3): the big-first masks (osfmk/kern/processor.c sweet_sched_cpu_masks:
+ * preferred = the A76s cpu4-7, migrate = the A55s cpu0-3) only steer a thread when it is placed. Clutch has no
+ * "avoid this processor" check, so a thread that keeps running (Settings' main thread while scrolling: ~80 % busy,
+ * ptop: cpu0 83 % busy, the big cores ~35 %) stays on the little core it happened to land on. Like Edge's
+ * sched_edge_thread_avoid_processor: a non-real-time, unbound thread on a migrate-mask CPU yields that CPU when a
+ * recommended CPU outside the mask is idle; thread_setrun then places it there (choose_processor prefers the
+ * preferred mask). With the masks at 0 (sweetbigfirst=0) this never fires.
+ */
+uint64_t sweet_avoid_moves;     /* read and reset by SweetFramebuffer's 5 s statistics (no console I/O in here:
+                                 * this runs in the scheduler with interrupts off -> "Console I/O from
+                                 * interrupt-disabled context" panic, 2026-11-17) */
+
+static bool
+sweet_clutch_thread_avoid_processor(processor_t processor, thread_t thread, ast_t reason)
+{
+	processor_set_t pset = processor->processor_set;
+	/*
+	 * Take 3: only at quantum expiry (as Edge does), i.e. for threads that ran a whole quantum on a little core.
+	 * Take 2 checked every context-switch check: 6,000-32,000 moves a second (every IPC handoff and wakeup
+	 * landing on cpu0-3 was bounced at once), 444 % CPU in all instead of 246 %, no fps gained.
+	 */
+	if (!(reason & AST_QUANTUM)) {
+		return false;
+	}
+	if (thread->bound_processor != PROCESSOR_NULL || thread->sched_pri >= BASEPRI_RTQUEUES ||
+	    !bit_test(pset->perfcontrol_cpu_migration_bitmask, processor->cpu_id)) {
+		return false;
+	}
+	uint64_t idle = pset->cpu_state_map[PROCESSOR_IDLE] & pset->recommended_bitmask &
+	    ~pset->perfcontrol_cpu_migration_bitmask;
+	if (idle == 0) {
+		return false;
+	}
+	os_atomic_inc(&sweet_avoid_moves, relaxed);
+	return true;
+}
+#endif
+
 const struct sched_dispatch_table sched_clutch_dispatch = {
 	.sched_name                                     = "clutch",
 	.init                                           = sched_clutch_init,
@@ -3219,8 +3259,13 @@
