+static IOLock *
+sweet_census_lock_get(void)
+{
+	if (sweet_census_lock == NULL) {
+		IOLock *l = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, l, &sweet_census_lock)) {
+			IOLockFree(l);
+		}
+	}
+	return sweet_census_lock;
+}
+
+static void
+sweet_census_add(SweetAcceleratorUserClient *c)
+{
+	IOLockLock(sweet_census_lock_get());
+	for (unsigned i = 0; i < SWEET_CENSUS_MAX; i++) {
+		if (sweet_census[i] == NULL) {
+			sweet_census[i] = c;
+			break;
+		}
+	}
+	IOLockUnlock(sweet_census_lock);
+}
+
+static void
+sweet_census_remove(SweetAcceleratorUserClient *c)
+{
+	IOLockLock(sweet_census_lock_get());
+	for (unsigned i = 0; i < SWEET_CENSUS_MAX; i++) {
+		if (sweet_census[i] == c) {
+			sweet_census[i] = NULL;
+		}
+	}
+	IOLockUnlock(sweet_census_lock);
+}
+
+static void
+sweet_census_log(const char *why)
+{
+	static uint64_t last_ns;
+	uint64_t now_ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
+	if (last_ns != 0 && now_ns - last_ns < 10ULL * NSEC_PER_SEC) {
+		return;
+	}
+	last_ns = now_ns;
+	uint64_t zombie_bytes = 0, zombies = 0;
+	if (sweet_zombie_lock != NULL) {
+		IOLockLock(sweet_zombie_lock);
+		for (unsigned i = 0; sweet_zombies != NULL && i < sweet_zombies->getCount(); i++) {
+			OSData *d = OSDynamicCast(OSData, sweet_zombies->getObject(i));
+			const struct sweet_zombie *z = d != NULL ? (const struct sweet_zombie *)d->getBytesNoCopy() : NULL;
+			if (z != NULL) {
+				zombies++;
+				zombie_bytes += z->md->getLength();
+			}
+		}
+		IOLockUnlock(sweet_zombie_lock);
+	}
+	uint64_t listed = 0;
+	IOLog("SWEET MTL census (%s): pool free %llu MB; zombies %llu holding %llu MB\n", why,
+	    sweet_gpu_pool_avail() >> 20, zombies, zombie_bytes >> 20);
+	IOLockLock(sweet_census_lock_get());
+	for (unsigned i = 0; i < SWEET_CENSUS_MAX; i++) {
+		SweetAcceleratorUserClient *c = sweet_census[i];
+		if (c != NULL) {
+			c->censusLine(&listed);
+		}
+	}
+	IOLockUnlock(sweet_census_lock);
+	IOLog("SWEET MTL census: clients hold %llu MB in all\n", listed >> 20);
+}
+
+void
+SweetAcceleratorUserClient::censusLine(uint64_t *listed)
+{
+	*listed += fPoolBytes;
+	IOLog("SWEET MTL census:   %s[%d] holds %llu MB (peak %llu MB)\n", fName, fPid, fPoolBytes >> 20, fPoolPeak >> 20);
+}
