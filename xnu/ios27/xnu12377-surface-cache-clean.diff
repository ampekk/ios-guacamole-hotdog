+/*
+ * 2026-11-17 GPU corruption (photos: icons and widgets with 16-pixel horizontal dashes, trails of an app card): CPU
+ * cache lines that never reached memory. Surfaces are mapped cacheable (mapCache kIOMapDefaultCache) and the
+ * GPU imports them without the CPU's caches (SweetAccelerator: "imports pin the client's own pages, whose CPU
+ * caches the client maintains itself"), but the iOS 27 NativeAdrenoMetal frontend does no maintenance (its
+ * kSurfaceFlush is false: on iPadOS 27 sys_dcache_flush is only a barrier, and UniXNU's own kernel maintains imports
+ * at every submit). So the GPU sampled what DRAM held under the writer's dirty lines: one stale 64-byte line (16
+ * BGRA pixels) here and there. The IOSurface protocol gives the moment: CPU access is bracketed by lock / unlock,
+ * both traps here. A writing unlock (and a wrap of memory the caller already filled: CoreAnimation's icon images)
+ * cleans the surface to memory; with bit 1 of the boot-arg a lock also cleans and invalidates first, so a CPU reader
+ * gets what the GPU wrote. Write-combined surfaces hold no line and are skipped.
+ * Boot-arg sweetsurfclean: 1 (default) unlock + wrap, 3 lock as well, 0 off.
+ */
+static uint32_t sweet_surf_clean_mode = 1, sweet_surf_clean_read;
+static uint64_t sweet_surf_clean_n, sweet_surf_clean_bytes, sweet_surf_clean_ns, sweet_surf_clean_last;
+
+static void
+sweet_surface_clean(SweetSurface *s, unsigned why)      /* why: 1 unlock/wrap, 2 lock */
+{
+	if (!sweet_surf_clean_read) {
+		uint32_t v;
+		if (PE_parse_boot_argn("sweetsurfclean", &v, sizeof(v))) {
+			sweet_surf_clean_mode = v;
+		}
+		sweet_surf_clean_read = 1;
+	}
+	if (!(sweet_surf_clean_mode & why) || s == NULL || s->memory == NULL || s->mapCache == kIOMapWriteCombineCache) {
+		return;
+	}
+	uint64_t t0 = mach_absolute_time(), len = s->memory->getLength();
+	s->memory->performOperation(kIOMemoryIncoherentIOFlush, 0, len);
+	uint64_t ns, total;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	OSAddAtomic64(1, (volatile SInt64 *)&sweet_surf_clean_n);
+	OSAddAtomic64((SInt64)len, (volatile SInt64 *)&sweet_surf_clean_bytes);
+	total = (uint64_t)OSAddAtomic64((SInt64)ns, (volatile SInt64 *)&sweet_surf_clean_ns) + ns;
+	/* one line a minute: how much the CPU-cache cleaning costs */
+	uint64_t now = mach_absolute_time(), last = sweet_surf_clean_last, gap;
+	absolutetime_to_nanoseconds(now - last, &gap);
+	if (gap >= 60ull * NSEC_PER_SEC && OSCompareAndSwap64(last, now, (volatile UInt64 *)&sweet_surf_clean_last) && last != 0) {
+		IOLog("SWEET SURF: cache clean (mode %u): %llu surfaces, %llu MB, %llu ms in the last minute\n", sweet_surf_clean_mode,
+		    sweet_surf_clean_n, sweet_surf_clean_bytes >> 20, total / NSEC_PER_MSEC);
+		sweet_surf_clean_n = sweet_surf_clean_bytes = sweet_surf_clean_ns = 0;
+	} else if (last == 0) {
+		(void)OSCompareAndSwap64(0, now, (volatile UInt64 *)&sweet_surf_clean_last);
+	}
+}
