+/*
+ * The camera's IOService for SWEET (iOS 27.2's capture stack).
+ *
+ * CMCapture's FigCaptureGetCaptureDeviceCreateFunction picks the capture device's bundle by the camera
+ * driver service there is (IOServiceAddMatchingNotification on each of AppleH16CamIn, AppleH13CamIn,
+ * AppleH10CamIn, AppleH9CamIn, AppleH6CamIn and AppleCamera; fcc_cameraDriverServiceMatchingCallback):
+ * with none, cameracaptured has no camera and Camera is killed ("Capture Application Requirements Unmet").
+ * This service is "AppleCamera", whose entry is /System/Library/MediaCapture/ISP.mediacapture and its
+ * ISPCaptureDeviceCreate: our own bundle (userland/camera/), which makes the device itself. Nothing opens
+ * this service; it is only there to be found. Boot-arg sweetcamera=0 leaves it out.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <pexpert/pexpert.h>
+
+class AppleCamera : public IOService {
+	OSDeclareDefaultStructors(AppleCamera);
+
+public:
+	IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleCamera, IOService);
+
+IOService *
+AppleCamera::probe(IOService *provider, SInt32 *score)
+{
+	uint32_t on = 1;
+
+	if (PE_parse_boot_argn("sweetcamera", &on, sizeof(on)) && on == 0) {
+		return NULL;
+	}
+	return IOService::probe(provider, score);
+}
+
+bool
+AppleCamera::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setName("AppleCamera");
+	setProperty("SweetCamera", "ISP.mediacapture");
+	registerService();
+	IOLog("SWEET CAM: AppleCamera registered (CMCapture loads ISP.mediacapture)\n");
+	return true;
+}
+#endif /* SWEET */
