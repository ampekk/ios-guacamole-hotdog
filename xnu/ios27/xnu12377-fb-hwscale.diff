+/*
+ * 2026-11-17 hardware scaling. Every frame was stretched from CoreAnimation's logical 828x1792 to the 1440x3120 panel by
+ * the GPU blit (18 MB written a frame) and the display then read 18 MB a refresh. Each VIG pipe has a QSEED3 scaler
+ * (scanprobe 11-17: version 0x1004 at VIG + 0xa00, off, steps 1.0, preload x4 y3). Now the two page-flip buffers hold
+ * the logical frame (pitch rounded to 64 bytes), the GPU copies 1:1 and each pipe scales its half: VIG0 source columns
+ * [0, W/2) -> LM0's 720, VIG1 [W/2, W) -> LM1's 720 (828/1440 * 720 = 414 exactly: the halves meet without a phase
+ * offset). Bilinear (filter 3, alpha 1, no coefficient tables), steps in 1/2^21 (Linux dpu_plane.c, dpu_hw_util.c
+ * dpu_hw_setup_scaler3; separate INIT_* registers as the version is not 0x1002). The pipes are switched over on the
+ * first flip after setup (fbflip_program), together with the first logical frame. A panic restores the 1:1 setup on
+ * buffer 0 for the panic screen (sweet_console_panic_hook, serial_console.c). Boot-arg sweetfbhwscale=0: off.
+ */
+#define FBSCALE_QSEED3          0xa00u          /* VIG + 0xa00 */
+#define FBSCALE_SRC_SIZE        0x000u
+#define FBSCALE_SRC_XY          0x008u
+#define FBSCALE_OUT_SIZE        0x00cu
+#define FBSCALE_REQ_C0          0x108u          /* SSPP_SW_PIX_EXT_C0_REQ_PIXELS; C1C2 +0x10, C3 +0x20 */
+
+static struct {
+	bool on;                        /* the buffers hold logical frames (the next flip switches the pipes over) */
+	bool programmed;                /* the pipes scale */
+	uint32_t lw, lh, half, pitch, outw, outh, version;
+	uint32_t save_size[2], save_xy[2], save_stride[2], save_req[2][3], save_op[2];
+} sweet_fbscale;
+
+static void
+fbscale_program_pipes(void)
+{
+	static const uint32_t vig[2] = { FBFLIP_VIG0, FBFLIP_VIG1 };
+	const uint32_t size = (sweet_fbscale.lh << 16) | sweet_fbscale.half;
+	const uint32_t step_h = (uint32_t)(((uint64_t)sweet_fbscale.half << 21) / sweet_fbscale.outw);
+	const uint32_t step_v = (uint32_t)(((uint64_t)sweet_fbscale.lh << 21) / sweet_fbscale.outh);
+	for (unsigned p = 0; p < 2; p++) {
+		const uint32_t v = vig[p], q = vig[p] + FBSCALE_QSEED3;
+		fbflip_wr(v + FBSCALE_SRC_SIZE, size);
+		fbflip_wr(v + FBSCALE_SRC_XY, p * sweet_fbscale.half);
+		fbflip_wr(v + FBFLIP_YSTRIDE0, sweet_fbscale.pitch);
+		for (unsigned c = 0; c < 3; c++) {
+			fbflip_wr(v + FBSCALE_REQ_C0 + 0x10 * c, size);
+		}
+		fbflip_wr(q + 0x90, 0);                 /* PHASE_INIT_Y_H, _Y_V, _UV_H, _UV_V */
+		fbflip_wr(q + 0x94, 0);
+		fbflip_wr(q + 0x98, 0);
+		fbflip_wr(q + 0x9c, 0);
+		fbflip_wr(q + 0x10, step_h);            /* PHASE_STEP_Y_H */
+		fbflip_wr(q + 0x14, step_v);            /* PHASE_STEP_Y_V */
+		fbflip_wr(q + 0x18, step_h);            /* PHASE_STEP_UV_H */
+		fbflip_wr(q + 0x1c, step_v);            /* PHASE_STEP_UV_V */
+		fbflip_wr(q + 0x20, 0x03040304u);       /* PRELOAD: x 4, y 3 (QSEED3) */
+		fbflip_wr(q + 0x40, size);              /* SRC_SIZE_Y_RGB_A */
+		fbflip_wr(q + 0x44, size);              /* SRC_SIZE_UV */
+		fbflip_wr(q + 0x48, (sweet_fbscale.outh << 16) | sweet_fbscale.outw);   /* DST_SIZE */
+		/* OP_MODE last: enable, Y/RGB bilinear (3 << 16), not DX (bit 14), alpha (bit 10) bilinear (1 << 29), blend (31) */
+		fbflip_wr(q + 0x04, 1u | (3u << 16) | (1u << 14) | (1u << 10) | (1u << 29) | (1u << 31));
+	}
+	sweet_fbscale.programmed = true;
+}
+
+/* sweet_console_panic_hook: the panic screen is drawn 1:1 into buffer 0: the pipes back to how ABL set them */
+extern "C" void (*sweet_console_panic_hook)(void);
+static void
+fbscale_panic_restore(void)
+{
+	static const uint32_t vig[2] = { FBFLIP_VIG0, FBFLIP_VIG1 };
+	if (!sweet_fbflip.ok || sweet_fbflip.mdp == NULL) {
+		return;
+	}
+	for (unsigned p = 0; p < 2; p++) {
+		const uint32_t v = vig[p];
+		fbflip_wr(v + FBSCALE_QSEED3 + 0x04, sweet_fbscale.save_op[p]);
+		fbflip_wr(v + FBSCALE_SRC_SIZE, sweet_fbscale.save_size[p]);
+		fbflip_wr(v + FBSCALE_SRC_XY, sweet_fbscale.save_xy[p]);
+		fbflip_wr(v + FBFLIP_YSTRIDE0, sweet_fbscale.save_stride[p]);
+		for (unsigned c = 0; c < 3; c++) {
+			fbflip_wr(v + FBSCALE_REQ_C0 + 0x10 * c, sweet_fbscale.save_req[p][c]);
+		}
+		fbflip_wr(v + FBFLIP_SRC0_ADDR, (uint32_t)sweet_fbflip.pa[0]);
+	}
+	fbflip_wr(FBFLIP_CTL0_FLUSH, FBFLIP_FLUSH_BITS);
+	sweet_fbscale.on = sweet_fbscale.programmed = false;
+	sweet_fbflip.front = 0;
+}
+
 static void
 fbflip_program(unsigned b)
 {
+	if (sweet_fbscale.on && !sweet_fbscale.programmed) {
+		fbscale_program_pipes();        /* flushed together with the first logical frame's address below */
+	}
 	fbflip_wr(FBFLIP_VIG0 + FBFLIP_SRC0_ADDR, (uint32_t)sweet_fbflip.pa[b]);
 	fbflip_wr(FBFLIP_VIG1 + FBFLIP_SRC0_ADDR, (uint32_t)sweet_fbflip.pa[b]);
 	fbflip_wr(FBFLIP_CTL0_FLUSH, FBFLIP_FLUSH_BITS);
