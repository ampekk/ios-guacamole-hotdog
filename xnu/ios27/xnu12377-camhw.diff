+/* PM8150L GPIO 1 as a digital output (VIN0, no pull), high or low */
+static int
+ch_pmic_gpio(bool high)
+{
+	int e = 0;
+	if (sweet_spmi_init() != 0) {
+		return -1;
+	}
+	e |= sweet_spmi_write(PMIC_SID, PMIC_GPIO1 + PG_MODE_CTL, 0x01);       /* digital output */
+	e |= sweet_spmi_write(PMIC_SID, PMIC_GPIO1 + PG_DIG_VIN, 0x00);        /* VIN0 */
+	e |= sweet_spmi_write(PMIC_SID, PMIC_GPIO1 + PG_DIG_PULL, 0x05);       /* no pull */
+	e |= sweet_spmi_write(PMIC_SID, PMIC_GPIO1 + PG_OUT_SRC, high ? 0x80 : 0x00);  /* invert of constant low */
+	e |= sweet_spmi_write(PMIC_SID, PMIC_GPIO1 + PG_EN_CTL, 0x80);
+	uint8_t mode = 0xff, src = 0xff, en = 0xff;
+	(void)sweet_spmi_read(PMIC_SID, PMIC_GPIO1 + PG_MODE_CTL, &mode);
+	(void)sweet_spmi_read(PMIC_SID, PMIC_GPIO1 + PG_OUT_SRC, &src);
+	(void)sweet_spmi_read(PMIC_SID, PMIC_GPIO1 + PG_EN_CTL, &en);
+	printf("SWEET CAMHW: PM8150L GPIO1 %s -> %d (mode %#x src %#x en %#x)\n", high ? "high" : "low", e, mode, src, en);
+	return e;
+}
+
+
+/* ---------------------------------------------------------------- the front camera's pop-up motor (step 5)
+ *
+ * A stepper behind a TI DRV8834 (Android: oneplus_motor + drv8834; NOTES.md "Front camera"): STEP = PM8150L GPIO 10
+ * in func1 from the PM8150L (SID 5) LPG channel 2 (0xbd00), DIR = PM8150L GPIO 11 (low up, high down), M1 = PM8150L GPIO 8 (high)
+ * and M0 = PM8150B GPIO 5 (high impedance): 1/32 microsteps; nSLEEP = PM8150 GPIO 10, the motor supply's boost =
+ * PM8150B GPIO 12. Android moves it by time (outputs/android-frontcam/): 100 ms at a 104166 ns step period, then
+ * 12000 ns, stopped by a timer at 618 ms going up and 626 ms going down; the LPG settings are what pwm-qti-lpg.c
+ * makes of those periods (19.2 MHz clock, prediv 1, 6-bit size: exponent 5 = 106496 ns, exponent 2 = 13312 ns, 50 %).
+ * The pin order is the DRV8834 datasheet's (no source for OnePlus's driver): boost on, mode/direction set, nSLEEP high,
+ * 2 ms, steps; off in reverse. The hall sensors (MXM1120 on QUP SE1) are not read yet: where the camera is, is what
+ * this code last did (it is down at boot as Android leaves it).
+ * sysctl kern.sweet_popup: reads 0 down, 1 up, -1 unknown (a move failed); write 1 raise (from down), 2 lower (from
+ * up), 3 nudge (from down: 100 ms up at the slow rate, about 2 % of the travel, then the same down), 4 lower whatever
+ * it was (recovery).
+ */
+#define PG_SID_PM8150   0u
+#define PG_SID_PM8150B  2u
+#define PG_SID_PM8150L  4u
+#define LPG_SID         5u
+#define LPG2            0xbd00u
+#define PGB(n)          (0xc000u + ((unsigned)(n) - 1u) * 0x100u)
+
+static int pop_pos = 0;                 /* 0 down, 1 up, -1 unknown */
+
+/* a PMIC GPIO (LV/MV): mode 0x40, VIN 0x41, pull 0x42, output source 0x44 (bit 7 invert, low bits function),
+ * output control 0x45 (buffer type << 4 | strength), enable 0x46 (bit 7) -- as pinctrl-spmi-gpio.c writes them */
+static int
+pop_gpio(unsigned sid, unsigned n, uint8_t mode, uint8_t pull, uint8_t src, uint8_t strength, bool enable)
+{
+	unsigned b = PGB(n);
+	int e = 0;
+	e |= sweet_spmi_write(sid, b + 0x41, 0x00);
+	e |= sweet_spmi_write(sid, b + 0x42, pull);
+	e |= sweet_spmi_write(sid, b + 0x45, strength);
+	e |= sweet_spmi_write(sid, b + 0x40, mode);
+	e |= sweet_spmi_write(sid, b + 0x44, src);
+	e |= sweet_spmi_write(sid, b + 0x46, enable ? 0x80 : 0x00);
+	return e;
+}
+
+static int
+pop_out(unsigned sid, unsigned n, bool high, uint8_t pull, uint8_t strength)
+{
+	return pop_gpio(sid, n, 0x01, pull, high ? 0x80 : 0x00, strength, true);
+}
+
+/* the LPG channel: period by exponent (6-bit, 19.2 MHz, prediv 1), 50 %, out on or off */
+static int
+pop_pwm(unsigned exponent, bool on)
+{
+	int e = 0;
+	if (on) {
+		e |= sweet_spmi_write(LPG_SID, LPG2 + 0x41, 0x03);              /* size 6 bits, clock 19.2 MHz */
+		e |= sweet_spmi_write(LPG_SID, LPG2 + 0x42, (uint8_t)exponent); /* prediv 1 */
+		e |= sweet_spmi_write(LPG_SID, LPG2 + 0x43, 0x20);              /* glitch removal */
+		e |= sweet_spmi_write(LPG_SID, LPG2 + 0x44, 32);                /* 50 % of 64 */
+		e |= sweet_spmi_write(LPG_SID, LPG2 + 0x45, 0);
+		e |= sweet_spmi_write(LPG_SID, LPG2 + 0x47, 0x01);              /* sync */
+		e |= sweet_spmi_write(LPG_SID, LPG2 + 0x46, 0x84);              /* out on, source the PWM value */
+	} else {
+		e |= sweet_spmi_write(LPG_SID, LPG2 + 0x46, 0x04);              /* out off */
+	}
+	return e;
+}
+
+/* everything as Android leaves it between moves: driver asleep, boost off, M1 high, M0 open, DIR low, STEP on the LPG */
+static int
+pop_idle(void)
+{
+	int e = pop_pwm(0, false);
+	e |= pop_out(PG_SID_PM8150, 10, false, 0x05, 0x03);             /* nSLEEP low */
+	e |= pop_out(PG_SID_PM8150B, 12, false, 0x04, 0x03);            /* boost off */
+	e |= pop_out(PG_SID_PM8150L, 8, true, 0x05, 0x01);              /* M1 high */
+	e |= pop_gpio(PG_SID_PM8150B, 5, 0x00, 0x05, 0x00, 0x01, false); /* M0 high impedance */
+	e |= pop_out(PG_SID_PM8150L, 11, false, 0x05, 0x01);            /* DIR low */
+	e |= pop_gpio(PG_SID_PM8150L, 10, 0x01, 0x05, 0x02, 0x01, true); /* STEP: func1 (the LPG) */
+	return e;
+}
+
+/* one move: up (true) or down, for total_ms; slow_only stops after the 100 ms slow part */
+static int
+pop_move(bool up, unsigned total_ms, bool slow_only)
+{
+	uint64_t t0, t1, t2, ns;
+	int e = pop_idle();
+	if (e) {
+		printf("SWEET POPUP: the pins could not be set (SPMI) -- not moving\n");
+		return EIO;
+	}
+	e |= pop_out(PG_SID_PM8150B, 12, true, 0x04, 0x03);             /* boost on */
+	ch_wait(5);
+	e |= pop_out(PG_SID_PM8150L, 11, !up, 0x05, 0x01);              /* DIR: low raises (camhw10: high lowered it) */
+	e |= pop_out(PG_SID_PM8150, 10, true, 0x05, 0x03);              /* nSLEEP high */
+	ch_wait(2);
+	if (e) {
+		(void)pop_idle();
+		printf("SWEET POPUP: driver power-up failed (SPMI) -- not moving\n");
+		return EIO;
+	}
+	t0 = mach_absolute_time();
+	e = pop_pwm(5, true);                                           /* 106496 ns */
+	ch_wait(100);
+	t1 = mach_absolute_time();
+	if (!slow_only && e == 0) {
+		e |= sweet_spmi_write(LPG_SID, LPG2 + 0x42, 0x02);      /* 13312 ns */
+		e |= sweet_spmi_write(LPG_SID, LPG2 + 0x47, 0x01);
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		if (e == 0 && ns / 1000000u < total_ms) {
+			ch_wait(total_ms - (unsigned)(ns / 1000000u));
+		}
+	}
+	t2 = mach_absolute_time();
+	int e2 = pop_pwm(0, false);                                     /* steps off first, whatever happened */
+	e2 |= pop_out(PG_SID_PM8150, 10, false, 0x05, 0x03);            /* nSLEEP low */
+	e2 |= pop_out(PG_SID_PM8150B, 12, false, 0x04, 0x03);           /* boost off */
+	uint64_t slow_ns, all_ns;
+	absolutetime_to_nanoseconds(t1 - t0, &slow_ns);
+	absolutetime_to_nanoseconds(t2 - t0, &all_ns);
+	printf("SWEET POPUP: %s%s: slow %llu ms, all %llu ms -> %d/%d\n", up ? "up" : "down", slow_only ? " (nudge)" : "",
+	    slow_ns / 1000000ull, all_ns / 1000000ull, e, e2);
+	return (e || e2) ? EIO : 0;
+}
+
+static int
+pop_command(int what)
+{
+	if (sweet_spmi_init() != 0) {
+		return ENODEV;
+	}
+	int e;
+	switch (what) {
+	case 1:
+		if (pop_pos != 0) {
+			return EBUSY;
+		}
+		e = pop_move(true, 618, false);
+		pop_pos = e ? -1 : 1;
+		return e;
+	case 2:
+		if (pop_pos != 1) {
+			return EBUSY;
+		}
+		e = pop_move(false, 626, false);
+		pop_pos = e ? -1 : 0;
+		return e;
+	case 3:
+		if (pop_pos != 0) {
+			return EBUSY;
+		}
+		e = pop_move(true, 0, true);
+		ch_wait(300);
+		if (e == 0) {
+			e = pop_move(false, 0, true);
+		}
+		pop_pos = e ? -1 : 0;
+		return e;
+	case 4:
+		e = pop_move(false, 626, false);
+		pop_pos = e ? -1 : 0;
+		return e;
+	default:
+		return EINVAL;
+	}
+}
+
+static bool
+ch_clocks_on(void)
+{
+	bool ok = true;
+	(void)ch_branch_check(ch.gcc, GCC_CAMERA_AHB, "gcc_camera_ahb", false);
+	(void)ch_branch_check(ch.gcc, GCC_CAMERA_XO, "gcc_camera_xo", false);
+	/* the AXI clocks are for frames, not for the CCI: logged, not fatal (they may want a bus vote first) */
+	(void)ch_branch(ch.gcc, GCC_CAMERA_HF_AXI, "gcc_camera_hf_axi");
+	(void)ch_branch(ch.gcc, GCC_CAMERA_SF_AXI, "gcc_camera_sf_axi");
+	/* titan_top GDSC: clear SW_COLLAPSE, wait PWR_ON */
+	uint32_t g = ch_rd(ch.camcc, CC_TITAN_GDSC);
+	ch_wr(ch.camcc, CC_TITAN_GDSC, g & ~1u);
+	if (!ch_poll(ch.camcc, CC_TITAN_GDSC, 1u << 31, true, 5000)) {
+		printf("SWEET CAMHW: titan_top GDSC did not power on (%#x -> %#x)\n", g, ch_rd(ch.camcc, CC_TITAN_GDSC));
+		return false;
+	}
+	ok &= ch_rcg_xo(CC_SLOW_AHB_RCG, "slow_ahb");
+	ok &= ch_rcg_xo(CC_CAMNOC_RCG, "camnoc_axi");
+	ok &= ch_rcg_xo(CC_CCI0_RCG, "cci_0");
+	ok &= ch_branch(ch.camcc, CC_CPAS_AHB, "cpas_ahb");
+	(void)ch_branch(ch.camcc, CC_CAMNOC_AXI, "camnoc_axi");
+	(void)ch_branch_check(ch.camcc, CC_CORE_AHB, "core_ahb", false);
+	ok &= ch_branch(ch.camcc, CC_CCI0, "cci_0");
+	printf("SWEET CAMHW: clocks: gcc ahb %#x xo %#x hf %#x sf %#x; cpas %#x camnoc %#x core %#x cci %#x -> %s\n",
+	    ch_rd(ch.gcc, GCC_CAMERA_AHB), ch_rd(ch.gcc, GCC_CAMERA_XO), ch_rd(ch.gcc, GCC_CAMERA_HF_AXI),
+	    ch_rd(ch.gcc, GCC_CAMERA_SF_AXI), ch_rd(ch.camcc, CC_CPAS_AHB), ch_rd(ch.camcc, CC_CAMNOC_AXI),
+	    ch_rd(ch.camcc, CC_CORE_AHB), ch_rd(ch.camcc, CC_CCI0), ok ? "ok" : "FAILED");
+	return ok;
+}
+
+/* the CCI: reset, interrupts masked in (status polled), standard-mode timings for 19.2 MHz on master 1 */
+static bool
+ch_cci_init(void)
+{
+	uint32_t ver = ch_rd(cc.base, CCI_HW_VERSION);
+	printf("SWEET CAMHW: CCI hw version %#x (Android's 0x10070000)\n", ver);
+	if (ver == 0 || ver == 0xffffffffu) {
+		return false;
+	}
+	ch_wr(cc.base, CCI_IRQ_MASK_0, 0x7fff7ff7u);
+	ch_wr(cc.base, CCI_IRQ_MASK_1, 0x00110000u);
+	ch_wr(cc.base, CCI_IRQ_CLEAR_0, 0xffffffffu);
+	ch_wr(cc.base, CCI_IRQ_CLEAR_1, 0xffffffffu);
+	ch_wr(cc.base, CCI_IRQ_GLOBAL_CLR, 1u);
+	ch_wr(cc.base, CCI_RESET_CMD, CCI_RESET_RMSK);
+	ch_wr(cc.base, CCI_RESET_CMD, 1u);
+	if (!ch_poll(cc.base, CCI_IRQ_STATUS_0, CCI_ST0_RST_DONE, true, 100000)) {
+		printf("SWEET CAMHW: CCI reset not acknowledged (status %#x)\n", ch_rd(cc.base, CCI_IRQ_STATUS_0));
+		return false;
+	}
+	ch_wr(cc.base, CCI_IRQ_CLEAR_0, 0xffffffffu);
+	ch_wr(cc.base, CCI_IRQ_CLEAR_1, 0xffffffffu);
+	ch_wr(cc.base, CCI_IRQ_GLOBAL_CLR, 1u);
+	ch_wr(cc.base, CCI_M0_RD_THRESHOLD, 0x30u);
+	ch_wr(cc.base, CCI_M1_RD_THRESHOLD, 0x30u);
+	/* Android's standard mode at 37.5 MHz (thigh 201, tlow 174, tsu_sto 204, tsu_sta 231, thd_dat 22,
+	 * thd_sta 162, tbuf 227, trdhld 6, tsp 3), halved for 19.2 MHz: about 100 kHz */
+	ch_wr(cc.base, CCI_MR(0x00u), (103u << 16) | 89u);
+	ch_wr(cc.base, CCI_MR(0x04u), (105u << 16) | 118u);
+	ch_wr(cc.base, CCI_MR(0x08u), (12u << 16) | 83u);
+	ch_wr(cc.base, CCI_MR(0x0cu), 116u);
+	ch_wr(cc.base, CCI_MR(0x10u), (0u << 8) | (3u << 4) | 2u);
+	return true;
+}
+
+/* read n (<= 3) bytes from a 16-bit register address: cam_cci_read()'s queue sequence */
+static bool ch_cci_quiet;              /* reads not logged (the lens controller's status polls) */
+
+static int
+ch_cci_read(unsigned sid, unsigned reg, unsigned n, uint8_t *out)
+{
+	uint32_t words[5] = {
+		CMD_SET_PARAM | (sid << 4) | (3u << 16),
+		CMD_LOCK,
+		CMD_WRITE_DISABLE_P | (2u << 4) | (((reg >> 8) & 0xffu) << 8) | ((reg & 0xffu) << 16),
+		CMD_READ | (n << 4),
+		CMD_UNLOCK,
+	};
+	ch_wr(cc.base, CCI_IRQ_CLEAR_0, 0xffffffffu);
+	ch_wr(cc.base, CCI_IRQ_CLEAR_1, 0xffffffffu);
+	ch_wr(cc.base, CCI_IRQ_GLOBAL_CLR, 1u);
+	for (unsigned i = 0; i < 5; ++i) {
+		ch_wr(cc.base, CCI_Q_LOAD_DATA + CCI_QOFF, words[i]);
+	}
+	uint32_t cnt = ch_rd(cc.base, CCI_Q_CUR_WORDS + CCI_QOFF);
+	ch_wr(cc.base, CCI_Q_EXEC_WORDS + CCI_QOFF, cnt);
+	ch_wr(cc.base, CCI_QUEUE_START, 1u << (cc.m * 2u + CCI_QUEUE));
+	uint32_t st = 0;
+	for (unsigned i = 0; i < 100000; ++i) {
+		st = ch_rd(cc.base, CCI_IRQ_STATUS_0);
+		if (st & (CCI_RD_DONE | CCI_ERR)) {
+			break;
+		}
+		delay(1);
+	}
+	uint32_t level = ch_rd(cc.base, CCI_MR(0x1cu));
+	bool bad = !(st & CCI_RD_DONE) || (st & CCI_ERR);
+	if (!ch_cci_quiet || bad) {
+		printf("SWEET CAMHW: CCI read sid %#x reg %#x: queue words %u, status0 %#x status1 %#x, fifo %u\n",
+		    sid, reg, cnt, st, ch_rd(cc.base, CCI_IRQ_STATUS_1), level);
+	}
+	if (bad) {
+		for (unsigned i = 0; i < level && i < 8; ++i) {
+			(void)ch_rd(cc.base, CCI_MR(0x18u));
+		}
+		ch_wr(cc.base, CCI_RESET_CMD, CCI_MRESET);      /* CCI_M1_RESET_RMSK: clear master 1 */
+		return (st & CCI_ERR) ? EIO : ETIMEDOUT;
+	}
+	/* the first byte of the FIFO is the slave id; the data follow, little-endian within each word */
+	unsigned got = 0;
+	bool first = true;
+	for (unsigned w = 0; w < level && w < 8; ++w) {
+		uint32_t v = ch_rd(cc.base, CCI_MR(0x18u));
+		for (unsigned b = 0; b < 4 && got < n; ++b) {
+			if (first) {
+				first = false;
+				continue;
+			}
+			out[got++] = (uint8_t)(v >> (8 * b));
+		}
+	}
+	ch_wr(cc.base, CCI_IRQ_CLEAR_0, 0xffffffffu);
+	ch_wr(cc.base, CCI_IRQ_CLEAR_1, 0xffffffffu);
+	ch_wr(cc.base, CCI_IRQ_GLOBAL_CLR, 1u);
+	return got == n ? 0 : EIO;
+}
+
+/* RCG: source select / half-divider as CFG_RCGR (src << 8 | hid), then UPDATE */
+static bool
+ch_rcg(uint32_t cmd_rcgr, uint32_t cfg, const char *name)
+{
+	ch_wr(ch.camcc, cmd_rcgr + 4u, cfg);
+	ch_wr(ch.camcc, cmd_rcgr, ch_rd(ch.camcc, cmd_rcgr) | 1u);
+	bool ok = ch_poll(ch.camcc, cmd_rcgr, 1u, false, 2000);
+	printf("SWEET CAMHW: rcg %s cfg %#x -> %s (cmd %#x)\n", name, cfg, ok ? "ok" : "STUCK", ch_rd(ch.camcc, cmd_rcgr));
+	return ok;
+}
+
+/* CAMCC PLL0 (trion): 1200 MHz from 19.2 MHz (L 62, alpha 0x8000), even /2 600, odd /3 400 (clk_trion_pll_configure
+ * + clk_trion_pll_enable, cam_cc_pll0_config_sm8150_v2) */
+static bool
+ch_pll(uint32_t off, uint32_t l, uint32_t alpha, uint32_t user_ctl, const char *name)
+{
+	vm_offset_t b = ch.camcc + off;
+	uint32_t mode = ch_rd(b, 0x0);
+	if ((mode & (1u << 31)) && (mode & 1u)) {
+		printf("SWEET CAMHW: %s already running (mode %#x L %#x)\n", name, mode, ch_rd(b, 0x4));
+		return true;
+	}
+	ch_wr(b, 0x04, l);              /* L */
+	ch_wr(b, 0x08, 0x44);           /* CAL_L */
+	ch_wr(b, 0x40, alpha);          /* ALPHA */
+	ch_wr(b, 0x18, 0x20485699);     /* CONFIG_CTL */
+	ch_wr(b, 0x1c, 0x00002267);     /* CONFIG_CTL_U */
+	ch_wr(b, 0x20, 0x00000024);     /* CONFIG_CTL_U1 */
+	ch_wr(b, 0x0c, user_ctl);       /* USER_CTL: post dividers */
+	ch_wr(b, 0x10, 0x00000805);     /* USER_CTL_U */
+	ch_wr(b, 0x14, 0x000000d0);     /* USER_CTL_U1 */
+	ch_wr(b, 0x2c, 0x00000020);     /* TEST_CTL_U1 */
+	ch_wr(b, 0x0, (ch_rd(b, 0x0) | (1u << 23)) & ~1u);   /* HW_UPDATE_LOGIC_BYPASS, outputs off */
+	ch_wr(b, 0x38, 0);              /* OPMODE standby */
+	ch_wr(b, 0x0, ch_rd(b, 0x0) | (1u << 2));             /* RESET_N */
+	ch_wr(b, 0x38, 1);              /* OPMODE run */
+	if (!ch_poll(b, 0x0, 1u << 31, true, 2000)) {
+		printf("SWEET CAMHW: %s did not lock (mode %#x status %#x)\n", name, ch_rd(b, 0x0), ch_rd(b, 0x30));
+		return false;
+	}
+	ch_wr(b, 0x0c, ch_rd(b, 0x0c) | 7u);                  /* main, even, odd outputs */
+	ch_wr(b, 0x0, ch_rd(b, 0x0) | 1u);                    /* OUTCTRL */
+	printf("SWEET CAMHW: %s locked (mode %#x)\n", name, ch_rd(b, 0x0));
+	return true;
+}
+
+static bool
+ch_pll0(void)
+{
+	return ch_pll(CC_PLL0, 0x3e, 0x8000, 0x3100, "PLL0");    /* 1200 MHz: even 600, odd 400 */
+}
+
+static bool
+ch_gdsc(uint32_t off, const char *name)
+{
+	uint32_t g = ch_rd(ch.camcc, off);
+	ch_wr(ch.camcc, off, g & ~1u);
+	bool ok = ch_poll(ch.camcc, off, 1u << 31, true, 5000);
+	printf("SWEET CAMHW: GDSC %s %#x -> %#x %s\n", name, g, ch_rd(ch.camcc, off), ok ? "on" : "NOT ON");
+	return ok;
+}
+
+/* CSIPHY 1 for C-PHY, 3 trios (cam_csiphy_reset + cam_csiphy_config_dev + cam_csiphy_cphy_irq_config, v1.1) */
+static void
+ch_csiphy_on(void)
+{
+	static const uint8_t irq[11] = { 0xff, 0xff, 0xfb, 0xff, 0x7f, 0xff, 0xff, 0xef, 0xff, 0xff, 0xff };
+	vm_offset_t p = ch.csiphy;
+
+	/* reset */
+	ch_wr(p, 0x814, 0);
+	ch_wr(p, 0x818, 0);
+	ch_wr(p, 0x81c, 0);
+	ch_wr(p, 0x800, 1);
+	ch_wait(1);
+	ch_wr(p, 0x800, 0);
+	/* common */
+	ch_wr(p, 0x814, CPHY_LANE_ENABLE);
+	ch_wr(p, 0x818, 1);
+	ch_wr(p, 0x81c, 2);
+	ch_wr(p, 0x800, 1);
+	ch_wait(1);
+	ch_wr(p, 0x800, 0);
+	for (unsigned l = 0; l < 3; ++l) {
+		for (unsigned i = 0; i < 43; ++i) {
+			uint32_t v = cphy_lane[l][i].val;
+			if (cphy_lane[l][i].kind == P_SETTLE_LO) {
+				v = CPHY_SETTLE & 0xffu;
+			} else if (cphy_lane[l][i].kind == P_SETTLE_HI) {
+				v = (CPHY_SETTLE >> 8) & 0xffu;
+			}
+			ch_wr(p, cphy_lane[l][i].reg, v);
+		}
+	}
+	for (unsigned i = 0; i < 11; ++i) {
+		ch_wr(p, 0x82cu + 4u * i, irq[i]);
+	}
+	printf("SWEET CAMHW: CSIPHY 1 set for C-PHY x3 (settle %#x); status0 %#x\n", CPHY_SETTLE, ch_rd(p, 0x8b0));
+}
+
+/* CSIPHY 2 for D-PHY, 4 data lanes + clock (front camera): cam_csiphy_1_1_hwreg.h csiphy_2ph_v1_1_reg (DNP entries
+ * left out), common lane enable 0xd5, settle 0x0e -- exactly the writes in Android's trace-front-phy.txt */
+static void
+ch_csiphy_dphy_on(void)
+{
+	static const uint16_t lanes[5] = { 0x000, 0x700, 0x200, 0x400, 0x600 };
+	static const uint16_t irq[11] = { 0xff, 0xff, 0xfb, 0xff, 0x7f, 0xff, 0xff, 0xef, 0xff, 0xff, 0xff };
+	vm_offset_t p = ch.csiphy;
+	ch_wr(p, 0x814, 0);
+	ch_wr(p, 0x818, 0);
+	ch_wr(p, 0x81c, 0);
+	ch_wr(p, 0x800, 1);
+	ch_wait(1);
+	ch_wr(p, 0x800, 0);
+	ch_wr(p, 0x814, 0xd5);
+	ch_wr(p, 0x818, 1);
+	ch_wr(p, 0x81c, 2);
+	ch_wr(p, 0x800, 1);
+	ch_wait(1);
+	ch_wr(p, 0x800, 0);
+	for (unsigned l = 0; l < 5; ++l) {
+		uint32_t b = lanes[l];
+		bool clk = b == 0x700;
+		ch_wr(p, b + 0x04, 0x0c);
+		ch_wr(p, b + 0x2c, 0x01);
+		ch_wr(p, b + 0x34, 0x0f);
+		ch_wr(p, b + 0x1c, 0x0a);
+		ch_wr(p, b + 0x14, 0x60);
+		if (clk) {
+			ch_wr(p, b + 0x28, 0x04);
+		}
+		ch_wr(p, b + 0x3c, 0xb8);
+		ch_wr(p, b + 0x00, clk ? 0x80 : 0x90);
+		ch_wr(p, b + 0x08, 0x0e);               /* settle */
+		if (clk) {
+			ch_wr(p, b + 0x0c, 0xa5);
+		}
+		ch_wr(p, b + 0x10, 0x52);
+		ch_wr(p, b + 0x38, clk ? 0x1f : 0xfe);
+		ch_wr(p, b + 0x60, 0x00);
+		ch_wr(p, b + 0x64, 0x7f);
+	}
+	for (unsigned i = 0; i < 11; ++i) {
+		ch_wr(p, 0x82cu + 4u * i, irq[i]);
+	}
+	printf("SWEET CAMHW: CSIPHY 2 set for D-PHY x4 (settle 0xe); status0 %#x\n", ch_rd(p, 0x8b0));
+}
+
+/* CSID 1: global reset, then CSI-2 RX for C-PHY 3 lanes from PHY 1, packet capture on, all RX interrupts unmasked */
+static bool
+ch_csid_on(void)
+{
+	vm_offset_t c = ch.csid;
+	printf("SWEET CAMHW: CSID 1 hw version %#x\n", ch_rd(c, CSID_HW_VERSION));
+	ch_wr(c, CSID_RX_IRQ_MASK, 0);
+	ch_wr(c, CSID_TOP_IRQ_CLR, 1);
+	ch_wr(c, CSID_RX_IRQ_CLR, 0xfffffffu);
+	ch_wr(c, CSID_IRQ_CMD, 1);
+	ch_wr(c, CSID_RX_CFG1, 0x80);
+	ch_wr(c, CSID_RST_STROBES, 0x1e);
+	if (!ch_poll(c, CSID_TOP_IRQ_ST, 1u, true, 100000)) {
+		printf("SWEET CAMHW: CSID reset not done (top %#x)\n", ch_rd(c, CSID_TOP_IRQ_ST));
+		return false;
+	}
+	ch_wr(c, CSID_TOP_IRQ_CLR, 1);
+	ch_wr(c, CSID_IRQ_CMD, 1);
+	ch_wr(c, CSID_RST_STROBES, 1);          /* register reset */
+	(void)ch_poll(c, CSID_TOP_IRQ_ST, 1u, true, 100000);
+	ch_wr(c, CSID_TOP_IRQ_CLR, 1);
+	ch_wr(c, CSID_IRQ_CMD, 1);
+	/* rear: 3 lanes, lane cfg 0x210, C-PHY, PHY 1; front: 4 lanes, lane cfg 0x3210, D-PHY, PHY 2 (Android's) */
+	ch_wr(c, CSID_RX_CFG0, ch_front ? 0x00232103u : 0x01102102u);
+	ch_wr(c, CSID_RX_CFG1, (1u << 6) | 1u); /* MISR, ECC correction */
+	/* capture: long packets of DT 0x2b VC 0, short packets, C-PHY headers of DT 0x2b */
+	ch_wr(c, CSID_RX_CAPTURE, 1u | (1u << 1) | (1u << 2) | (0x2bu << 4) | (0x2bu << 20));
+	ch_wr(c, CSID_RX_IRQ_MASK, 0xfffffffu);
+	ch_wr(c, CSID_RX_IRQ_CLR, 0xfffffffu);
+	ch_wr(c, CSID_IRQ_CMD, 1);
+	return true;
+}
+
+/* one batch on master 1 queue 0: SET_PARAM, LOCK, the words, UNLOCK, REPORT; waits for the REPORT */
+static int
+ch_cci_run(unsigned sid, const uint32_t *words, unsigned n)
+{
+	const uint32_t qoff = cc.m * 0x200u;       /* queue 0 */
+	ch_wr(cc.base, CCI_IRQ_CLEAR_0, 0xffffffffu);
+	ch_wr(cc.base, CCI_IRQ_CLEAR_1, 0xffffffffu);
+	ch_wr(cc.base, CCI_IRQ_GLOBAL_CLR, 1u);
+	ch_wr(cc.base, CCI_Q_LOAD_DATA + qoff, CMD_SET_PARAM | (sid << 4) | (3u << 16));
+	ch_wr(cc.base, CCI_Q_LOAD_DATA + qoff, CMD_LOCK);
+	for (unsigned i = 0; i < n; ++i) {
+		ch_wr(cc.base, CCI_Q_LOAD_DATA + qoff, words[i]);
+	}
+	ch_wr(cc.base, CCI_Q_LOAD_DATA + qoff, CMD_UNLOCK);
+	ch_wr(cc.base, CCI_Q_LOAD_DATA + qoff, 8u | (1u << 8));     /* REPORT */
+	ch_wr(cc.base, CCI_Q_EXEC_WORDS + qoff, ch_rd(cc.base, CCI_Q_CUR_WORDS + qoff));
+	ch_wr(cc.base, CCI_QUEUE_START, 1u << (cc.m * 2u));
+	uint32_t st = 0;
+	unsigned t;
+	for (t = 0; t < 200000; ++t) {
+		st = ch_rd(cc.base, CCI_IRQ_STATUS_0);
+		if (st & (CCI_Q0_REPORT | CCI_ERR)) {       /* M1 Q0 REPORT, or an error */
+			break;
+		}
+		delay(1);
+	}
+	if (!(st & CCI_Q0_REPORT) || (st & CCI_ERR)) {
+		printf("SWEET CAMHW: CCI batch to sid %#x (%u words, first %#x) failed: status0 %#x after %u us\n",
+		    sid, n, n ? words[0] : 0, st, t);
+		ch_wr(cc.base, CCI_RESET_CMD, CCI_MRESET);
+		return EIO;
+	}
+	ch_wr(cc.base, CCI_IRQ_CLEAR_0, 0xffffffffu);
+	ch_wr(cc.base, CCI_IRQ_GLOBAL_CLR, 1u);
+	return 0;
+}
+
+/* sensor writes (16-bit address, 8-bit data), 16 to a batch */
+static int
+ch_cci_write(unsigned sid, const uint16_t (*regs)[2], unsigned n)
+{
+	uint32_t w[16];
+	unsigned done = 0;
+	while (done < n) {
+		unsigned k = n - done < 16 ? n - done : 16;
+		for (unsigned i = 0; i < k; ++i) {
+			uint32_t reg = regs[done + i][0], val = regs[done + i][1];
+			w[i] = 9u | (3u << 4) | (((reg >> 8) & 0xffu) << 8) | ((reg & 0xffu) << 16) | ((val & 0xffu) << 24);
+		}
+		int e = ch_cci_run(sid, w, k);
+		if (e) {
+			printf("SWEET CAMHW: CCI write batch at %u (reg %#x) failed\n", done, regs[done][0]);
+			return e;
+		}
+		done += k;
+	}
+	return 0;
+}
+
+/* one I2C write of n bytes (the device's address bytes first) as one transaction: WRITE commands of 11 bytes that
+ * leave the bus held (length 0xf, Android's sequential write: cam_cci_data_queue), the last one with the stop */
+static int
+ch_cci_burst(unsigned sid, const uint8_t *b, unsigned n)
+{
+	uint32_t w[100];
+	unsigned nw = 0;
+	if (n == 0 || n > 11u * 30u) {
+		return EINVAL;
+	}
+	while (n > 0) {
+		unsigned k = n > 11u ? 11u : n;
+		uint8_t c[12];
+		c[0] = (uint8_t)(9u | ((n > 11u ? 0xfu : k) << 4));
+		memcpy(c + 1, b, k);
+		for (unsigned i = 0; i < k + 1u; i += 4) {
+			uint32_t v = 0;
+			for (unsigned j = 0; j < 4 && i + j < k + 1u; ++j) {
+				v |= (uint32_t)c[i + j] << (8 * j);
+			}
+			w[nw++] = v;
+		}
+		b += k;
+		n -= k;
+	}
+	return ch_cci_run(sid, w, nw);
+}
+
+static void
+ch_csid_report(const char *when)
+{
+	vm_offset_t c = ch.csid;
+	uint32_t st = ch_rd(c, CSID_RX_IRQ_ST);
+	printf("SWEET CAMHW: CSID %s: rx irq %#x, packets %u, ecc %#x, crc %u; long pkt %#x/%#x, cphy hdr %#x; "
+	    "CSIPHY status0 %#x\n", when, st, ch_rd(c, CSID_RX_PKTS), ch_rd(c, CSID_RX_ECC), ch_rd(c, CSID_RX_CRC),
+	    ch_rd(c, CSID_RX_LONG0), ch_rd(c, CSID_RX_LONG1), ch_rd(c, CSID_RX_CPHY_HDR), ch_rd(ch.csiphy, 0x8b0));
+	ch_wr(c, CSID_RX_IRQ_CLR, st);
+	ch_wr(c, CSID_IRQ_CMD, 1);
+}
