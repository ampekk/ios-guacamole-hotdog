+/* TLMM: pull (0 none, 1 down, 3 up), function, drive code (0 = 2 mA), output enable, level */
+static void
+ch_gpio(vm_offset_t tile, unsigned pin, unsigned pull, unsigned func, bool out, bool high)
+{
+	if (out) {
+		ch_wr(tile, TLMM_IO(pin), high ? 2u : 0u);
+	}
+	ch_wr(tile, TLMM_CFG(pin), pull | (func << 2) | (0u << 6) | (out ? 1u << 9 : 0u));
+	if (out) {
+		ch_wr(tile, TLMM_IO(pin), high ? 2u : 0u);
+	}
+}
