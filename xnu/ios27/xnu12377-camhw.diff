+/* MMIO as single base-register LDR/STR (as sweet_gpu.c): the hypervisor traps the apps SMMU and decodes only that */
+static uint32_t
+ch_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v;
+	volatile uint32_t *p = (volatile uint32_t *)(base + off);
+	__asm__ volatile("ldr %w0, [%1]" : "=r"(v) : "r"(p) : "memory");
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+ch_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	volatile uint32_t *p = (volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	__asm__ volatile("str %w0, [%1]" : : "r"(val), "r"(p) : "memory");
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+ch_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ch_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* poll (base + off) & mask until it is (set ? mask : 0), up to us microseconds */
+static bool
+ch_poll(vm_offset_t base, uint32_t off, uint32_t mask, bool set, unsigned us)
+{
+	for (unsigned i = 0; i < us; ++i) {
+		uint32_t v = ch_rd(base, off) & mask;
+		if (set ? v == mask : v == 0) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/*
+ * a branch clock on: CBCR bit 0, then CLK_OFF (bit 31) clear -- except the BRANCH_HALT_DELAY ones (gcc camera_ahb
+ * and camera_xo, which are also hardware-gated, and camcc core_ahb), whose CLK_OFF does not follow: a short wait.
+ * (TEST camhw-1: gcc_camera_ahb read 0x80000003 -- enabled, HW_CTL -- and was taken for a failure.)
+ */
+static bool
+ch_branch_check(vm_offset_t base, uint32_t cbcr, const char *name, bool check)
+{
+	ch_wr(base, cbcr, ch_rd(base, cbcr) | 1u);
+	if (!check) {
+		delay(10);
+		return true;
+	}
+	bool ok = ch_poll(base, cbcr, 1u << 31, false, 2000);
+	if (!ok) {
+		printf("SWEET CAMHW: clock %s did not come on (cbcr %#x)\n", name, ch_rd(base, cbcr));
+	}
+	return ok;
+}
+
+static bool
+ch_branch(vm_offset_t base, uint32_t cbcr, const char *name)
+{
+	return ch_branch_check(base, cbcr, name, true);
+}
+
+static void
+ch_branch_off(vm_offset_t base, uint32_t cbcr)
+{
+	ch_wr(base, cbcr, ch_rd(base, cbcr) & ~1u);
+}
+
+/* an RCG on XO (source 0, divider bypassed, no M/N): CFG_RCGR = 0, then CMD_RCGR UPDATE */
+static bool
+ch_rcg_xo(uint32_t cmd_rcgr, const char *name)
+{
+	ch_wr(ch.camcc, cmd_rcgr + 4u, 0);
+	ch_wr(ch.camcc, cmd_rcgr, ch_rd(ch.camcc, cmd_rcgr) | 1u);
+	bool ok = ch_poll(ch.camcc, cmd_rcgr, 1u, false, 2000);
+	if (!ok) {
+		printf("SWEET CAMHW: rcg %s update stuck (cmd %#x)\n", name, ch_rd(ch.camcc, cmd_rcgr));
+	}
+	return ok;
+}
