+/* ---------------------------------------------------------------- step 2b + 3: one frame into memory */
+
+static uint64_t
+ch_pa(vm_offset_t va)
+{
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+	return pn ? ptoa_64(pn) + (va & PAGE_MASK) : 0;
+}
+
+static bool
+ch_sid_match(uint32_t smr, uint32_t sid, uint32_t mask)
+{
+	uint32_t id = smr & 0x7fffu, m = (smr >> 16) & 0x7fffu;
+	return ((id ^ sid) & ~(m | mask) & 0x7fffu) == 0;
+}
+
+static struct {
+	uint32_t psize, npage;
+	int smr, cb;
+} chs = { 0, 0, -1, -1 };
+
+static vm_offset_t
+ch_cbp(int cb)
+{
+	return ch.smmu + (vm_offset_t)chs.npage * chs.psize + (vm_offset_t)cb * chs.psize;
+}
+
+/* the frame buffer and the stage-1 tables: IOVA FRAME_IOVA..+FRAME_ALLOC -> the buffer's pages, 4K granule,
+ * 32-bit input (walk starts at level 1), L1[0] -> L2, L2[128..135] -> 8 L3 tables */
+static bool
+ch_dma_alloc(void)
+{
+	if (ch.buf[0] && ch.tables) {
+		return true;
+	}
+	for (unsigned b = 0; b < NBUF; ++b) {
+		if (kmem_alloc(kernel_map, &ch.buf[b], FRAME_ALLOC, KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			ch.buf[b] = 0;
+			printf("SWEET CAMHW: no memory for frame buffer %u\n", b);
+			return false;
+		}
+	}
+	ch.frame = ch.buf[0];
+	if (kmem_alloc(kernel_map, &ch.tables, round_page(TABLE_PAGES * 4096u), KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		ch.tables = 0;
+		printf("SWEET CAMHW: no memory for the page tables\n");
+		return false;
+	}
+	uint64_t *l1 = (uint64_t *)ch.tables, *l2 = (uint64_t *)(ch.tables + 4096u);
+	l1[(FRAME_IOVA >> 30) & 3u] = ch_pa(ch.tables + 4096u) | 3u;
+	for (unsigned t = 0; t < NBUF * 8u; ++t) {
+		vm_offset_t l3va = ch.tables + (2u + t) * 4096u, buf = ch.buf[t / 8u];
+		uint64_t *l3 = (uint64_t *)l3va;
+		l2[((FRAME_IOVA >> 21) & 511u) + t] = ch_pa(l3va) | 3u;
+		for (unsigned i = 0; i < 512; ++i) {
+			uint64_t pa = ch_pa(buf + ((vm_offset_t)(t % 8u) * 512u + i) * 4096u);
+			if (!pa) {
+				printf("SWEET CAMHW: buffer %u page %u has no physical address\n", t / 8u, (t % 8u) * 512u + i);
+				return false;
+			}
+			/* page, AttrIndx 0 (MAIR 0x44, normal non-cacheable), AP RW, outer shareable, AF */
+			l3[i] = pa | 0x643u;
+		}
+	}
+	ch.tables_pa = ch_pa(ch.tables);
+	flush_dcache64((addr64_t)ch.tables, TABLE_PAGES * 4096u, FALSE);
+	printf("SWEET CAMHW: %u frame buffers of %u MB (IOVA %#x + n * %#x), tables pa %#llx\n", NBUF, FRAME_ALLOC >> 20,
+	    FRAME_IOVA, FRAME_ALLOC, (unsigned long long)ch.tables_pa);
+	return true;
+}
+
+/* the IFE streams on the apps SMMU: a free SMR + context bank with stage-1 translation through our tables
+ * (MMIO single base-register, see ch_rd; free slot choice as userland/wland/radio.c smmu_wlan_identity) */
+static bool
+ch_smmu_setup(void)
+{
+	vm_offset_t s = ch.smmu;
+	uint32_t id0 = ch_rd(s, 0x20), id1 = ch_rd(s, 0x24);
+	uint32_t nsmr = id0 & 0xffu, ncb = id1 & 0xffu;
+	chs.psize = (id1 >> 31) ? 0x10000u : 0x1000u;
+	chs.npage = 1u << (((id1 >> 28) & 7u) + 1u);
+	uint64_t used[4] = { 0, 0, 0, 0 };
+	int slot = -1, cb = -1;
+
+	for (uint32_t i = 0; i < nsmr && i < 128; ++i) {
+		uint32_t smr = ch_rd(s, 0x800u + 4u * i), s2cr = ch_rd(s, 0xc00u + 4u * i);
+		if (!(smr >> 31)) {
+			if (slot < 0 && (int)i != chs.smr) {
+				slot = (int)i;
+			}
+			continue;
+		}
+		if (((s2cr >> 16) & 3u) == 0) {
+			used[(s2cr & 0xffu) / 64u] |= 1ull << ((s2cr & 0xffu) % 64u);
+		}
+		if (ch_sid_match(smr, IFE_SID, IFE_SID_MASK) && (int)i != chs.smr) {
+			printf("SWEET CAMHW: smmu SMR%u %#x already matches the IFE (S2CR %#x): not touching it\n", i, smr, s2cr);
+			return false;
+		}
+	}
+	if (chs.smr >= 0 && chs.cb >= 0) {
+		slot = chs.smr;         /* ours from an earlier run */
+		cb = chs.cb;
+	} else {
+		for (uint32_t c = 0; c < ncb && c < 256; ++c) {
+			if (!(used[c / 64u] & (1ull << (c % 64u))) && !(ch_rd(ch_cbp((int)c), 0) & 1u) &&
+			    ch_rd(s + chs.psize, 4u * c) == 0) {
+				cb = (int)c;
+				break;
+			}
+		}
+	}
+	if (slot < 0 || cb < 0 || (uint64_t)(chs.npage + (uint32_t)cb + 1u) * chs.psize > CH_SMMU_SIZE) {
+		printf("SWEET CAMHW: smmu: no free SMR/bank (SMR %d, bank %d; %u SMRs, %u banks)\n", slot, cb, nsmr, ncb);
+		return false;
+	}
+	vm_offset_t gr1 = s + chs.psize, cbp = ch_cbp(cb);
+	ch_wr(cbp, 0x0, 0);                              /* SCTLR off while it changes */
+	ch_wr(cbp, 0x58, 0xffffffffu);                   /* FSR */
+	ch_wr(cbp, 0x20, (uint32_t)ch.tables_pa);        /* TTBR0, ASID 0 */
+	ch_wr(cbp, 0x24, (uint32_t)(ch.tables_pa >> 32));
+	ch_wr(cbp, 0x30, 0x00802020u);                   /* TCR: T0SZ 32, non-cacheable walks, SH0 outer, 4K, EPD1 */
+	ch_wr(cbp, 0x10, 0x00038001u);                   /* TCR2: 36-bit PA, SEP upstream */
+	ch_wr(cbp, 0x38, 0x00000044u);                   /* MAIR0: attr0 normal non-cacheable */
+	ch_wr(cbp, 0x3c, 0);
+	ch_wr(gr1, 0x800u + 4u * (uint32_t)cb, 1u);      /* CBA2R: AArch64 */
+	ch_wr(gr1, 4u * (uint32_t)cb, 0x0001f000u);      /* CBAR: stage 1, stage 2 bypass */
+	ch_wr(cbp, 0x618, 0);                            /* TLBIALL */
+	ch_wr(cbp, 0x7f0, 0);                            /* TLBSYNC */
+	(void)ch_poll(cbp, 0x7f4, 1u, false, 10000);
+	ch_wr(cbp, 0x0, 0x27u);                          /* SCTLR: M, TRE, AFE, CFRE (faults terminate, no stall) */
+	ch_wr(s, 0xc00u + 4u * (uint32_t)slot, (uint32_t)cb);   /* S2CR: translate through this bank */
+	ch_wr(s, 0x800u + 4u * (uint32_t)slot, (1u << 31) | (IFE_SID_MASK << 16) | IFE_SID);
+	ch_wr(s, 0x70, 0);                               /* sTLBGSYNC */
+	(void)ch_poll(s, 0x74, 1u, false, 10000);
+	uint32_t smr = ch_rd(s, 0x800u + 4u * (uint32_t)slot), s2cr = ch_rd(s, 0xc00u + 4u * (uint32_t)slot);
+	bool ok = (smr >> 31) && ch_sid_match(smr, IFE_SID, IFE_SID_MASK) && ((s2cr >> 16) & 3u) == 0 &&
+	    (s2cr & 0xffu) == (uint32_t)cb && (ch_rd(cbp, 0) & 1u) && ch_rd(cbp, 0x20) == (uint32_t)ch.tables_pa;
+	printf("SWEET CAMHW: smmu (ID0 %#x ID1 %#x) IFE %#x/%#x -> CB%d via SMR%d: SMR %#x S2CR %#x SCTLR %#x TCR %#x "
+	    "TTBR0 %#x%08x CBAR %#x -> %s\n", id0, id1, IFE_SID, IFE_SID_MASK, cb, slot, smr, s2cr, ch_rd(cbp, 0),
+	    ch_rd(cbp, 0x30), ch_rd(cbp, 0x24), ch_rd(cbp, 0x20), ch_rd(gr1, 4u * (uint32_t)cb), ok ? "ok" : "NOT as written");
+	if (ok) {
+		chs.smr = slot;
+		chs.cb = cb;
+	}
+	return ok;
+}
+
+static void
+ch_smmu_report(const char *when)
+{
+	if (chs.cb < 0) {
+		return;
+	}
+	vm_offset_t cbp = ch_cbp(chs.cb);
+	uint32_t fsr = ch_rd(cbp, 0x58);
+	printf("SWEET CAMHW: smmu %s: FSR %#x FAR %#x%08x FSYNR0 %#x CBFRSYNRA %#x\n", when, fsr, ch_rd(cbp, 0x64),
+	    ch_rd(cbp, 0x60), ch_rd(cbp, 0x68), ch_rd(ch.smmu + chs.psize, 0x400u + 4u * (uint32_t)chs.cb));
+	if (fsr) {
+		ch_wr(cbp, 0x58, fsr);
+	}
+}
+
+/* IFE 1: reset (registers too), bus init as cam_vfe_bus_init_hw, write master 0 for RDI0 frame-based MIPI RAW
+ * (cam_vfe_bus_start_wm / update_wm with CAM_FORMAT_MIPI_RAW_10), then RDI0 reg update to latch it */
+static bool
+ch_ife_on(void)
+{
+	vm_offset_t f = ch.ife;
+	printf("SWEET CAMHW: IFE 1 hw version %#x, bus %#x\n", ch_rd(f, IFE_HW_VERSION), ch_rd(f, BUS_HW_VERSION));
+	ch_wr(f, IFE_IRQ_CLR0, 0xffffffffu);
+	ch_wr(f, IFE_IRQ_CLR1, 0xffffffffu);
+	ch_wr(f, IFE_IRQ_GLOBAL_CLR, 1);
+	ch_wr(f, IFE_IRQ_MASK0, 1u << 31);
+	ch_wr(f, IFE_GLOBAL_RESET, 0x3f9fu);
+	bool rst = ch_poll(f, IFE_IRQ_ST0, 1u << 31, true, 100000);
+	printf("SWEET CAMHW: IFE reset %s (status0 %#x)\n", rst ? "done" : "NOT DONE", ch_rd(f, IFE_IRQ_ST0));
+	ch_wr(f, IFE_IRQ_CLR0, 0xffffffffu);
+	ch_wr(f, IFE_IRQ_CLR1, 0xffffffffu);
+	ch_wr(f, IFE_IRQ_GLOBAL_CLR, 1);
+	if (!rst) {
+		return false;
+	}
+	/* top: RDI0 SOF, RDI0 reg update, bus; all of status1 (errors) */
+	ch_wr(f, IFE_IRQ_MASK0, 0x08000000u | 0x20u | (1u << 9));
+	ch_wr(f, IFE_IRQ_MASK1, 0xffffffffu);
+	/* bus init */
+	ch_wr(f, 0x226c, 0x82);                  /* debug_status_cfg */
+	ch_wr(f, 0x2080, 0);                     /* addr_sync_frame_hdr */
+	ch_wr(f, BUS_CGC_OVD, 0xfffffu);         /* no clock gating at the bus input */
+	ch_wr(f, 0x211c, 0);                     /* test bus ctrl */
+	ch_wr(f, 0x2084, (1u << 24) - 1u);       /* addr_sync_no_sync */
+	ch_wr(f, BUS_IRQ_MASK0, 0xffffffffu);
+	ch_wr(f, BUS_IRQ_MASK1, 0xffffffffu);
+	ch_wr(f, BUS_IRQ_MASK2, 0xffffffffu);
+	ch_wr(f, BUS_IRQ_CLR0, 0xffffffffu);
+	ch_wr(f, BUS_IRQ_CLR1, 0xffffffffu);
+	ch_wr(f, BUS_IRQ_CLR2, 0xffffffffu);
+	ch_wr(f, BUS_IRQ_GLOBAL_CLR, 1);
+	/* WM0 */
+	ch_wr(f, WM0_BURST_LIMIT, 0xf);
+	ch_wr(f, WM0_WIDTH, 0xff01u);
+	ch_wr(f, WM0_HEIGHT, 0);
+	ch_wr(f, WM0_PACKER, 0);
+	ch_wr(f, WM0_STRIDE, 0xff01u);
+	ch_wr(f, WM0_SUB_PERIOD, 0);
+	ch_wr(f, WM0_SUB_PATTERN, 1);
+	ch_wr(f, WM0_DROP_PERIOD, 0);
+	ch_wr(f, WM0_DROP_PATTERN, 1);
+	ch_wr(f, WM0_IMAGE_OFFSET, 0);
+	ch_wr(f, WM0_IMAGE_ADDR, FRAME_IOVA);
+	ch_wr(f, WM0_FRAME_INC, FRAME_BYTES);
+	ch_wr(f, WM0_CFG, 0);                    /* enabled later, once the sensor has settled (ch_capture_wait) */
+	ch_wr(f, IFE_REG_UPDATE, 0x2);           /* RDI0 */
+	ch_wait(1);
+	printf("SWEET CAMHW: IFE WM0 set: addr %#x cfg %#x width %#x stride %#x; top status0 %#x status1 %#x\n",
+	    ch_rd(f, WM0_IMAGE_ADDR), ch_rd(f, WM0_CFG), ch_rd(f, WM0_WIDTH), ch_rd(f, WM0_STRIDE), ch_rd(f, IFE_IRQ_ST0),
+	    ch_rd(f, IFE_IRQ_ST1));
+	return true;
+}
+
+/* CSID 1 RDI0: VC 0, DT 0x2b (RAW10) passed through as received (decode format 0xf), no crop, no drop
+ * (cam_ife_csid_init_config_rdi_path + cam_ife_csid_enable_rdi_path) */
+static void
+ch_csid_rdi_on(void)
+{
+	vm_offset_t c = ch.csid;
+	uint32_t cfg0 = (0u << 22) | (0x2bu << 16) | (0u << 27) | (0xfu << 12) | (0u << 10) | (1u << 2) | 3u;
+	ch_wr(c, CSID_RDI0_CFG0, cfg0);
+	ch_wr(c, CSID_RDI0_CFG1, 2);             /* timestamp strobe POST_IRQ */
+	ch_wr(c, CSID_RDI0_DROP_PER, 1);
+	ch_wr(c, CSID_RDI0_DROP_PAT, 0);
+	ch_wr(c, CSID_RDI0_SUB_PER, 1);
+	ch_wr(c, CSID_RDI0_SUB_PAT, 0);
+	ch_wr(c, CSID_RDI0_PIX_PAT, 0);
+	ch_wr(c, CSID_RDI0_PIX_PER, 1);
+	ch_wr(c, CSID_RDI0_LINE_PAT, 0);
+	ch_wr(c, CSID_RDI0_LINE_PER, 1);
+	ch_wr(c, CSID_RDI0_CTRL, 0);
+	ch_wr(c, CSID_RDI0_CFG0, cfg0 | (1u << 31));
+	ch_wr(c, CSID_RDI0_MEASURE_CFG0, ch_rd(c, CSID_RDI0_MEASURE_CFG0) | 0xcu);
+	ch_wr(c, CSID_RDI0_IRQ_CLR, 0x7fffu);
+	ch_wr(c, CSID_RDI0_IRQ_MASK, 0x7fffu);
+	ch_wr(c, CSID_IRQ_CMD, 1);
+	ch_wr(c, CSID_RDI0_CTRL, 1);             /* resume at frame boundary */
+	printf("SWEET CAMHW: CSID RDI0 on: cfg0 %#x status %#x\n", ch_rd(c, CSID_RDI0_CFG0), ch_rd(c, CSID_RDI0_STATUS));
+}
+
+static void
+ch_capture_report(const char *when)
+{
+	vm_offset_t f = ch.ife, c = ch.csid;
+	printf("SWEET CAMHW: %s: CSID RDI0 irq %#x status %#x measure %#x bytes %u; IFE top %#x/%#x viol %#x; "
+	    "bus %#x/%#x/%#x; WM0 status %#x/%#x\n", when, ch_rd(c, CSID_RDI0_IRQ_ST), ch_rd(c, CSID_RDI0_STATUS),
+	    ch_rd(c, CSID_RDI0_MEASURE0), ch_rd(c, CSID_RDI0_BYTES_PING), ch_rd(f, IFE_IRQ_ST0), ch_rd(f, IFE_IRQ_ST1),
+	    ch_rd(f, IFE_VIOLATION), ch_rd(f, BUS_IRQ_ST0), ch_rd(f, BUS_IRQ_ST1), ch_rd(f, BUS_IRQ_ST2),
+	    ch_rd(f, WM0_STATUS0), ch_rd(f, WM0_STATUS1));
+	ch_smmu_report(when);
+}
+
+/* what reached memory: 64-bit words changed from the fill, the last one changed, the first bytes, a rough level */
+static void
+ch_frame_report(void)
+{
+	flush_dcache64((addr64_t)ch.frame, FRAME_ALLOC, FALSE);
+	const uint64_t *w = (const uint64_t *)ch.frame;
+	unsigned changed = 0, last = 0, first = ~0u;
+	for (unsigned i = 0; i < FRAME_ALLOC / 8u; ++i) {
+		if (w[i] != 0x5a5a5a5a5a5a5a5aull) {
+			changed++;
+			last = i;
+			if (first == ~0u) {
+				first = i;
+			}
+		}
+	}
+	const uint8_t *b = (const uint8_t *)ch.frame;
+	printf("SWEET CAMHW: frame memory: %u of %u words written (first %u, last at byte %u); bytes 0..15: "
+	    "%02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n", changed, FRAME_ALLOC / 8u,
+	    first == ~0u ? 0 : first * 8u, changed ? last * 8u + 7u : 0, b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7],
+	    b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]);
+	if (!changed) {
+		ch.frame_len = 0;
+		return;
+	}
+	/* RAW10 packs 4 pixels in 5 bytes, the first 4 the high 8 bits: average them on 8 rows spread down the frame */
+	for (unsigned r = 0; r < 8; ++r) {
+		unsigned row = 187u + r * 375u, sum = 0, n = 0;
+		const uint8_t *p = b + (size_t)row * FRAME_PITCH;
+		for (unsigned x = 0; x < 5000u; x += 5u) {
+			sum += p[x] + p[x + 1] + p[x + 2] + p[x + 3];
+			n += 4;
+		}
+		printf("SWEET CAMHW: row %u: mean %u/255\n", row, sum / n);
+	}
+	ch.frame_len = FRAME_BYTES;
+}
+
+/* step 2b + 3: after ch_csiphy_on/ch_csid_on, with the sensor not yet started */
+static bool
+ch_capture_prepare(void)
+{
+	if (!ch.ife || !ch.smmu) {
+		printf("SWEET CAMHW: IFE/SMMU io map failed\n");
+		return false;
+	}
+	/* IFE at 400 MHz from PLL4 even, CAMNOC AXI at 400 MHz from PLL0 main /3 */
+	if (!ch_pll(CC_PLL4, 0x29, 0xaaaa, 0x100, "PLL4")) {
+		return false;
+	}
+	if (!ch_rcg(CC_IFE1_RCG, (6u << 8) | 1u, "ife_1 400") || !ch_rcg(CC_CAMNOC_AXI_RCG, (1u << 8) | 5u, "camnoc_axi 400")) {
+		return false;
+	}
+	if (!ch_dma_alloc()) {
+		return false;
+	}
+	memset((void *)ch.frame, 0x5a, FRAME_ALLOC);
+	flush_dcache64((addr64_t)ch.frame, FRAME_ALLOC, FALSE);
+	ch.frame_len = 0;
+	if (!ch_smmu_setup()) {
+		return false;
+	}
+	ch_smmu_report("before");
+	if (!ch_ife_on()) {
+		return false;
+	}
+	ch_csid_rdi_on();
+	return true;
+}
+
+/* with the sensor streaming: wait up to 2 s for WM0's buffer done (bus status1 bit 0) or a fault, then stop the WM */
+static void
+ch_capture_wait(void)
+{
+	vm_offset_t f = ch.ife;
+	unsigned t;
+	uint32_t st1 = 0;
+	/* camhw6's frame was the first after stream on, and black (all at the black level 64): let the sensor run for
+	 * 400 ms, log what it says it is doing, then enable WM0 (latched at the next RDI0 SOF by the reg update) */
+	for (unsigned i = 0; i < 4; ++i) {
+		ch_wait(100);
+		uint8_t fc = 0, ex[2] = { 0, 0 }, ag[2] = { 0, 0 }, dg[2] = { 0, 0 };
+		(void)ch_cci_read(IMX586_SID, 0x0005, 1, &fc);
+		(void)ch_cci_read(IMX586_SID, 0x0202, 2, ex);
+		(void)ch_cci_read(IMX586_SID, 0x0204, 2, ag);
+		(void)ch_cci_read(IMX586_SID, 0x020e, 2, dg);
+		printf("SWEET CAMHW: sensor at %u ms: frame count %u, integration %u lines, analog gain code %u, digital gain %#x\n",
+		    (i + 1u) * 100u, fc, (ex[0] << 8) | ex[1], (ag[0] << 8) | ag[1], (dg[0] << 8) | dg[1]);
+	}
+	ch_csid_report("settled");
+	ch_wr(f, BUS_IRQ_CLR0, 0xffffffffu);
+	ch_wr(f, BUS_IRQ_CLR1, 0xffffffffu);
+	ch_wr(f, BUS_IRQ_CLR2, 0xffffffffu);
+	ch_wr(f, BUS_IRQ_GLOBAL_CLR, 1);
+	ch_wr(f, WM0_IMAGE_ADDR, FRAME_IOVA);
+	ch_wr(f, WM0_CFG, 3);                    /* enable, frame based */
+	ch_wr(f, IFE_REG_UPDATE, 0x2);
+	for (t = 0; t < 200; ++t) {
+		ch_wait(10);
+		st1 = ch_rd(f, BUS_IRQ_ST1);
+		/* FSR bits 10:9 are FORMAT (2 = AArch64), not a fault */
+		if ((st1 & 1u) || (chs.cb >= 0 && (ch_rd(ch_cbp(chs.cb), 0x58) & ~0x600u))) {
+			break;
+		}
+		if (t == 9 || t == 49 || t == 99) {
+			ch_csid_report("waiting");
+			ch_capture_report("waiting");
+		}
+	}
+	printf("SWEET CAMHW: %s after %u ms (bus status1 %#x)\n", (st1 & 1u) ? "WM0 BUFFER DONE" : "no buffer done",
+	    (t + 1u) * 10u, st1);
+	ch_capture_report("after");
+	ch_wr(f, WM0_CFG, 0);                    /* stop writing */
+	ch_wr(f, IFE_REG_UPDATE, 0x2);
+	ch_wr(ch.csid, CSID_RDI0_CTRL, 2);       /* halt immediately */
+	ch_wr(ch.csid, CSID_RDI0_CFG0, ch_rd(ch.csid, CSID_RDI0_CFG0) & ~(1u << 31));
+}
+
+/* step 2a: with the sensor up, the receive side on, the sensor started as Android starts it, counters read;
+ * with capture (step 2b + 3), one frame through CSID RDI0 and IFE WM0 into memory behind the SMMU */
+/* the receive side: camcc PLL0, ife_1 GDSC, the CSIPHY/CSID/IFE clocks, CSIPHY 1 and CSID 1 RX */
+static bool
+ch_rx_setup(void)
+{
+	bool ok = ch_pll0();
+	ok = ok && ch_gdsc(CC_IFE1_GDSC, "ife_1");
+	ok = ok && ch_rcg(CC_CPHY_RX_RCG, (3u << 8) | 1u, "cphy_rx 400");
+	ok = ok && ch_rcg(ch_front ? CC_CSI2PHYTMR_RCG : CC_CSI1PHYTMR_RCG, (2u << 8) | 3u, "csiNphytimer 300");
+	ok = ok && ch_rcg(CC_IFE1_CSID_RCG, (3u << 8) | 1u, "ife_1_csid 400");
+	ok = ok && ch_rcg(CC_IFE1_RCG, 0, "ife_1 xo");
+	if (!ok) {
+		return false;
+	}
+	ok = ch_branch(ch.camcc, ch_front ? CC_CSIPHY2 : CC_CSIPHY1, ch_front ? "csiphy2" : "csiphy1");
+	ok &= ch_branch(ch.camcc, ch_front ? CC_CSI2PHYTMR : CC_CSI1PHYTMR, "csiNphytimer");
+	ok &= ch_branch(ch.camcc, CC_IFE1_CSID, "ife_1_csid");
+	ok &= ch_branch(ch.camcc, CC_IFE1_CPHY_RX, "ife_1_cphy_rx");
+	ok &= ch_branch(ch.camcc, CC_IFE1, "ife_1");
+	(void)ch_branch(ch.camcc, CC_IFE1_AXI, "ife_1_axi");
+	if (!ok) {
+		return false;
+	}
+	if (ch_front) {
+		ch.csiphy = ch.csiphy2;
+		ch_csiphy_dphy_on();
+	} else {
+		ch.csiphy = ch.csiphy1;
+		ch_csiphy_on();
+	}
+	if (!ch_csid_on()) {
+		return false;
+	}
+	ch_csid_report("before");
+	return true;
+}
+
+/* the IMX586 started with Android's own writes (the last one is stream on) */
+static int
+ch_sensor_start(void)
+{
+	if (ch_front) {
+		int e = ch_cci_write(IMX471_SID, imx471_start, IMX471_MODE_START);
+		if (!e) {
+			ch_wait(5);
+			e = ch_cci_write(IMX471_SID, imx471_start + IMX471_MODE_START,
+			    (unsigned)(sizeof(imx471_start) / sizeof(imx471_start[0])) - IMX471_MODE_START);
+		}
+		printf("SWEET CAMHW: IMX471 start (%u writes) -> %d\n", (unsigned)(sizeof(imx471_start) / sizeof(imx471_start[0])), e);
+		return e;
+	}
+	int e = ch_cci_write(IMX586_SID, imx586_start, IMX586_MODE_START);
+	if (!e) {
+		ch_wait(5);
+		e = ch_cci_write(IMX586_SID, imx586_start + IMX586_MODE_START,
+		    (unsigned)(sizeof(imx586_start) / sizeof(imx586_start[0])) - IMX586_MODE_START);
+	}
+	printf("SWEET CAMHW: IMX586 start (%u writes) -> %d\n", (unsigned)(sizeof(imx586_start) / sizeof(imx586_start[0])), e);
+	return e;
+}
+
+static int
+ch_stream_test(bool capture)
+{
+	if (!ch_rx_setup()) {
+		return EIO;
+	}
+	if (capture && !ch_capture_prepare()) {
+		return EIO;
+	}
+	int e = ch_sensor_start();
+	if (e) {
+		return e;
+	}
+	if (capture) {
+		ch_capture_wait();
+	} else {
+		for (unsigned i = 0; i < 5; ++i) {
+			ch_wait(100);
+			ch_csid_report("streaming");
+		}
+	}
+	static const uint16_t stop[1][2] = { { 0x0100, 0x00 } };
+	(void)ch_cci_write(IMX586_SID, stop, 1);
+	ch_wait(50);
+	ch_csid_report("stopped");
+	if (capture) {
+		ch_frame_report();
+	}
+	return 0;
+}
+
+static void
+ch_sensor_off(void)
+{
+	ch_gpio(ch.east, PIN_RESET, 0, 0, true, false);
+	ch_wait(1);
+	ch_gpio(ch.north, PIN_MCLK, 1, 0, false, false);         /* MCLK pin back to a pulled-down input */
+	ch_branch_off(ch.camcc, CC_MCLK1);
+	(void)ch_pmic_gpio(false);
+	ch_gpio(ch.east, PIN_VANA2, 0, 0, true, false);
+	ch_gpio(ch.north, PIN_VANA, 0, 0, true, false);
+	printf("SWEET CAMHW: sensor reset held, MCLK off, switches off (rails left voted)\n");
+}
+
+static bool
+ch_map(void)
+{
+	if (!ch.gcc) {
+		ch.csiphy1 = ml_io_map(CH_CSIPHY1_PA, 0x1000);
+		ch.csiphy2 = ml_io_map(CH_CSIPHY2_PA, 0x1000);
+		ch.csiphy = ch.csiphy1;
+		ch.csid = ml_io_map(CH_CSID1_PA, 0x1000);
+		ch.ife = ml_io_map(CH_IFE1_PA, 0x4000);
+		ch.smmu = ml_io_map(CH_SMMU_PA, CH_SMMU_SIZE);
+		ch.gcc = ml_io_map(CH_GCC_PA, 0x10000);
+		ch.camcc = ml_io_map(CH_CAMCC_PA, 0x10000);
+		ch.cci = ml_io_map(CH_CCI_PA, 0x1000);
+		ch.cci1 = ml_io_map(CH_CCI1_PA, 0x1000);
+		ch.north = ml_io_map(CH_NORTH_PA, TLMM_CFG(PIN_SCL_F + 1));
+		ch.east = ml_io_map(CH_EAST_PA, TLMM_CFG(PIN_RESET + 1));
+	}
+	if (!ch.gcc || !ch.camcc || !ch.cci || !ch.cci1 || !ch.north || !ch.east || !ch.csiphy1 || !ch.csiphy2 || !ch.csid) {
+		printf("SWEET CAMHW: io map failed\n");
+		return false;
+	}
+	return true;
+}
+
+/* power the sensor up as Android does and read its ID: the ID, or -errno (the sensor is left powered on success) */
+static int
+ch_power_up(void)
+{
+	if (!ch_map()) {
+		return -ENOMEM;
+	}
+	cc.base = ch.cci;
+	cc.m = 1;
+	printf("SWEET CAMHW: TLMM before: 11 %#x/%#x 14 %#x 19 %#x 20 %#x 29 %#x/%#x 30 %#x/%#x; GDSC %#x\n",
+	    ch_rd(ch.north, TLMM_CFG(PIN_VANA)), ch_rd(ch.north, TLMM_IO(PIN_VANA)), ch_rd(ch.north, TLMM_CFG(PIN_MCLK)),
+	    ch_rd(ch.north, TLMM_CFG(PIN_SDA1)), ch_rd(ch.north, TLMM_CFG(PIN_SCL1)),
+	    ch_rd(ch.east, TLMM_CFG(PIN_VANA2)), ch_rd(ch.east, TLMM_IO(PIN_VANA2)),
+	    ch_rd(ch.east, TLMM_CFG(PIN_RESET)), ch_rd(ch.east, TLMM_IO(PIN_RESET)), ch_rd(ch.camcc, CC_TITAN_GDSC));
+
+	/* reset low first, the CCI pins to the controller (pull-up, 2 mA) */
+	ch_gpio(ch.east, PIN_RESET, 0, 0, true, false);
+	ch_gpio(ch.north, PIN_SDA1, 3, 1, false, false);
+	ch_gpio(ch.north, PIN_SCL1, 3, 1, false, false);
+
+	if (!ch_clocks_on()) {
+		return -EIO;
+	}
+	if (!ch_cci_init()) {
+		return -EIO;
+	}
+
+	/* Android's order (seq types 1, 10, 2, 11, 3, 0, 8) */
+	if (ch_bob(3300) != 0) {
+		return -EIO;
+	}
+	ch_gpio(ch.north, PIN_VANA, 0, 0, true, true);
+	ch_wait(2);
+	ch_gpio(ch.east, PIN_VANA2, 0, 0, true, true);
+	ch_wait(1);
+	if (ch_ldo("ldof1", 1104) != 0) {
+		ch_sensor_off();
+		return -EIO;
+	}
+	ch_wait(2);
+	(void)ch_pmic_gpio(true);
+	ch_wait(1);
+	if (ch_ldo("ldoc1", 1800) != 0) {
+		ch_sensor_off();
+		return -EIO;
+	}
+	ch_wait(5);
+	(void)ch_rcg_xo(CC_MCLK1_RCG, "mclk1");
+	(void)ch_branch(ch.camcc, CC_MCLK1, "mclk1");
+	ch_gpio(ch.north, PIN_MCLK, 0, 1, false, false);          /* function cam_mclk, 2 mA, no bias */
+	ch_wait(3);
+	ch_gpio(ch.east, PIN_RESET, 0, 0, true, true);
+	ch_wait(20);
+
+	uint8_t id[2] = { 0, 0 };
+	int e = ch_cci_read(IMX586_SID, IMX586_ID_REG, 2, id);
+	unsigned v = ((unsigned)id[0] << 8) | id[1];
+	if (e == 0) {
+		printf("SWEET CAMHW: IMX586 chip ID %#06x %s\n", v, v == IMX586_ID ? "(right)" : "(NOT 0x0586)");
+	} else {
+		printf("SWEET CAMHW: IMX586 chip ID read failed (%d)\n", e);
+	}
+	return e == 0 ? (int)v : -e;
+}
+
+/* the front camera's power (Android's 5 steps: VANA = bob + PM8150L GPIO 12, VDIG = ldof3 1.056 V, VIO = ldoc1,
+ * MCLK2, RESET) and its ID over CCI 1 master 0: the ID, or -errno (left powered on success). Not with the rear's. */
+static int pop_out(unsigned sid, unsigned n, bool high, uint8_t pull, uint8_t strength);
+
+static void
+ch_front_off(void)
+{
+	ch_gpio(ch.north, PIN_RESET_F, 0, 0, true, false);
+	ch_wait(1);
+	ch_gpio(ch.north, PIN_MCLK_F, 1, 0, false, false);
+	ch_branch_off(ch.camcc, CC_MCLK2);
+	(void)pop_out(PG_SID_PM8150L, 12, false, 0x05, 0x01);   /* VANA switch off */
+	const uint32_t off[1] = { 4 }, zero[1] = { 0 };
+	(void)sweet_rpmh_write("ldof3", 1, off, zero);
+	printf("SWEET CAMHW: front sensor reset held, MCLK2 off, VANA switch and VDIG off\n");
+}
+
+static int
+ch_front_power_up(void)
+{
+	if (!ch_map()) {
+		return -ENOMEM;
+	}
+	cc.base = ch.cci1;
+	cc.m = 0;
+	ch_gpio(ch.north, PIN_RESET_F, 0, 0, true, false);
+	ch_gpio(ch.north, PIN_SDA_F, 3, 1, false, false);
+	ch_gpio(ch.north, PIN_SCL_F, 3, 1, false, false);
+	if (!ch_clocks_on()) {
+		return -EIO;
+	}
+	(void)ch_rcg_xo(CC_CCI1_RCG, "cci_1");
+	if (!ch_branch(ch.camcc, CC_CCI1, "cci_1") || !ch_cci_init()) {
+		return -EIO;
+	}
+	if (ch_bob(3300) != 0 || sweet_spmi_init() != 0) {
+		return -EIO;
+	}
+	int e = pop_out(PG_SID_PM8150L, 12, true, 0x05, 0x01);  /* VANA switch */
+	printf("SWEET CAMHW: PM8150L GPIO12 (front VANA) high -> %d\n", e);
+	ch_wait(2);
+	if (ch_ldo("ldof3", 1056) != 0) {
+		ch_front_off();
+		return -EIO;
+	}
+	ch_wait(2);
+	if (ch_ldo("ldoc1", 1800) != 0) {
+		ch_front_off();
+		return -EIO;
+	}
+	ch_wait(5);
+	(void)ch_rcg_xo(CC_MCLK2_RCG, "mclk2");
+	(void)ch_branch(ch.camcc, CC_MCLK2, "mclk2");
+	ch_gpio(ch.north, PIN_MCLK_F, 0, 1, false, false);      /* cam_mclk */
+	ch_wait(3);
+	ch_gpio(ch.north, PIN_RESET_F, 0, 0, true, true);
+	ch_wait(20);
+	uint8_t id[2] = { 0, 0 };
+	e = ch_cci_read(IMX471_SID, IMX586_ID_REG, 2, id);
+	unsigned v = ((unsigned)id[0] << 8) | id[1];
+	printf("SWEET CAMHW: IMX471 chip ID %#06x -> %d %s\n", v, e, e == 0 && v == IMX471_ID ? "(right)" : "(NOT 0x0471)");
+	return e == 0 ? (int)v : -e;
+}
+
+static int
+ch_probe(int mode)
+{
+	if (mode == 5) {                /* the front sensor's ID only (it reads with the camera down) */
+		ch_front = true;
+		int v = ch_front_power_up();
+		ch_front_off();
+		ch_front = false;
+		return v;
+	}
+	int v = ch_power_up();
+	if (mode >= 2 && v == IMX586_ID) {
+		int se = ch_stream_test(mode == 3);
+		printf("SWEET CAMHW: stream test -> %d\n", se);
+		if (se) {
+			v = -se;
+		}
+	}
+	ch_sensor_off();
+	return v;
+}
+
+/* ---------------------------------------------------------------- the lens: LC898124EP3 (OIS + AF), step 4
+ *
+ * The main camera's lens is moved by its OIS controller, an ON Semi LC898124EP3 on the same CCI master as the
+ * IMX586 (7-bit 0x3e; DT qcom,ois@02: vio pm8150l_l1, vdig pm8009_l6 2.856 V, vaf pm8009_l5 2.8 V; qcom,actuator@7:
+ * VAF bob + TLMM 25 CAM_VAF_0). Its program is RAM, downloaded at every power-up as OnePlus's GPL cam_ois_core.c
+ * does (DownloadToEP3; the program from tools/lc898124-fw.py, handed in by ISP.mediacapture as
+ * HAKIOS_CAMERA_LENS_FIRMWARE); then the writes Android's trace shows (gyro/accel coefficients, 0x8970, 0xf111,
+ * 0xf000, servo on 0xf010 = 3, OIS on 0xf012 = 1, still mode 0xf013 = 1). Focus: CMD_AF_POSITION 0xf01a = position
+ * | 0x10000 (HighLevelCmd.c SetTregAf), position = af_offset + focus * af_span / 1024 (sysctls, default 0 and 1024:
+ * the 10-bit uni-directional range).
+ */
+#define LENS_SID        0x3eu
+#define PIN_VAF         25u             /* east tile */
+#define LENS_FW_MAX     16384u
+
+static struct {
+	bool powered, ok;
+	uint32_t focus;                 /* 0..1023 as last set */
+	uint32_t offset, span;
+	unsigned fw_len;
+	uint8_t fw[LENS_FW_MAX];
+} cl = { .span = 1024 };
+
+static int
+ch_lens_rd(uint32_t addr, uint32_t *v)
+{
+	uint8_t b[4] = { 0, 0, 0, 0 };
+	ch_cci_quiet = true;
+	int e = ch_cci_read(LENS_SID, addr, 4, b);
+	ch_cci_quiet = false;
+	*v = ((uint32_t)b[0] << 24) | ((uint32_t)b[1] << 16) | ((uint32_t)b[2] << 8) | b[3];
+	return e;
+}
+
+static int
+ch_lens_wr(uint32_t addr, uint32_t v)
+{
+	uint8_t b[6] = { (uint8_t)(addr >> 8), (uint8_t)addr, (uint8_t)(v >> 24), (uint8_t)(v >> 16), (uint8_t)(v >> 8),
+		         (uint8_t)v };
+	return ch_cci_burst(LENS_SID, b, 6);
+}
+
+/* CMD_READ_STATUS 0xf100: busy while READ_STATUS_INI (bit 24) */
+static bool
+ch_lens_idle(unsigned ms)
+{
+	uint32_t v = 0;
+	for (unsigned i = 0; i <= ms; ++i) {
+		if (ch_lens_rd(0xf100, &v) == 0 && !(v & 0x01000000u)) {
+			return true;
+		}
+		ch_wait(1);
+	}
+	printf("SWEET CAMHW: lens: still busy after %u ms (status %#x)\n", ms, v);
+	return false;
+}
+
+/* ch.lock held: power and check it answers (ROM code version, CMD_ROMVER 0xf00f) */
+static void
+ch_lens_power(bool on)
+{
+	if (on) {
+		(void)ch_ldo("ldof6", 2856);    /* vdig */
+		(void)ch_ldo("ldof5", 2800);    /* vaf */
+		ch_gpio(ch.east, PIN_VAF, 0, 0, true, true);
+		ch_wait(20);
+		uint32_t rom = 0;
+		int e = ch_lens_rd(0xf00f, &rom);
+		cl.powered = e == 0;
+		printf("SWEET CAMHW: lens controller (LC898124EP3, 0x3e): ROM version %#x -> %d%s\n", rom, e,
+		    e ? " (NOT answering)" : "");
+	} else {
+		if (cl.ok) {
+			(void)ch_lens_wr(0xf012, 0);    /* OIS off */
+			(void)ch_lens_wr(0xf010, 0);    /* servo off */
+			ch_wait(5);
+		}
+		ch_gpio(ch.east, PIN_VAF, 0, 0, true, false);
+		const uint32_t off[1] = { 4 }, zero[1] = { 0 };
+		(void)sweet_rpmh_write("ldof5", 1, off, zero);
+		(void)sweet_rpmh_write("ldof6", 1, off, zero);
+		cl.powered = cl.ok = false;
+	}
+}
+
+/* ch.lock held: the position, 0..1023 */
+static int
+ch_lens_focus(uint32_t focus)
+{
+	if (!cl.ok) {
+		return ENODEV;
+	}
+	focus = focus > 1023u ? 1023u : focus;
+	uint32_t pos = cl.offset + focus * cl.span / 1024u;
+	pos = pos > 0x7ffu ? 0x7ffu : pos;
+	int e = ch_lens_wr(0xf01a, pos | 0x10000u);       /* bit 16: FST mode */
+	if (e == 0) {
+		cl.focus = focus;
+	}
+	return e;
+}
+
+/* ch.lock held: DownloadToEP3 + Android's start (cam_ois_fw_download and the trace) from cl.fw */
+static int
+ch_lens_start(void)
+{
+	const uint8_t *f = cl.fw;
+	uint32_t hdr[4], v = 0;
+	if (!cl.powered) {
+		return ENODEV;
+	}
+	if (cl.fw_len < 24 || memcmp(f, "LC124FW1", 8) != 0) {
+		printf("SWEET CAMHW: lens: not a program (tools/lc898124-fw.py makes it)\n");
+		return EINVAL;
+	}
+	memcpy(hdr, f + 8, sizeof(hdr));
+	uint32_t pm_words = hdr[0], dma = hdr[1], dmb = hdr[2], parity = hdr[3];
+	uint32_t pm_bytes = pm_words * 5u, dma_bytes = dma * 6u / 4u, dmb_bytes = dmb * 6u / 4u;
+	if (24u + pm_bytes + dma_bytes + dmb_bytes > cl.fw_len) {
+		printf("SWEET CAMHW: lens: program short (%u bytes)\n", cl.fw_len);
+		return EINVAL;
+	}
+	const uint8_t *pm = f + 24, *dm = pm + pm_bytes;
+	uint64_t t0 = mach_absolute_time(), ns;
+
+	/* 0. the boot program: ROM (0x0a) runs as it is, RAM (0x01) is reset first */
+	int e = ch_lens_rd(0xf00f, &v);
+	if (e || v == 0x20161121u) {
+		printf("SWEET CAMHW: lens: ROM version %#x (%d): old or not answering\n", v, e);
+		return EIO;
+	}
+	(void)ch_lens_wr(0xc000, 0x00e0500cu);           /* CMD_IO_ADR_ACCESS = ROMINFO */
+	(void)ch_lens_rd(0xd000, &v);                    /* CMD_IO_DAT_ACCESS */
+	if ((v & 0xffu) == 0x01) {
+		static const uint8_t remap[10] = { 0xc0, 0x00, 0x00, 0xd0, 0x00, 0xac, 0x00, 0x00, 0x10, 0x00 };
+		(void)ch_cci_burst(LENS_SID, remap, 10);    /* SYSDSP_REMAP = 0x1000: CORE_RST */
+		ch_wait(6);
+	} else if ((v & 0xffu) != 0x0a) {
+		printf("SWEET CAMHW: lens: ROMINFO %#x: not runnable\n", v);
+		return EIO;
+	}
+	/* 1. the program: PM address 0x00100000, then 0x40 + 12 words a write, then the checksum command */
+	static const uint8_t pm_at[5] = { 0x30, 0x00, 0x10, 0x00, 0x00 };
+	e = ch_cci_burst(LENS_SID, pm_at, 5);
+	uint8_t b[61];
+	for (uint32_t o = 0; e == 0 && o < pm_bytes; o += 60u) {
+		uint32_t k = pm_bytes - o < 60u ? pm_bytes - o : 60u;
+		b[0] = 0x40;
+		memcpy(b + 1, pm + o, k);
+		e = ch_cci_burst(LENS_SID, b, k + 1u);
+	}
+	if (e == 0) {
+		uint8_t sum[4] = { 0xf0, 0x0a, (uint8_t)(pm_words >> 8), (uint8_t)pm_words };
+		e = ch_cci_burst(LENS_SID, sum, 4);
+	}
+	/* 2. the tables: DMA then DMB, 60 bytes (10 records) a write, as they are */
+	if (e == 0) {
+		(void)ch_lens_wr(0x0100, 0);             /* DMA parity clear */
+		(void)ch_lens_wr(0x0104, 0);             /* DMB parity clear */
+	}
+	for (uint32_t o = 0; e == 0 && o < dma_bytes + dmb_bytes; ) {
+		uint32_t end = o < dma_bytes ? dma_bytes : dma_bytes + dmb_bytes;
+		uint32_t k = end - o < 60u ? end - o : 60u;
+		e = ch_cci_burst(LENS_SID, dm + o, k);
+		o += k;
+	}
+	/* 3. verify */
+	uint32_t vpm = 0, vdma = 0, vdmb = 0;
+	if (e == 0) {
+		(void)ch_lens_rd(0x0110, &vpm);
+		(void)ch_lens_rd(0x0100, &vdma);
+		(void)ch_lens_rd(0x0104, &vdmb);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("SWEET CAMHW: lens program: %u PM words, DM %u + %u bytes in %llu ms -> %d; sums PM %#x DMA %#x DMB %#x "
+	    "(%#x, want %#x)\n", pm_words, dma_bytes, dmb_bytes, ns / 1000000ull, e, vpm, vdma, vdmb, vpm + vdma + vdmb, parity);
+	if (e || vpm + vdma + vdmb != parity) {
+		return EIO;
+	}
+	/* Android's after the download: SetGyroAccelCoef for SO2820 (as the trace writes it), 0xf000, 0x8970, 0xf111 */
+	static const uint32_t coef[10][2] = {
+		{ 0x86a4, 0 }, { 0x86a8, 0x7fffffff }, { 0x86ac, 0 }, { 0x86b0, 0x7fffffff }, { 0x86c8, 0x7fffffff },
+		{ 0x86b4, 0 }, { 0x86b8, 0x7fffffff }, { 0x867c, 0 }, { 0x8680, 0x7fffffff }, { 0x8684, 0x7fffffff },
+	};
+	for (unsigned i = 0; i < 10; ++i) {
+		(void)ch_lens_wr(coef[i][0], coef[i][1]);
+	}
+	(void)ch_lens_wr(0xf000, 0);
+	(void)ch_lens_wr(0x8970, 1);
+	(void)ch_lens_wr(0xf111, 1);
+	/* then its OIS start (the trace): 0xf000, wait idle, servo on, OIS on, still mode */
+	(void)ch_lens_wr(0xf000, 0);
+	(void)ch_lens_idle(200);
+	e = ch_lens_wr(0xf010, 3);
+	(void)ch_lens_idle(100);
+	(void)ch_lens_wr(0xf012, 1);
+	(void)ch_lens_idle(100);
+	(void)ch_lens_wr(0xf013, 1);
+	(void)ch_lens_idle(100);
+	cl.ok = e == 0;
+	if (cl.ok) {
+		(void)ch_lens_focus(300);
+	}
+	uint32_t af = 0;
+	(void)ch_lens_rd(0xf01a, &af);
+	printf("SWEET CAMHW: lens: servo and OIS on -> %d; focus %u (0xf01a reads %#x)\n", e, cl.focus, af);
+	return cl.ok ? 0 : EIO;
+}
+
+/* ---------------------------------------------------------------- /dev/hakios-camera: the frames, for ISP.mediacapture
+ *
+ * As userland/camera/hakios.camera.h says (HakiOS's device, here the copy sweet_hakios_camera.h): the first open
+ * powers the IMX586 up and starts it (Android's 4000x3000 mode, as in step 2b), the last close stops it and powers it
+ * down. Frames go round NBUF buffers behind the SMMU: a thread polls the IFE every 3 ms (nothing takes the camera's
+ * interrupts) -- at each RDI0 reg update done (the SOF that latched the address given) the next free buffer is given
+ * to WM0 for the frame after; at each WM0 buffer done the oldest latched buffer is the newest frame. A read waits
+ * (at most a second) for a frame newer than the last read and copies the header and the RAW10 lines (pitch 5008). A
+ * write takes HAKIOS_CAMERA_EXPOSURE (lines, gain with 256 for 1x, frame lines), written to the sensor under group
+ * hold; HAKIOS_CAMERA_SENSOR other than 1 (the wide) is ENODEV (ISP.mediacapture then makes up that camera's frames);
+ * KEEP and FOCUS are taken and ignored (no lens motor yet).
+ */
+#define CS_BLACK       64u
+#define CS_GAIN_UNITY  256u
+#define CS_GAIN_MAX    (CS_GAIN_UNITY * 16u)  /* analog gain code 960 */
+#define CS_MARGIN      48u
+
+/* the two cameras' modes: the frames as the WM writes them (lines padded to 16 bytes), the shortest frame (30 a
+ * second), a line's time until measured (1/30 s over it), and Android's last exposure as the start */
+static const struct cs_mode {
+	uint32_t sensor, sid, width, height, pitch, fl_min, line_ns, lines, gain, fl;
+	const char *name;
+} cs_modes[3] = {
+	[1] = { 1, IMX586_SID, 4000, 3000, 5008, 3695, 9021, 6672, CS_GAIN_MAX, 6720, "rear IMX586" },
+	[2] = { 2, IMX471_SID, 2328, 1748, 2912, 2685, 12415, 4040, CS_GAIN_UNITY * 1024u / (1024u - 0x391u), 4058,
+	        "front IMX471" },
+};
+#define CS_FL_MIN      (cs.md->fl_min)
+#define CS_FL_MAX      (cs.md->fl_min * 4u)
+
+static struct {
+	lck_mtx_t *mtx;
+	bool on, stop, polling, fault;
+	int queue[2];                   /* buffers latched by the WM (being written), oldest first */
+	unsigned queued;
+	int pending;                    /* given to the WM, waiting for the next SOF */
+	int ready, reading;
+	uint64_t seq, ready_seq, read_seq, ready_time, last_done;
+	uint32_t lines, gain, frame_lines, line_ns, bayer, bayer_front;
+	unsigned frames, drops, opens;
+	uint32_t want;                  /* the camera the next start is for (HAKIOS_CAMERA_SENSOR): 1 rear, 2 front */
+	const struct cs_mode *md;       /* the one streaming */
+} cs = { .bayer = 3, .bayer_front = 0, .want = 1, .md = &cs_modes[1] };  /* rear BGGR: blue Gatorade came out orange with RGGB */
+
+/* IMX586 analog gain: 1024 / (1024 - code), code 0..960 */
+static uint32_t
+cs_gain_code(uint32_t gain)
+{
+	if (gain <= CS_GAIN_UNITY) {
+		return 0;
+	}
+	uint32_t code = 1024u - (1024u * CS_GAIN_UNITY + gain / 2u) / gain;
+	return code > 960u ? 960u : code;
+}
+
+/* ch.lock held */
+static int
+cs_exposure(uint32_t lines, uint32_t gain, uint32_t fl)
+{
+	if (lines < 1) {
+		lines = 1;
+	}
+	if (fl == 0) {
+		fl = lines + CS_MARGIN > CS_FL_MIN ? lines + CS_MARGIN : CS_FL_MIN;
+	}
+	fl = fl < CS_FL_MIN ? CS_FL_MIN : fl > CS_FL_MAX ? CS_FL_MAX : fl;
+	lines = lines > fl - CS_MARGIN ? fl - CS_MARGIN : lines;
+	uint32_t code = cs_gain_code(gain);
+	uint16_t w[8][2] = {
+		{ 0x0104, 1 },
+		{ 0x0340, (uint16_t)(fl >> 8) }, { 0x0341, (uint16_t)(fl & 0xffu) },
+		{ 0x0202, (uint16_t)(lines >> 8) }, { 0x0203, (uint16_t)(lines & 0xffu) },
+		{ 0x0204, (uint16_t)(code >> 8) }, { 0x0205, (uint16_t)(code & 0xffu) },
+		{ 0x0104, 0 },
+	};
+	int e = ch_cci_write(cs.md->sid, w, 8);
+	if (e == 0) {
+		lck_mtx_lock(cs.mtx);
+		cs.lines = lines;
+		cs.gain = CS_GAIN_UNITY * 1024u / (1024u - code);
+		cs.frame_lines = fl;
+		lck_mtx_unlock(cs.mtx);
+	}
+	return e;
+}
+
+/* cs.mtx held */
+static int
+cs_free(void)
+{
+	for (int b = 0; b < (int)NBUF; ++b) {
+		bool busy = b == cs.ready || b == cs.reading || b == cs.pending;
+		for (unsigned q = 0; q < cs.queued; ++q) {
+			busy |= b == cs.queue[q];
+		}
+		if (!busy) {
+			return b;
+		}
+	}
+	return -1;
+}
+
+/* cs.mtx held: the next free buffer to WM0, latched at the next SOF */
+static void
+cs_give(void)
+{
+	if (cs.pending >= 0) {
+		return;
+	}
+	int b = cs_free();
+	if (b >= 0) {
+		ch_wr(ch.ife, WM0_IMAGE_ADDR, FRAME_IOVA + (uint32_t)b * FRAME_ALLOC);
+		ch_wr(ch.ife, IFE_REG_UPDATE, 0x2);
+		cs.pending = b;
+	}
+}
+
+static void
+cs_poll(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	vm_offset_t f = ch.ife;
+	uint64_t log_at = mach_absolute_time(), ns;
+	uint32_t errs1 = 0, errs2 = 0, bus0 = 0;
+	unsigned regs = 0, dones = 0;
+	while (!cs.stop) {
+		ch_wait(3);
+		uint32_t t0 = ch_rd(f, IFE_IRQ_ST0), t1 = ch_rd(f, IFE_IRQ_ST1);
+		uint32_t b0 = ch_rd(f, BUS_IRQ_ST0), b1 = ch_rd(f, BUS_IRQ_ST1), b2 = ch_rd(f, BUS_IRQ_ST2);
+		if (t0 | t1) {
+			ch_wr(f, IFE_IRQ_CLR0, t0);
+			ch_wr(f, IFE_IRQ_CLR1, t1);
+			ch_wr(f, IFE_IRQ_GLOBAL_CLR, 1);
+		}
+		if (b0 | b1 | b2) {
+			ch_wr(f, BUS_IRQ_CLR0, b0);
+			ch_wr(f, BUS_IRQ_CLR1, b1);
+			ch_wr(f, BUS_IRQ_CLR2, b2);
+			ch_wr(f, BUS_IRQ_GLOBAL_CLR, 1);
+		}
+		errs1 |= t1;
+		errs2 |= b2;
+		bus0 |= b0;
+		uint32_t fsr = chs.cb >= 0 ? ch_rd(ch_cbp(chs.cb), 0x58) & ~0x600u : 0;
+		uint64_t now = mach_absolute_time();
+		lck_mtx_lock(cs.mtx);
+		if ((b1 & 1u) && cs.queued) {   /* WM0 buffer done: the oldest latched buffer is the newest frame */
+			int b = cs.queue[0];
+			cs.queue[0] = cs.queue[1];
+			cs.queued--;
+			if (cs.last_done) {
+				absolutetime_to_nanoseconds(now - cs.last_done, &ns);
+				uint64_t want = (uint64_t)cs.frame_lines * cs.line_ns;
+				if (ns > want / 2u && ns < want * 3u / 2u) {
+					uint32_t l = (uint32_t)(ns / cs.frame_lines);
+					cs.line_ns = l < 5000u ? 5000u : l > 20000u ? 20000u : l;
+				}
+			}
+			cs.last_done = now;
+			cs.ready = b;
+			cs.ready_seq = ++cs.seq;
+			cs.ready_time = now;
+			cs.frames++;
+			dones++;
+			wakeup(&cs.ready_seq);
+		}
+		if (t0 & 0x20u) {               /* RDI0 reg update done: the pending buffer is latched */
+			regs++;
+			if (cs.pending >= 0) {
+				if (cs.queued == 2) {
+					cs.queue[0] = cs.queue[1];
+					cs.queued = 1;
+					cs.drops++;
+				}
+				cs.queue[cs.queued++] = cs.pending;
+				cs.pending = -1;
+			}
+		}
+		cs_give();
+		if (fsr && !cs.fault) {
+			cs.fault = true;
+			wakeup(&cs.ready_seq);
+			printf("SWEET CAMHW: SMMU FAULT while streaming: FSR %#x FAR %#x%08x FSYNR0 %#x -- no more frames\n", fsr,
+			    ch_rd(ch_cbp(chs.cb), 0x64), ch_rd(ch_cbp(chs.cb), 0x60), ch_rd(ch_cbp(chs.cb), 0x68));
+		}
+		lck_mtx_unlock(cs.mtx);
+		absolutetime_to_nanoseconds(now - log_at, &ns);
+		if (ns >= 10ull * NSEC_PER_SEC) {
+			printf("SWEET CAMHW: streaming: %u frames (%u done, %u reg updates in 10 s), %u dropped; line %u ns, "
+			    "frame %u lines, exposure %u lines, gain %u/256; IFE errors %#x, bus %#x/%#x\n", cs.frames, dones, regs,
+			    cs.drops, cs.line_ns, cs.frame_lines, cs.lines, cs.gain, errs1, bus0, errs2);
+			log_at = now;
+			errs1 = errs2 = bus0 = 0;
+			regs = dones = 0;
+		}
+	}
+	lck_mtx_lock(cs.mtx);
+	cs.polling = false;
+	wakeup(&cs.polling);
+	lck_mtx_unlock(cs.mtx);
+}
+
+/* ch.lock held */
+static void
+cs_stop(void)
+{
+	if (!cs.on) {
+		return;
+	}
+	lck_mtx_lock(cs.mtx);
+	cs.on = false;
+	cs.stop = true;
+	wakeup(&cs.ready_seq);
+	while (cs.polling) {
+		struct timespec ts = { 0, 100 * 1000 * 1000 };
+		(void)msleep(&cs.polling, cs.mtx, PRIBIO, "hakcam-stop", &ts);
+	}
+	lck_mtx_unlock(cs.mtx);
+	static const uint16_t stop[1][2] = { { 0x0100, 0x00 } };
+	(void)ch_cci_write(cs.md->sid, stop, 1);
+	ch_wr(ch.ife, WM0_CFG, 0);
+	ch_wr(ch.ife, IFE_REG_UPDATE, 0x2);
+	ch_wr(ch.csid, CSID_RDI0_CTRL, 2);
+	ch_wr(ch.csid, CSID_RDI0_CFG0, ch_rd(ch.csid, CSID_RDI0_CFG0) & ~(1u << 31));
+	ch_wait(40);
+	if (cs.md->sensor == 2) {
+		ch_front_off();
+		if (pop_pos == 1) {
+			(void)pop_command(2);   /* the camera back down */
+		}
+	} else {
+		ch_lens_power(false);
+		ch_sensor_off();
+	}
+	ch_front = false;
+	printf("SWEET CAMHW: /dev/hakios-camera: the %s stopped: %u frames, %u dropped\n", cs.md->name, cs.frames, cs.drops);
+}
+
+/* ch.lock held */
+static int
+cs_start(uint32_t which)
+{
+	const struct cs_mode *md = &cs_modes[which == 2 ? 2 : 1];
+	ch_front = md->sensor == 2;
+	if (ch_front) {
+		if (pop_pos == 0) {
+			int pe = pop_command(1);        /* the camera up first */
+			printf("SWEET CAMHW: front camera up -> %d\n", pe);
+		}
+		int v = ch_front_power_up();
+		if (v != IMX471_ID || !ch_rx_setup() || !ch_capture_prepare()) {
+			ch_front_off();
+			if (pop_pos == 1) {
+				(void)pop_command(2);
+			}
+			ch_front = false;
+			return EIO;
+		}
+	} else {
+		int v = ch_power_up();
+		if (v != IMX586_ID) {
+			ch_sensor_off();
+			return EIO;
+		}
+		ch_lens_power(true);
+		if (!ch_rx_setup() || !ch_capture_prepare()) {
+			ch_lens_power(false);
+			ch_sensor_off();
+			return EIO;
+		}
+		if (cl.fw_len && !cl.ok) {
+			(void)ch_lens_start();  /* the program ISP.mediacapture handed in before */
+		}
+	}
+	cs.md = md;
+	vm_offset_t f = ch.ife;
+	lck_mtx_lock(cs.mtx);
+	cs.queued = 0;
+	cs.pending = cs.ready = cs.reading = -1;
+	cs.seq = cs.ready_seq = cs.read_seq = cs.last_done = 0;
+	cs.fault = cs.stop = false;
+	cs.frames = cs.drops = 0;
+	cs.lines = md->lines;
+	cs.gain = md->gain;
+	cs.frame_lines = md->fl;
+	cs.line_ns = md->line_ns;
+	ch_wr(f, IFE_IRQ_CLR0, 0xffffffffu);
+	ch_wr(f, IFE_IRQ_CLR1, 0xffffffffu);
+	ch_wr(f, IFE_IRQ_GLOBAL_CLR, 1);
+	ch_wr(f, BUS_IRQ_CLR0, 0xffffffffu);
+	ch_wr(f, BUS_IRQ_CLR1, 0xffffffffu);
+	ch_wr(f, BUS_IRQ_CLR2, 0xffffffffu);
+	ch_wr(f, BUS_IRQ_GLOBAL_CLR, 1);
+	ch_wr(f, WM0_CFG, 3);           /* enable, frame based; buffer 0 latched at the first SOF */
+	cs_give();
+	cs.polling = true;
+	cs.on = true;
+	lck_mtx_unlock(cs.mtx);
+	thread_t t;
+	if (kernel_thread_start(cs_poll, NULL, &t) != KERN_SUCCESS) {
+		lck_mtx_lock(cs.mtx);
+		cs.polling = false;
+		lck_mtx_unlock(cs.mtx);
+		cs_stop();
+		return ENOMEM;
+	}
+	thread_deallocate(t);
+	int e = ch_sensor_start();
+	if (e == 0) {
+		e = cs_exposure(CS_FL_MIN - CS_MARGIN, CS_GAIN_UNITY * 2u, 0);      /* a start for ISP.mediacapture's AE */
+	}
+	if (e) {
+		cs_stop();
+		return EIO;
+	}
+	printf("SWEET CAMHW: /dev/hakios-camera streaming the %s (%ux%u RAW10, %u buffers)\n", md->name, md->width,
+	    md->height, NBUF);
+	return 0;
+}
+
+/* cs.mtx held */
+static void
+cs_header(struct hakios_camera_frame *h, const struct cs_mode *md)
+{
+	memset(h, 0, sizeof(*h));
+	memcpy(h->magic, HAKIOS_CAMERA_MAGIC, sizeof(h->magic));
+	h->header_bytes = sizeof(*h);
+	h->width = md->width;
+	h->height = md->height;
+	h->stride = md->pitch;
+	h->format = 1;
+	h->bayer = md->sensor == 2 ? cs.bayer_front : cs.bayer;
+	h->black = CS_BLACK;
+	h->sequence = cs.ready_seq;
+	h->time = cs.ready_time;
+	h->exposure_lines = cs.lines;
+	h->line_ns = cs.line_ns;
+	h->gain = cs.gain;
+	h->gain_unity = CS_GAIN_UNITY;
+	h->gain_max = CS_GAIN_MAX;
+	h->frame_lines = cs.frame_lines;
+	h->frame_lines_min = md->fl_min;
+	h->frame_lines_max = md->fl_min * 4u;
+	h->margin = CS_MARGIN;
+	h->sensor = md->sensor;
+	h->focus = md->sensor == 1 && cl.ok ? cl.focus : HAKIOS_CAMERA_NO_FOCUS;
+}
+
+static int
+cs_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct hakios_camera_frame h;
+	user_ssize_t want = uio_resid(uio);
+	if (want < (user_ssize_t)sizeof(h)) {
+		return EINVAL;
+	}
+	if (!cs.on) {
+		if (want == (user_ssize_t)sizeof(h)) {   /* the size of the frames to come, nothing started */
+			lck_mtx_lock(cs.mtx);
+			cs_header(&h, &cs_modes[cs.want == 2 ? 2 : 1]);
+			lck_mtx_unlock(cs.mtx);
+			return uiomove((caddr_t)&h, (int)sizeof(h), uio);
+		}
+		lck_mtx_lock(ch.lock);       /* the first read starts the camera asked for */
+		int se = cs.on ? 0 : cs_start(cs.want);
+		lck_mtx_unlock(ch.lock);
+		if (se) {
+			return EIO;
+		}
+	}
+	lck_mtx_lock(cs.mtx);
+	if (!cs.on || cs.fault) {
+		lck_mtx_unlock(cs.mtx);
+		return EIO;
+	}
+	if (want == (user_ssize_t)sizeof(h)) {   /* the frame's size, nothing more */
+		cs_header(&h, cs.md);
+		lck_mtx_unlock(cs.mtx);
+		return uiomove((caddr_t)&h, (int)sizeof(h), uio);
+	}
+	while (cs.on && !cs.fault && (cs.ready < 0 || cs.ready_seq <= cs.read_seq)) {
+		struct timespec ts = { 1, 0 };
+		int e = msleep(&cs.ready_seq, cs.mtx, PRIBIO | PCATCH, "hakcam", &ts);
+		if (e) {
+			lck_mtx_unlock(cs.mtx);
+			return e == EWOULDBLOCK ? EAGAIN : e;
+		}
+	}
+	if (!cs.on || cs.fault) {
+		lck_mtx_unlock(cs.mtx);
+		return EIO;
+	}
+	int b = cs.ready;
+	cs.reading = b;
+	cs.read_seq = cs.ready_seq;
+	cs_header(&h, cs.md);
+	user_ssize_t bytes = (user_ssize_t)cs.md->pitch * cs.md->height;
+	lck_mtx_unlock(cs.mtx);
+	flush_dcache64((addr64_t)ch.buf[b], (unsigned)bytes, FALSE);  /* the WM wrote it behind the cache */
+	int e = uiomove((caddr_t)&h, (int)sizeof(h), uio);
+	if (e == 0) {
+		user_ssize_t n = uio_resid(uio);
+		e = uiomove((caddr_t)ch.buf[b], (int)(n < bytes ? n : bytes), uio);
+	}
+	lck_mtx_lock(cs.mtx);
+	cs.reading = -1;
+	lck_mtx_unlock(cs.mtx);
+	return e;
+}
+
+static int
+cs_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct hakios_camera_command c;
+	if (uio_resid(uio) < (user_ssize_t)sizeof(c)) {
+		return EINVAL;
+	}
+	int e = uiomove((caddr_t)&c, (int)sizeof(c), uio);
+	if (e) {
+		return e;
+	}
+	if (c.command == HAKIOS_CAMERA_LENS_FIRMWARE) {
+		user_ssize_t n = uio_resid(uio);
+		if (n <= 0 || n > (user_ssize_t)LENS_FW_MAX) {
+			return EINVAL;
+		}
+		lck_mtx_lock(ch.lock);
+		e = uiomove((caddr_t)cl.fw, (int)n, uio);
+		cl.fw_len = e ? 0 : (unsigned)n;
+		if (e == 0 && cs.on && cs.md->sensor == 1 && !cl.ok) {
+			e = ch_lens_start();    /* (otherwise kept: the rear camera's start downloads it) */
+		}
+		lck_mtx_unlock(ch.lock);
+		return e;
+	}
+	uio_update(uio, (user_size_t)uio_resid(uio));        /* what follows (KEEP's picture): not wanted */
+	switch (c.command) {
+	case HAKIOS_CAMERA_EXPOSURE:
+		lck_mtx_lock(ch.lock);
+		e = cs.on ? cs_exposure(c.a, c.b, c.c) : EIO;
+		lck_mtx_unlock(ch.lock);
+		return e;
+	case HAKIOS_CAMERA_SENSOR:     /* the frames stop; the next read starts that one */
+		if (c.a != 1 && c.a != 2) {
+			return ENODEV;
+		}
+		lck_mtx_lock(ch.lock);
+		if (cs.on && cs.md->sensor != c.a) {
+			cs_stop();
+		}
+		cs.want = c.a;
+		lck_mtx_unlock(ch.lock);
+		return 0;
+	case HAKIOS_CAMERA_FOCUS:
+		lck_mtx_lock(ch.lock);
+		e = cs.on && cs.md->sensor == 1 ? ch_lens_focus(c.a) : ENODEV;
+		lck_mtx_unlock(ch.lock);
+		return e;
+	default:
+		return 0;
+	}
+}
+
+static int
+cs_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	lck_mtx_lock(ch.lock);
+	if (cs.opens++ == 0 && !cs.on) {
+		cs.want = 1;            /* the rear, unless HAKIOS_CAMERA_SENSOR says otherwise before the first read */
+	}
+	lck_mtx_unlock(ch.lock);
+	return 0;
+}
+
+/* the last close only (no D_TRACKCLOSE) */
+static int
+cs_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	lck_mtx_lock(ch.lock);
+	cs_stop();
+	cs.opens = 0;
+	cs.want = 1;
+	lck_mtx_unlock(ch.lock);
+	return 0;
+}
+
+static const struct cdevsw cs_cdevsw = {
+	.d_open = cs_open, .d_close = cs_close, .d_read = cs_read, .d_write = cs_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static void
+ch_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	int major = cdevsw_add(-1, &cs_cdevsw);
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-camera") == NULL) {
+		printf("SWEET CAMHW: /dev/hakios-camera cannot be made\n");
+	} else {
+		printf("SWEET CAMHW: /dev/hakios-camera: the rear main camera (IMX586) for ISP.mediacapture\n");
+	}
+	uint32_t mode = 0;
+	(void)PE_parse_boot_argn("sweetcamhw", &mode, sizeof(mode));
+	if (mode == 0) {
+		return;
+	}
+	unsigned delay_s = 40;
+	(void)PE_parse_boot_argn("sweetcamhwdelay", &delay_s, sizeof(delay_s));
+	ch_wait(delay_s * 1000u);
+	lck_mtx_lock(ch.lock);
+	ch.last = ch_probe(1);
+	lck_mtx_unlock(ch.lock);
+}
+
+static int
+sysctl_sweet_camhw SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = ch.last;
+	int err = sysctl_handle_int(oidp, &value, 0, req);
+	if (err || !req->newptr) {
+		return err;
