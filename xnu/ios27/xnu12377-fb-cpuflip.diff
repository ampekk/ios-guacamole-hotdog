+/*
+ * 2026-11-17 (dashes back with the scheduler change): the CPU fallback (frames the GPU present cannot take: video
+ * layers, a translucent top layer, more than two layers) flipped back to buffer 0 and then wrote the frame into the
+ * buffer being scanned out: the original dash bug, now frequent. Instead it composes the whole frame into the buffer
+ * the pipes do not read and flips to it, like the GPU present. Returns that buffer's index and CPU address once
+ * every earlier flip has been taken (up to 20 ms), else false (the caller falls back to the old way).
+ */
+static bool
+fbflip_cpu_back(unsigned *b, uintptr_t *dst)
+{
+	if (!sweet_fbflip.ok || sweet_fbflip.cpu[0] == 0 || sweet_fbflip.cpu[1] == 0 || !fbflip_wait(20)) {
+		return false;
+	}
+	*b = sweet_fbflip.front ^ 1u;
+	*dst = sweet_fbflip.cpu[*b];
+	return true;
+}
