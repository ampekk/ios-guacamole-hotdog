+/*
+ * iOS 27.2 (2026-11-14 log): a backboardd job hung; the reset itself went through (GBIF acks 1 1 1, RBBM_STATUS 1,
+ * rptr 0) but CP_ME_INIT never ran: shadow still 0xdeadbeef, CP_INT 0x80 (a6xx CP_INT bit 7: illegal instruction).
+ * be_ring_run gives up at the first nonzero CP_INT read, so a status left over from the reset also ends the try.
+ * Now: the SQE image in gpumem is compared with /sweet-gpu sqe-firmware and restored if it differs, the CP state
+ * after the reset is logged, the ring wait only looks at the shadow, and a failed try is repeated once with the GPU
+ * taken out of secure mode by register (RBBM_SECVID_TRUST_CNTL = 0, msm's path when there is no zap shader).
+ */
+static unsigned
+sweet_gpu_sqe_restore(void)
+{
+	DTEntry node;
+	const void *prop;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/sweet-gpu", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "sqe-firmware", &prop, &size) != kSuccess ||
+	    size < 8 || size - 4u > 0x10000u) {
+		return 0;
+	}
+	const uint32_t *src = (const uint32_t *)prop + 1;
+	uint32_t *img = (uint32_t *)(gpumem + GPUMEM_SQE);
+	unsigned words = (size - 4u) / 4u, bad = 0;
+	for (unsigned i = 0; i < words; ++i) {
+		bad += img[i] != src[i];
+	}
+	if (bad != 0) {
+		memcpy(img, src, size - 4u);
+		flush_dcache64((addr64_t)(gpumem + GPUMEM_SQE), size - 4u, FALSE);
+	}
+	return bad;
+}
+
+static bool
+be_ring_run_shadow(unsigned w, unsigned ms_max)
+{
+	for (unsigned ms = 0; ms < ms_max; ++ms) {
+		flush_dcache64((addr64_t)(gpumem + GPUMEM_SHADOW), 0x1000u, FALSE);
+		if (*(volatile uint32_t *)(gpumem + GPUMEM_SHADOW) == w) {
+			return true;
+		}
+		delay(1000);
+	}
+	return false;
+}
