+/* ---------------- accept-all stand-ins: AppleIPAppender (ApplePDPHelper), AppleBasebandPCITrace ---------------- */
+
+class AppleBasebandPCITrace : public IOService
+{
+	OSDeclareDefaultStructors(AppleBasebandPCITrace);
+};
+OSDefineMetaClassAndStructors(AppleBasebandPCITrace, IOService);
+
+/* libPCITransport's PDPListener matches this (data path, later P4); only its interest notifications are used. */
+class AppleBasebandPCIPDPManagerBase : public IOService
+{
+	OSDeclareDefaultStructors(AppleBasebandPCIPDPManagerBase);
+};
+OSDefineMetaClassAndStructors(AppleBasebandPCIPDPManagerBase, IOService);
+
+/* Every selector succeeds with zeroed outputs; async requests are accepted and never completed. */
+static uint32_t abs_calls[3][0x20];
+
+/*
+ * cell2: ApplePPM (peak power manager). CPMS.framework 27.2 looks it up (IOServiceMatching("ApplePPM")) and reads
+ * its CPMSSupported / CPMSThermalOnlyDevice numbers; without it "Could not find PPM service", "CPMS not supported on
+ * current platform", and ABM asserts (fCPMSAgent) right after its fake boot (CommCenter sig 5, every restart).
+ */
+/*
+ * cell5 (2026-11-19, Claude): CPMSSupported for CommCenter only. CPMS.framework has one global switch, this
+ * property, and audiomxd follows it too: with CPMSSupported 1 its haptics ask CPMS for power budgets
+ * (initializeCPMSForHaptics), which this stand-in cannot grant, so its haptic power manager is never made and the
+ * first system haptic aborts audiomxd (ServerManager.mm:1162 "mPowerManager != nullptr"; every audiomxd crash report
+ * is from after cell2). The dead audiomxd then left Settings waiting forever on com.apple.coremedia.routingcontext.xpc
+ * (HeadphoneSettings -> FigRoutingContextRemoteCopySystemAudioContext). Every other process now reads 0, as
+ * before cell2 (no ApplePPM = "CPMS not supported"); CommCenter (ABM's fCPMSAgent) still reads the stored 1.
+ */
+static OSNumber *ppm_zero;
+
+static bool
+ppm_caller_gets_cpms(void)
+{
+	char n[32] = "";
+	proc_selfname(n, (int)sizeof(n));
+	return strcmp(n, "CommCenter") == 0;
+}
+
+class ApplePPM : public IOService
+{
+	OSDeclareDefaultStructors(ApplePPM);
+public:
+	OSObject *getProperty(const OSSymbol *aKey) const APPLE_KEXT_OVERRIDE;
+	OSPtr<OSDictionary> dictionaryWithProperties(void) const APPLE_KEXT_OVERRIDE;
+	bool serializeProperties(OSSerialize *s) const APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(ApplePPM, IOService);
+
+/* every getProperty/copyProperty form (const char *, OSString, OSSymbol) ends here */
+OSObject *
+ApplePPM::getProperty(const OSSymbol *aKey) const
+{
+	if (ppm_zero && aKey && aKey->isEqualTo("CPMSSupported") && !ppm_caller_gets_cpms()) {
+		return ppm_zero;
+	}
+	return IOService::getProperty(aKey);
+}
+
+OSPtr<OSDictionary>
+ApplePPM::dictionaryWithProperties(void) const
+{
+	OSPtr<OSDictionary> d = IOService::dictionaryWithProperties();
+	if (d && ppm_zero && !ppm_caller_gets_cpms()) {
+		d->setObject("CPMSSupported", ppm_zero);
+	}
+	return d;
+}
+
+bool
+ApplePPM::serializeProperties(OSSerialize *s) const
+{
+	if (!ppm_zero || ppm_caller_gets_cpms()) {
+		return IOService::serializeProperties(s);
+	}
+	OSPtr<OSDictionary> d = dictionaryWithProperties();
+	bool ok = d && d->serialize(s);
+	OSSafeReleaseNULL(d);
+	return ok;
+}
