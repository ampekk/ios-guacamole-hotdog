+static struct {
+	uint8_t buf[ABPB_RING];
+	uint32_t head, tail;            /* head - tail = bytes present */
+	struct selinfo sel;
+	bool open;
+	bool node;
+	bool ready;                     /* 1063: wland said ABPB_IOC_READY 1 (cleared on 0 / close) */
+	uint32_t readies;
+	uint32_t records, dropped, dropped_bytes;
+	uint64_t to_wland, from_wland;
+} ab;
+
+/* ---- kernel -> wland ring ---- */
+
+static uint32_t
+ab_used(void)
+{
+	return ab.head - ab.tail;
+}
+
+static void
+ab_put(const void *src, uint32_t len)
+{
+	const uint8_t *s = src;
+	while (len) {
+		uint32_t off = ab.head % ABPB_RING;
+		uint32_t run = ABPB_RING - off;
+		if (run > len) {
+			run = len;
+		}
+		memcpy(ab.buf + off, s, run);
+		ab.head += run;
+		s += run;
+		len -= run;
+	}
+}
+
+static void
+ab_peek(void *dst, uint32_t at, uint32_t len)
+{
+	uint8_t *d = dst;
+	while (len) {
+		uint32_t off = at % ABPB_RING;
+		uint32_t run = ABPB_RING - off;
+		if (run > len) {
+			run = len;
+		}
+		memcpy(d, ab.buf + off, run);
+		at += run;
+		d += run;
+		len -= run;
+	}
+}
+
+
+/*
+ * ---- cell1: the kernel's own QMI answers, when nobody has /dev/abpbridge open ----
+ *
+ * A "no SIM, no service" modem for iOS 27.2's CommCenter. Frames are QMUX: 01 | u16 len | u8 flags | u8 svc | u8 cid |
+ * SDU; CTL SDU: u8 flags | u8 tx | u16 msg | u16 len | TLVs; other services: u8 flags | u16 tx | u16 msg | u16 len |
+ * TLVs (redfin phone/wifi/abpbridge.c). Answers are queued and delivered from a thread call (like a modem: after the
+ * write completed).
+ */
+#define QMI_ERR_NOT_SUPPORTED   0x5e
+#define ABPB_DATA_T             0       /* sweet_abp_c2w type: a frame (1-4 open/close/start/abort) */
+#define QA_NSEEN                256
+#define QA_LOGLINES             400
+
+static uint32_t qa_default;             /* 0: unknown requests get QMI_ERR_NOT_SUPPORTED; 1: success without TLVs */
+static uint32_t qa_lines, qa_frames, qa_answers, qa_ctl_count;
+static uint8_t qa_cid[256];             /* next client id per service */
+static struct { uint8_t svc; uint16_t msg; uint8_t act; uint32_t n; } qa_seen[QA_NSEEN];
+static uint32_t qa_nseen;
+
+struct qa_rec {
+	struct qa_rec *next;
+	unsigned pipe;
+	uint32_t sess, len;
+	uint8_t d[];
+};
+static struct qa_rec *qa_head, **qa_tail = &qa_head;
+static thread_call_t qa_tc;
+
+#define QALOG(fmt, ...) do { if (qa_lines < QA_LOGLINES) { qa_lines++; printf("SWEET ABP: QMI " fmt "\n", ##__VA_ARGS__); } } while (0)
+
+static const char *
+qa_svc_name(unsigned s)
+{
+	switch (s) {
+	case 0x00: return "CTL"; case 0x01: return "WDS"; case 0x02: return "DMS"; case 0x03: return "NAS";
+	case 0x04: return "QOS"; case 0x05: return "WMS"; case 0x06: return "PDS"; case 0x08: return "AT";
+	case 0x09: return "VOICE"; case 0x0a: return "CAT"; case 0x0b: return "UIM"; case 0x0c: return "PBM";
+	case 0x10: return "LOC"; case 0x11: return "SAR"; case 0x1a: return "WDA"; case 0x22: return "COEX";
+	case 0x24: return "PDC"; case 0x29: return "RFRPE"; case 0x2a: return "DSD"; case 0x2b: return "SSCTL";
+	case 0x2c: return "MFSE"; case 0x2f: return "DPM"; case 0x30: return "DFS";
+	case 0xe1: return "Apple AUDIO"; case 0xe2: return "Apple BSP";
+	default: return s >= 0xe0 ? "Apple" : "?";
+	}
+}
+
+static void
+qa_tc_fn(__unused thread_call_param_t a, __unused thread_call_param_t b)
+{
+	for (;;) {
+		lck_mtx_lock(&abp_lock);
+		struct qa_rec *r = qa_head;
+		if (r) {
+			qa_head = r->next;
+			if (qa_head == NULL) {
+				qa_tail = &qa_head;
+			}
+		}
+		lck_mtx_unlock(&abp_lock);
+		if (r == NULL) {
+			return;
+		}
+		SweetABPDeliver(r->pipe, r->sess, r->d, r->len);
+		kfree_data(r, sizeof(*r) + r->len);
+	}
+}
+
+/* b: the whole frame (QMUX header at 0); fills the QMUX header and queues it */
+static void
+qa_send(unsigned pipe, uint32_t sess, uint8_t *b, uint32_t n, unsigned svc, unsigned cid)
+{
+	b[0] = 0x01;
+	b[1] = (uint8_t)((n - 1) & 0xff);
+	b[2] = (uint8_t)((n - 1) >> 8);
+	b[3] = 0x80;                    /* from the service */
+	b[4] = (uint8_t)svc;
+	b[5] = (uint8_t)cid;
+	struct qa_rec *r = kalloc_data(sizeof(*r) + n, Z_WAITOK);
+	if (r == NULL) {
+		return;
+	}
+	r->next = NULL;
+	r->pipe = pipe;
+	r->sess = sess;
+	r->len = n;
+	memcpy(r->d, b, n);
+	lck_mtx_lock(&abp_lock);
+	*qa_tail = r;
+	qa_tail = &r->next;
+	qa_answers++;
+	if (qa_tc == NULL) {
+		qa_tc = thread_call_allocate_with_options(qa_tc_fn, NULL, THREAD_CALL_PRIORITY_KERNEL, THREAD_CALL_OPTIONS_ONCE);
+	}
+	thread_call_t tc = qa_tc;
+	lck_mtx_unlock(&abp_lock);
+	if (tc) {
+		thread_call_enter(tc);
+	}
+}
+
+static void
+qa_tlv(uint8_t *b, uint32_t *o, uint32_t cap, unsigned t, const void *v, uint32_t l)
+{
+	if (*o + 3 + l > cap) {
+		return;
+	}
+	b[(*o)++] = (uint8_t)t;
+	b[(*o)++] = (uint8_t)(l & 0xff);
+	b[(*o)++] = (uint8_t)(l >> 8);
+	if (l) {
+		memcpy(b + *o, v, l);
+	}
+	*o += l;
+}
+
+/* first TLV t of a request: its value and length (or NULL) */
+static const uint8_t *
+qa_find(const uint8_t *tl, uint32_t tn, unsigned t, uint32_t *l)
+{
+	for (uint32_t i = 0; i + 3 <= tn;) {
+		uint32_t ln = tl[i + 1] | (tl[i + 2] << 8);
+		if (i + 3 + ln > tn) {
+			break;
+		}
+		if (tl[i] == t) {
+			*l = ln;
+			return tl + i + 3;
+		}
+		i += 3 + ln;
+	}
+	return NULL;
+}
+
+static void
+qa_ctl(unsigned pipe, uint32_t sess, const uint8_t *s, uint32_t sn)
+{
+	unsigned tx = s[1], msg = s[2] | (s[3] << 8), ml = s[4] | (s[5] << 8);
+	const uint8_t *tl = s + 6;
+	uint32_t tn = sn - 6 < ml ? sn - 6 : ml, l = 0;
+	uint8_t b[512];
+	uint32_t o = 12;
+	uint16_t res[2] = { 0, 0 };
+	const uint8_t *v;
+	qa_ctl_count++;
+	if (msg == 0x22) {              /* GetClientId: TLV 0x01 = service */
+		v = qa_find(tl, tn, 0x01, &l);
+		unsigned svc = (v && l >= 1) ? v[0] : 0;
+		if (++qa_cid[svc] == 0 || qa_cid[svc] == 0xff) {
+			qa_cid[svc] = 1;
+		}
+		uint8_t c[2] = { (uint8_t)svc, qa_cid[svc] };
+		qa_tlv(b, &o, sizeof(b), 0x02, res, 4);
+		qa_tlv(b, &o, sizeof(b), 0x01, c, 2);
+		if (qa_cid[svc] <= 2) {         /* cell3: the first two per service only */
+			QALOG("%s/%u CTL GetClientId %s(0x%02x) -> client %u", pipe ? "qmux2" : "qmux1", sess, qa_svc_name(svc), svc,
+			    c[1]);
+		}
+	} else if (msg == 0x23) {       /* ReleaseClientId: echo {svc, cid} */
+		qa_tlv(b, &o, sizeof(b), 0x02, res, 4);
+		if ((v = qa_find(tl, tn, 0x01, &l)) != NULL && l == 2) {
+			qa_tlv(b, &o, sizeof(b), 0x01, v, 2);
+		}
+	} else if (msg == 0x21) {       /* GetVersionInfo: the standard services an SM8150 modem has + Apple's */
+		static const uint8_t list[] = { 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x09, 0x0a, 0x0b, 0x0c, 0x10, 0x1a,
+			                        0x22, 0x24, 0x2a, 0x2b, 0x30 };
+		uint8_t vl[1 + sizeof(list) * 5];
+		vl[0] = (uint8_t)sizeof(list);
+		for (unsigned i = 0; i < sizeof(list); i++) {
+			vl[1 + i * 5] = list[i];
+			vl[2 + i * 5] = 1;
+			vl[3 + i * 5] = 0;
+			vl[4 + i * 5] = 0x40;
+			vl[5 + i * 5] = 0;
+		}
+		qa_tlv(b, &o, sizeof(b), 0x02, res, 4);
+		qa_tlv(b, &o, sizeof(b), 0x01, vl, sizeof(vl));
+	} else if (msg == 0x26) {       /* SetDataFormat: echo the link protocol */
+		qa_tlv(b, &o, sizeof(b), 0x02, res, 4);
+		if ((v = qa_find(tl, tn, 0x10, &l)) != NULL && l <= 4) {
+			qa_tlv(b, &o, sizeof(b), 0x10, v, l);
+		}
+	} else {                        /* Sync, power save, anything else: success */
+		qa_tlv(b, &o, sizeof(b), 0x02, res, 4);
+	}
+	if (msg != 0x22 && msg != 0x23) {       /* cell3: ReleaseClientId is routine (it used up the log in cell2) */
+		QALOG("%s/%u CTL 0x%02x answered", pipe ? "qmux2" : "qmux1", sess, msg);
+	}
+	b[6] = 0x01;
+	b[7] = (uint8_t)tx;
+	b[8] = (uint8_t)msg;
+	b[9] = (uint8_t)(msg >> 8);
+	b[10] = (uint8_t)((o - 12) & 0xff);
+	b[11] = (uint8_t)((o - 12) >> 8);
+	qa_send(pipe, sess, b, o, 0, 0);
+}
+
+enum { QA_ERR = 0, QA_OK = 1, QA_RESP = 2 };
+
+/*
+ * cell3: the phone's own IMEI for CommCenter ("Unable to supply dictionary; MEID(ready=0) and IMEI(ready=0)").
+ * Read from /var/local/cell/imei, which wland's dms.c writes from the modem's DMS answer (root, 0600, never in
+ * git): 15-digit IMEI lines (slot 1 first; a second line would be slot 2, unused while one slot is supported) and
+ * an optional "sv NN" line (IMEISV software version). Re-read until it exists; the values are never logged.
+ */
+#define QA_IMEI_FILE    "/var/local/cell/imei"
+static char qa_imei[2][16];
+static unsigned qa_nimei;
+static uint8_t qa_svn;
+static int qa_imei_state;               /* 0 not read, 1 have it, -1 missing/bad (re-read later) */
+static uint64_t qa_imei_tried;
+
+static void
+qa_imei_load(void)
+{
+	char buf[128];
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();       /* not CommCenter's credentials: the file is root's, 0600 */
+	int resid = 0;
+	uint64_t now = mach_absolute_time();
+	if (qa_imei_state == 1 || (qa_imei_tried && now - qa_imei_tried < 5ULL * 24000000ULL)) {
+		return;                         /* have it, or tried < ~5 s ago */
+	}
+	qa_imei_tried = now;
+	if (vnode_open(QA_IMEI_FILE, FREAD, 0, 0, &vp, ctx) != 0) {
+		if (qa_imei_state == 0) {
+			printf("SWEET ABP: QMI no %s: no IMEI given to CommCenter\n", QA_IMEI_FILE);
+		}
+		qa_imei_state = -1;
+		return;
+	}
+	bzero(buf, sizeof(buf));
+	int e = vn_rdwr(UIO_READ, vp, buf, sizeof(buf) - 1, 0, UIO_SYSSPACE, IO_UNIT, vfs_context_ucred(ctx), &resid,
+	    vfs_context_proc(ctx));
+	vnode_close(vp, FREAD, ctx);
+	unsigned n = 0, bad = 0;
+	uint8_t svn = 0;
+	for (char *l = buf; e == 0 && *l;) {
+		char *nl = l;
+		while (*nl && *nl != '\n') {
+			nl++;
+		}
+		char *t = l;
+		while (*t == ' ' || *t == '\r' || *t == '\t') {
+			t++;
+		}
+		unsigned d = 0;
+		while (d < 16 && t[d] >= '0' && t[d] <= '9') {
+			d++;
+		}
+		if (d == 15 && n < 2) {
+			memcpy(qa_imei[n], t, 15);
+			qa_imei[n][15] = 0;
+			n++;
+		} else if (t[0] == 's' && t[1] == 'v' && t[2] == ' ' && t[3] >= '0' && t[3] <= '9' && t[4] >= '0' && t[4] <= '9') {
+			svn = (uint8_t)((t[3] - '0') * 10 + (t[4] - '0'));
+		} else if (t != nl && *t != '\r' && *t != '\n') {
+			bad++;
+		}
+		l = *nl ? nl + 1 : nl;
+	}
+	if (e != 0 || n == 0) {
+		printf("SWEET ABP: QMI %s: no 15-digit IMEI line (read %d, %u other lines): ignored\n", QA_IMEI_FILE, e, bad);
+		qa_imei_state = -1;
+		return;
+	}
+	qa_nimei = n;
+	qa_svn = svn;
+	qa_imei_state = 1;
+	printf("SWEET ABP: QMI %u IMEI(s) read from %s%s%s\n", n, QA_IMEI_FILE, svn ? ", with SV" : "",
+	    bad ? " (some lines not understood)" : "");
+}
+
+/*
+ * DMS device serial numbers: 0x0025 (Qualcomm's) and 0x0054 (Apple's per subscription: TLV 0x01 u32 1 or 2).
+ * Answer TLV 0x11 IMEI (+ 0x13 SVN): Qualcomm's GetDeviceSerialNumbers layout (0x10 ESN, 0x11 IMEI, 0x12 MEID).
+ */
+static int
+qa_serials(const uint8_t *tl, uint32_t tn, uint8_t *t, uint32_t *tnout)
+{
+	uint32_t o = 0, l = 0;
+	unsigned slot = 0;
+	const uint8_t *v = qa_find(tl, tn, 0x01, &l);
+	if (v && l >= 1 && v[0] == 2) {
+		slot = 1;                       /* slot 2: unsupported (one SIM slot), never answered */
+	}
+	if (slot != 0) {
+		return QA_ERR;
+	}
+	qa_imei_load();
+	if (qa_imei_state != 1 || slot >= qa_nimei) {
+		return QA_ERR;
+	}
+	qa_tlv(t, &o, 512, 0x11, qa_imei[slot], 15);
+	if (qa_svn) {                   /* as the modem sends it: a 2-character string (libqmi qmi-service-dms) */
+		char sv[2] = { (char)('0' + qa_svn / 10 % 10), (char)('0' + qa_svn % 10) };
+		qa_tlv(t, &o, 512, 0x13, sv, 2);
+	}
+	*tnout = o;
+	return QA_RESP;
+}
+
+/* the answer for (svc, msg): QA_ERR (code), QA_OK, or QA_RESP with TLVs written to t/tn */
+static int
+qa_decide(unsigned svc, unsigned msg, const uint8_t *tl, uint32_t tn, uint8_t *t, uint32_t *tnout, uint16_t *code)
+{
+	uint32_t o = 0, l = 0;
+	const uint8_t *v;
+	*code = QMI_ERR_NOT_SUPPORTED;
+	if (msg == 0x0000) {
+		return QA_OK;                   /* every service's reset */
+	}
+	switch (svc) {
+	case 0x0b:                              /* UIM */
+		if (msg == 0x002f) {            /* GetCardStatus: one slot (only slot 1 is supported), absent, no apps */
+			static const uint8_t cs[] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 1, 0, 0, 0, 0, 0, 0 };
+			qa_tlv(t, &o, 512, 0x10, cs, sizeof(cs));
+			*tnout = o;
+			return QA_RESP;
+		}
+		if (msg == 0x002e && (v = qa_find(tl, tn, 0x01, &l)) != NULL && l == 4) {      /* EventReg: echo mask */
+			qa_tlv(t, &o, 512, 0x10, v, 4);
+			*tnout = o;
+			return QA_RESP;
+		}
+		break;
+	case 0x02:                              /* DMS */
+		if (msg == 0x002d) {            /* GetOperatingMode: online */
+			uint8_t m = 0;
+			qa_tlv(t, &o, 512, 0x01, &m, 1);
+			*tnout = o;
+			return QA_RESP;
+		}
+		if (msg == 0x0023) {            /* GetRevision */
+			static const char rev[] = "SWEET-NOSIM-1";
+			qa_tlv(t, &o, 512, 0x01, rev, sizeof(rev) - 1);
+			*tnout = o;
+			return QA_RESP;
+		}
+		if (msg == 0x0001 || msg == 0x002e) {
+			return QA_OK;           /* event report / set operating mode */
+		}
+		if (msg == 0x0025 || msg == 0x0054) {
+			return qa_serials(tl, tn, t, tnout);    /* cell3: IMEIs from /var/local/cell/imei */
+		}
+		break;
+	case 0x03:                              /* NAS */
+		if (msg == 0x0024) {            /* GetServingSystem: not registered, CS/PS detached, no radio */
+			static const uint8_t ss[] = { 0, 2, 2, 0, 0 };
+			qa_tlv(t, &o, 512, 0x01, ss, sizeof(ss));
+			*tnout = o;
+			return QA_RESP;
+		}
+		if (msg == 0x0002 || msg == 0x0003 || msg == 0x004d || msg == 0x5557 || msg == 0x555b) {
+			return QA_OK;           /* event report, register indications, sys info (none), Apple NAS */
+		}
+		break;
+	case 0x06:                              /* PDS */
+		return msg == 0x0020 ? QA_ERR : QA_OK;
+	case 0x22:                              /* COEX */
+	case 0x2c:                              /* MFSE */
+	case 0xe1: case 0xe4: case 0xe7:        /* Apple (redfin's policy: ok) */
+		return QA_OK;
+	case 0xe2:                              /* Apple BSP (redfin: err 0x5e) */
+		return QA_ERR;
+	default:
+		break;
+	}
+	return qa_default ? QA_OK : QA_ERR;
+}
+
+static void
+qa_service(unsigned pipe, uint32_t sess, unsigned svc, unsigned cid, const uint8_t *s, uint32_t sn)
+{
+	if (sn < 7 || s[0] != 0x00) {
+		return;                         /* not a request */
+	}
+	unsigned msg = s[3] | (s[4] << 8), ml = s[5] | (s[6] << 8);
+	const uint8_t *tl = s + 7;
+	uint32_t tn = sn - 7 < ml ? sn - 7 : ml;
+	uint8_t b[16 + 512 + 16];
+	uint8_t t[512];
+	uint32_t tlen = 0;
+	uint16_t code = 0;
+	int act = qa_decide(svc, msg, tl, tn, t, &tlen, &code);
+	uint32_t o = 13;
+	uint16_t res[2] = { (uint16_t)(act == QA_ERR ? 1 : 0), (uint16_t)(act == QA_ERR ? code : 0) };
+	lck_mtx_lock(&abp_lock);
+	bool first = true;
+	for (uint32_t i = 0; i < qa_nseen; i++) {
+		if (qa_seen[i].svc == svc && qa_seen[i].msg == msg) {
+			qa_seen[i].n++;
+			first = false;
+		}
+	}
+	if (first && qa_nseen < QA_NSEEN) {
+		qa_seen[qa_nseen].svc = (uint8_t)svc;
+		qa_seen[qa_nseen].msg = (uint16_t)msg;
+		qa_seen[qa_nseen].act = (uint8_t)act;
+		qa_seen[qa_nseen].n = 1;
+		qa_nseen++;
+	}
+	/* the request's TLV ids/lengths (never values) for the first occurrence */
+	char tlvs[96];
+	size_t to = 0;
+	tlvs[0] = 0;
+	for (uint32_t i = 0; first && i + 3 <= tn && to + 12 < sizeof(tlvs);) {
+		uint32_t ln = tl[i + 1] | (tl[i + 2] << 8);
+		to += snprintf(tlvs + to, sizeof(tlvs) - to, " %02x/%u", tl[i], ln);
+		i += 3 + ln;
+	}
+	qa_tlv(b, &o, sizeof(b), 0x02, res, 4);
+	if (act == QA_RESP && o + tlen <= sizeof(b)) {
+		memcpy(b + o, t, tlen);
+		o += tlen;
+	}
+	b[6] = 0x02;
+	b[7] = s[1];
+	b[8] = s[2];
+	b[9] = s[3];
+	b[10] = s[4];
+	b[11] = (uint8_t)((o - 13) & 0xff);
+	b[12] = (uint8_t)((o - 13) >> 8);
+	lck_mtx_unlock(&abp_lock);
+	if (first) {
+		QALOG("%s/%u %s(0x%02x) cid %u msg 0x%04x TLVs[%s ] -> %s", pipe ? "qmux2" : "qmux1", sess, qa_svc_name(svc), svc,
+		    cid, msg, tlvs, act == QA_ERR ? "error 0x5e" : act == QA_OK ? "ok" : "answered");
+	}
+	qa_send(pipe, sess, b, o, svc, cid);
+}
+
+static void
+qa_frame(unsigned pipe, uint32_t sess, unsigned type, const uint8_t *d, uint32_t n)
+{
+	if (type != ABPB_DATA_T) {
+		return;
+	}
+	qa_frames++;
+	if (n < 6 || d[0] != 0x01) {
+		QALOG("%s/%u: not a QMUX frame (%u bytes, first 0x%02x)", pipe ? "qmux2" : "qmux1", sess, n, n ? d[0] : 0);
+		return;
+	}
+	unsigned svc = d[4], cid = d[5];
+	if (svc == 0) {
+		if (n >= 12) {
+			qa_ctl(pipe, sess, d + 6, n - 6);
+		}
+	} else {
+		qa_service(pipe, sess, svc, cid, d + 6, n - 6);
+	}
+}
+
+static int
+sysctl_abp_qmi_stats(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	size_t cap = 64 + QA_NSEEN * 28;
+	char *s = kalloc_data(cap, Z_WAITOK | Z_ZERO);
+	if (s == NULL) {
+		return ENOMEM;
+	}
+	lck_mtx_lock(&abp_lock);
+	size_t o = (size_t)snprintf(s, cap, "frames %u answers %u ctl %u default %s |", qa_frames, qa_answers, qa_ctl_count,
+	    qa_default ? "ok" : "err");
+	for (uint32_t i = 0; i < qa_nseen && o + 28 < cap; i++) {
+		o += (size_t)snprintf(s + o, cap - o, " %02x:%04x %s x%u", qa_seen[i].svc, qa_seen[i].msg,
+		    qa_seen[i].act == QA_ERR ? "e" : qa_seen[i].act == QA_OK ? "ok" : "r", qa_seen[i].n);
+	}
+	lck_mtx_unlock(&abp_lock);
+	int e = SYSCTL_OUT(req, s, strlen(s) + 1);
+	kfree_data(s, cap);
+	return e;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_abp_qmi_stats, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, NULL, 0, sysctl_abp_qmi_stats, "A",
+    "cell1: the kernel's QMI answers: every (service:message) CommCenter asked, how it was answered (e/ok/r), count");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_abp_qmi_default, CTLFLAG_RW | CTLFLAG_LOCKED, &qa_default, 0,
+    "cell1: unknown QMI requests: 0 = QMI_ERR_NOT_SUPPORTED, 1 = success without TLVs");
+
+/* CommCenter wrote a frame (or opened/closed/started/aborted a pipe): queue it for wland. Never blocks. */
+void
+sweet_abp_c2w(unsigned pipe, uint32_t sess, unsigned type, const void *data, uint32_t len)
+{
+	struct abpb_hdr h = { .magic = ABPB_MAGIC, .pipe = (uint8_t)pipe, .type = (uint8_t)type, .sess = sess, .len = len };
+	if (len > ABPB_MAXFRAME) {
+		return;
+	}
+	lck_mtx_lock(&abp_lock);
+	if (!ab.open) {                 /* cell1: no bridge daemon: the kernel answers */
+		lck_mtx_unlock(&abp_lock);
+		qa_frame(pipe, sess, type, data, len);
+		return;
+	}
+	if (ABPB_RING - ab_used() < sizeof(h) + len) {
+		if (ab.dropped++ < 20) {
+			printf("SWEET ABP: bridge queue full (%u bytes, wland %s): dropped a %u-byte frame of pipe %u\n",
+			    ab_used(), ab.open ? "open" : "not open", len, pipe);
+		}
+		ab.dropped_bytes += len;
+		lck_mtx_unlock(&abp_lock);
+		return;
+	}
+	ab_put(&h, sizeof(h));
+	if (len) {
+		ab_put(data, len);
+	}
+	ab.records++;
+	ab.to_wland += len;
+	wakeup(&ab);
+	selwakeup(&ab.sel);
+	lck_mtx_unlock(&abp_lock);
+}
+
+static int
+ab_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	lck_mtx_lock(&abp_lock);
+	if (ab.open) {
+		lck_mtx_unlock(&abp_lock);
+		return EBUSY;
+	}
+	ab.open = true;
+	printf("SWEET ABP: /dev/abpbridge opened (%u bytes / %u records waiting)\n", ab_used(), ab.records);
+	lck_mtx_unlock(&abp_lock);
+	return 0;
+}
+
+static int
+ab_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused proc_t p)
+{
+	bool was_ready;
+	lck_mtx_lock(&abp_lock);
+	ab.open = false;
+	was_ready = ab.ready;
+	ab.ready = false;
+	wakeup(&ab);
+	selwakeup(&ab.sel);
+	lck_mtx_unlock(&abp_lock);
+	printf("SWEET ABP: /dev/abpbridge closed%s\n", was_ready ? " (was ready: now not ready)" : "");
+	if (was_ready && (sweet_abp_flags & ABP_BIT_DEFER) && (sweet_abp_flags & ABP_BIT_UNPUB_ON_CLOSE)) {
+		SweetABPPublish(false, "bridge closed, sweetabp & 0x20");
+	}
+	return 0;
+}
+
+/* 1063: wland says it can (1) or cannot (0) answer for the modem now. */
+static int
+ab_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int fflag, __unused proc_t p)
+{
+	if (cmd != ABPB_IOC_READY) {
+		return ENOTTY;
+	}
+	uint32_t v = *(uint32_t *)(void *)data;
+	bool was;
+	lck_mtx_lock(&abp_lock);
+	was = ab.ready;
+	ab.ready = v != 0;
+	if (ab.ready && !was) {
+		ab.readies++;
+	}
+	lck_mtx_unlock(&abp_lock);
+	printf("SWEET ABP: wland says %s (was %s)\n", v ? "READY" : "not ready", was ? "ready" : "not ready");
+	if (!(sweet_abp_flags & ABP_BIT_DEFER)) {
+		return 0;               /* published at boot already: nothing to do */
+	}
+	if (v) {
+		int e = SweetABPPublish(true, "wland ready");
+		return e == EALREADY ? 0 : e;
+	}
+	if (sweet_abp_flags & ABP_BIT_UNPUB_ON_CLOSE) {
+		int e = SweetABPPublish(false, "wland not ready, sweetabp & 0x20");
+		return e == EALREADY ? 0 : e;
+	}
+	return 0;
+}
+
+static int
+ab_read(__unused dev_t dev, struct uio *uio, int ioflag)
+{
+	int e = 0, moved = 0;
+	uint8_t *tmp = NULL;
+	lck_mtx_lock(&abp_lock);
+	while (ab_used() == 0) {
+		if (ioflag & IO_NDELAY) {
+			lck_mtx_unlock(&abp_lock);
+			return EWOULDBLOCK;
+		}
+		e = msleep(&ab, &abp_lock, PZERO | PCATCH, "abpbrd", NULL);
+		if (e) {
+			lck_mtx_unlock(&abp_lock);
+			return e;
+		}
+	}
+	while (ab_used() >= sizeof(struct abpb_hdr)) {
+		struct abpb_hdr h;
+		ab_peek(&h, ab.tail, sizeof(h));
+		uint32_t rec = (uint32_t)sizeof(h) + h.len;
+		if (rec > uio_resid(uio)) {
+			if (moved == 0) {
+				e = EMSGSIZE;
+			}
+			break;
+		}
+		if (tmp == NULL) {
+			tmp = kalloc_data(sizeof(h) + ABPB_MAXFRAME, Z_WAITOK);
+			if (tmp == NULL) {
+				e = ENOMEM;
+				break;
+			}
+		}
+		ab_peek(tmp, ab.tail, rec);
+		ab.tail += rec;
+		ab.records--;
+		lck_mtx_unlock(&abp_lock);
+		e = uiomove((caddr_t)tmp, (int)rec, uio);
+		lck_mtx_lock(&abp_lock);
+		if (e) {
+			break;
+		}
+		moved++;
+	}
+	lck_mtx_unlock(&abp_lock);
+	if (tmp) {
+		kfree_data(tmp, sizeof(struct abpb_hdr) + ABPB_MAXFRAME);
+	}
+	return e;
+}
+
+static int
+ab_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	user_ssize_t n = uio_resid(uio);
+	if (n <= 0) {
+		return 0;
+	}
+	if (n > (user_ssize_t)(sizeof(struct abpb_hdr) + ABPB_MAXFRAME)) {
+		return EMSGSIZE;
+	}
+	uint32_t total = (uint32_t)n;
+	uint8_t *buf = kalloc_data(total, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	int e = uiomove((caddr_t)buf, (int)total, uio);
+	uint32_t off = 0;
+	while (e == 0 && off + sizeof(struct abpb_hdr) <= total) {
+		struct abpb_hdr h;
+		memcpy(&h, buf + off, sizeof(h));
+		if (h.magic != ABPB_MAGIC || h.len > total - off - sizeof(h) || h.pipe >= ABP_NPIPES) {
+			e = EINVAL;
+			break;
+		}
+		if (h.type == 0) {
+			int d = SweetABPDeliver(h.pipe, h.sess, buf + off + sizeof(h), h.len);
+			if (d) {
+				e = d;
+				break;
+			}
+			lck_mtx_lock(&abp_lock);
+			ab.from_wland += h.len;
+			lck_mtx_unlock(&abp_lock);
+		}
+		off += (uint32_t)sizeof(h) + h.len;
+	}
+	if (e == 0 && off != total) {
+		e = EINVAL;
+	}
+	kfree_data(buf, total);
+	return e;
+}
+
+static int
+ab_select(__unused dev_t dev, int which, void *wql, proc_t p)
+{
+	int ready = 0;
+	lck_mtx_lock(&abp_lock);
+	if (which == FREAD) {
+		if (ab_used()) {
+			ready = 1;
+		} else {
+			selrecord(p, &ab.sel, wql);
+		}
+	} else if (which == FWRITE) {
+		ready = 1;
+	}
+	lck_mtx_unlock(&abp_lock);
+	return ready;
+}
+
+static const struct cdevsw ab_cdevsw = {
+	.d_open       = ab_open,
+	.d_close      = ab_close,
+	.d_read       = ab_read,
+	.d_write      = ab_write,
+	.d_ioctl      = ab_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = ab_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+static void
+sweet_abp_apply(uint32_t bits)
+{
+	sweet_abp_flags |= bits;
+	if (!(sweet_abp_flags & ABP_BIT_SERVICES) || ab.node) {
+		return;
+	}
+	ab.node = true;
+	int major = cdevsw_add(-1, &ab_cdevsw);
+	void *n = major < 0 ? NULL : devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "abpbridge");
+	printf("SWEET ABP: /dev/abpbridge %s (major %d)\n", n ? "made" : "FAILED", major);
+	SweetABPStart();
+	if (sweet_abp_flags & ABP_BIT_DEFER) {
+		printf("SWEET ABP: deferred publish (sweetabp & 8): the services appear when wland says ready\n");
+	} else {
+		SweetABPPublish(true, "boot");
+	}
+}
+
+void
+sweet_abp_init(void)
+{
+	uint32_t on = 0, fake = 0;
+	PE_parse_boot_argn("sweetabp", &on, sizeof(on));
+	PE_parse_boot_argn("sweetabmfake", &fake, sizeof(fake));
+	PE_parse_boot_argn("sweetabpstage", &sweet_abp_bootstage, sizeof(sweet_abp_bootstage));
+	PE_parse_boot_argn("sweetabpready", &sweet_abp_readyms, sizeof(sweet_abp_readyms));
+	PE_parse_boot_argn("sweetabpqmidef", &qa_default, sizeof(qa_default));
+	if (fake) {
+		on |= ABP_BIT_FAKEBOOT;
+	}
+	if (!on) {
+		return;
+	}
+	printf("SWEET ABP: sweetabp=0x%x (services %s%s%s%s, fake boot %s), bootstage %u\n", on,
+	    (on & ABP_BIT_SERVICES) ? "on" : "off", (on & ABP_BIT_DEFER) ? ", deferred to wland ready" : "",
+	    (on & ABP_BIT_NOPDP) ? ", no PDPManagerBase" : "", (on & ABP_BIT_UNPUB_ON_CLOSE) ? ", un-publish on close" : "",
+	    (on & ABP_BIT_FAKEBOOT) ? "on" : "off", sweet_abp_bootstage);
+	sweet_abp_apply(on);
+}
+
+/* ---- fake boot: capabilities::bb::abm::shouldBoot() -> 0 in CommCenter ---- */
+
+/* iOS 27.2 (24B119) D73 cache: capabilities::abs::shouldBoot() in libTelephonyCapabilities */
+#define ABM_SHOULDBOOT_VA       0x1cdf873b0ULL          /* unslid cache VA */
+#define ABM_NWORDS              7
+#define ABM_PATCH_WORD          5                        /* 0x1cdf873c4: ldrb w0, [x8, #0x942] */
+#define ABM_INSN_RET1           0x39650900u              /* the original instruction (reads the static, = 1) */
+#define ABM_INSN_RET0           0x52800000u              /* mov w0, #0 */
+static const uint32_t abm_expect[ABM_NWORDS] = {
+	0x90101188,     /* adrp x8, guard@page */
+	0x9127e108,     /* add x8, x8, #0x9f8 */
+	0x38bfc108,     /* ldaprb w8, [x8] */
+	0x36000088,     /* tbz w8, #0, +0x10 (first call: __cxa_guard) */
+	0x90101188,     /* adrp x8, value@page */
+	0x39650900,     /* ldrb w0, [x8, #0x942]   <- becomes mov w0, #0 */
+	0xd65f03c0,     /* ret */
+};
+
+static int abm_state;                   /* 0 never tried, 1 patched, 2 already patched, < 0 the step that failed */
+static int abm_pid;
+static uint32_t abm_count;
+
+static void
+abm_words(const char *what, const uint32_t *w)
+{
+	printf("SWEET ABP: fake boot: %s %08x %08x %08x %08x %08x %08x %08x\n", what,
+	    w[0], w[1], w[2], w[3], w[4], w[5], w[6]);
+}
+
+void
+sweet_abp_dyld_hook(void *pv, uint64_t cache_start)
+{
+	proc_t p = (proc_t)pv;
+	char name[32];
+	if (!(sweet_abp_flags & ABP_BIT_FAKEBOOT) || cache_start == 0) {
+		return;
+	}
+	proc_selfname(name, (int)sizeof(name));
+	if (strcmp(name, "CommCenter") != 0) {
+		return;
+	}
+	int pid = proc_selfpid();
+	uint8_t hdr[0x20];
+	uint64_t map0 = 0;
+	uint32_t w[ABM_NWORDS], back = 0;
+	int st = 0;
+	kern_return_t kr = KERN_SUCCESS;
+	abm_count++;
+	if (copyin((user_addr_t)cache_start, hdr, sizeof(hdr)) || memcmp(hdr, "dyld_v1", 7) != 0) {
+		printf("SWEET ABP: fake boot: pid %d: no dyld cache header at 0x%llx: refused\n", pid, cache_start);
+		st = -1;
+		goto out;
+	}
+	uint32_t moff;
+	memcpy(&moff, hdr + 0x10, sizeof(moff));
+	if (moff < 0x18 || moff > 0x1000 || copyin((user_addr_t)(cache_start + moff), &map0, sizeof(map0))) {
+		printf("SWEET ABP: fake boot: pid %d: bad mapping offset 0x%x: refused\n", pid, moff);
+		st = -2;
+		goto out;
+	}
+	uint64_t slide = cache_start - map0;
+	uint64_t fn = ABM_SHOULDBOOT_VA + slide;
+	if (copyin((user_addr_t)fn, w, sizeof(w))) {
+		printf("SWEET ABP: fake boot: pid %d: cannot read shouldBoot at 0x%llx (slide 0x%llx): refused\n", pid, fn, slide);
+		st = -3;
+		goto out;
+	}
+	bool same = true;
+	for (int i = 0; i < ABM_NWORDS; i++) {
+		if (w[i] != abm_expect[i] && !(i == ABM_PATCH_WORD && w[i] == ABM_INSN_RET0)) {
+			same = false;
+		}
+	}
+	if (!same) {
+		printf("SWEET ABP: fake boot: pid %d: shouldBoot at 0x%llx (cache 0x%llx, slide 0x%llx) differs: refused\n",
+		    pid, fn, cache_start, slide);
+		abm_words("found   ", w);
+		abm_words("expected", abm_expect);
+		st = -4;
+		goto out;
+	}
+	if (w[ABM_PATCH_WORD] == ABM_INSN_RET0) {
+		printf("SWEET ABP: fake boot: pid %d: shouldBoot at 0x%llx already returns 0\n", pid, fn);
+		st = 2;
+		goto out;
+	}
+	if (!cs_allow_invalid(p)) {
+		printf("SWEET ABP: fake boot: pid %d: cs_allow_invalid refused: refused\n", pid);
+		st = -5;
+		goto out;
+	}
+	vm_map_t map = get_task_map(proc_task(p));
+	uint64_t pmask = (uint64_t)vm_map_page_mask(map);
+	uint64_t pg = (fn + 4 * ABM_PATCH_WORD) & ~pmask;
+	uint64_t pend = pg + pmask + 1;
+	kr = mach_vm_protect(map, pg, pend - pg, FALSE, VM_PROT_READ | VM_PROT_WRITE | VM_PROT_COPY);
+	if (kr != KERN_SUCCESS) {
+		printf("SWEET ABP: fake boot: pid %d: vm_protect(COPY|rw) of 0x%llx failed (%d)\n", pid, pg, kr);
+		st = -6;
+		goto out;
+	}
+	uint32_t ret0 = ABM_INSN_RET0;
+	int ce = copyout(&ret0, (user_addr_t)(fn + 4 * ABM_PATCH_WORD), sizeof(ret0));
+	kr = mach_vm_protect(map, pg, pend - pg, FALSE, VM_PROT_READ | VM_PROT_EXECUTE);
+	if (ce || kr != KERN_SUCCESS) {
+		printf("SWEET ABP: fake boot: pid %d: write %d / vm_protect(r-x) %d failed\n", pid, ce, kr);
+		st = -7;
+		goto out;
+	}
+	vm_machine_attribute_val_t v = MATTR_VAL_CACHE_SYNC;
+	kr = mach_vm_machine_attribute(map, fn + 4 * ABM_PATCH_WORD, 4, MATTR_CACHE, &v);
+	if (copyin((user_addr_t)(fn + 4 * ABM_PATCH_WORD), &back, sizeof(back)) || back != ABM_INSN_RET0) {
+		printf("SWEET ABP: fake boot: pid %d: read-back 0x%08x: patch not in place\n", pid, back);
+		st = -8;
+		goto out;
+	}
+	printf("SWEET ABP: fake boot: pid %d CommCenter: shouldBoot() at 0x%llx (cache 0x%llx, slide 0x%llx) now returns 0 "
+	    "(word 0x%llx 0x%08x -> 0x%08x, private copy of page 0x%llx, cache sync %d, csflags 0x%llx)\n", pid, fn, cache_start,
+	    slide, fn + 4 * ABM_PATCH_WORD, ABM_INSN_RET1, back, pg, kr, (unsigned long long)proc_getcsflags(p));
+	st = 1;
+out:
+	abm_state = st;
+	abm_pid = pid;
+}
+
+/* ---- sysctls ---- */
+
+static int
+sysctl_abp(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int v = (int)sweet_abp_flags, changed = 0;
+	int e = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (e == 0 && changed) {
+		if (proc_suser(req->p) != 0) {
+			return EPERM;
+		}
+		printf("SWEET ABP: kern.sweet_abp 0x%x -> adds 0x%x\n", sweet_abp_flags, (uint32_t)v);
+		sweet_abp_apply((uint32_t)v & ABP_BITS_ALL);
+	}
+	return e;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_abp, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, sysctl_abp, "I",
+    "redfin 1061/1063: AppleBasebandPCI stand-in (1 services + /dev/abpbridge, 2 fake ABM boot, 4 trace, 8 publish on wland ready, "
+    "0x10 no PDPManagerBase, 0x20 un-publish on bridge close); only adds bits");
+
+static int
+sysctl_abp_publish(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int v = SweetABPPublished(), changed = 0;
+	int e = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (e == 0 && changed) {
+		if (proc_suser(req->p) != 0) {
+			return EPERM;
+		}
+		if (!ab.node) {
+			return ENXIO;
+		}
+		e = SweetABPPublish(v != 0, v ? "kern.sweet_abp_publish=1" : "kern.sweet_abp_publish=0");
+		if (e == EALREADY) {
+			e = 0;
+		}
+	}
+	return e;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_abp_publish, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, sysctl_abp_publish, "I",
+    "redfin 1063: 1 = baseband stand-ins published; write 1/0 to publish/un-publish now (debugging)");
+
+static int
+sysctl_abp_stage(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int v = (int)sweet_abp_bootstage, changed = 0;
+	int e = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (e == 0 && changed) {
+		sweet_abp_bootstage = (uint32_t)v;
+		SweetABPSetBootstage((uint32_t)v);
+	}
+	return e;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_abp_bootstage, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, sysctl_abp_stage, "I",
+    "redfin 1061: AppleBasebandPCIControl bootstage property (ABM: < 2 = down)");
+
+static int
+sysctl_abp_msg(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int v = 0, changed = 0;
+	int e = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (e == 0 && changed) {
+		SweetABPMessage((uint32_t)v);
+	}
+	return e;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_abp_msg, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, sysctl_abp_msg, "I",
+    "redfin 1061: write N = general-interest message N to AppleBasebandPCIControl's clients (experiments)");
+
+/* 1064 */
+static int
+sysctl_abp_readyms(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int v = (int)sweet_abp_readyms, changed = 0;
+	int e = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (e == 0 && changed) {
+		sweet_abp_readyms = v < 0 ? 0 : (uint32_t)v;
+		printf("SWEET ABP: readyms = %u\n", sweet_abp_readyms);
+	}
+	return e;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_abp_readyms, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, sysctl_abp_readyms, "I",
+    "redfin 1064: ms AppleBaseband reads as in reset after ABM starts, then 'alive' (0 = never in reset, the 1061 behaviour)");
+
+static int
+sysctl_abp_bbmsg(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int v = 0, changed = 0;
+	int e = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (e == 0 && changed) {
+		uint32_t code = (uint32_t)v;
+		if (v == 1) {
+			code = 0xe3ff8000u;     /* reset detected */
+		} else if (v == 2) {
+			code = 0xe3ff8001u;     /* alive */
+		}
+		SweetABPBasebandMessage(code);
+	}
+	return e;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_abp_bbmsg, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, NULL, 0, sysctl_abp_bbmsg, "I",
+    "redfin 1064: write 1 = 'reset detected' (0xe3ff8000), 2 = 'alive' (0xe3ff8001), other N = message N to AppleBaseband's clients");
+
+static int
+sysctl_abp_stats(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	char *s = kalloc_data(2048, Z_WAITOK | Z_ZERO);
+	if (s == NULL) {
+		return ENOMEM;
+	}
+	int n = SweetABPStats(s, 2048);
+	lck_mtx_lock(&abp_lock);
+	snprintf(s + n, 2048 - (size_t)n, " | bridge %s %s (ready %u x) queued %u B/%u rec, dropped %u (%u B), to wland %llu B, from wland %llu B"
+	    " | fakeboot state %d pid %d calls %u", ab.open ? "open" : "closed", ab.ready ? "READY" : "not ready", ab.readies, ab_used(), ab.records, ab.dropped,
+	    ab.dropped_bytes, ab.to_wland, ab.from_wland, abm_state, abm_pid, abm_count);
+	lck_mtx_unlock(&abp_lock);
+	int e = SYSCTL_OUT(req, s, strlen(s) + 1);
+	kfree_data(s, 2048);
+	return e;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_abp_stats, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, NULL, 0, sysctl_abp_stats, "A",
+    "redfin 1061: AppleBasebandPCI stand-in counters");
