+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * 2026-11-17 big cores first, take 2 (bsd/dev/sweet_cpufreq.c sweet_big_first). sched_perfcontrol_edge_cpu_rotation_
+ * bitmasks_set() is an empty stub here: CONFIG_SCHED_EDGE needs __AMP__, and SWEET is one SMP cluster (Clutch only).
+ * But choose_processor() reads the pset's perfcontrol_cpu_preferred_bitmask / _migration_bitmask in either build,
+ * so they are set directly: preferred = idle CPUs taken first, migration = idle CPUs avoided while a non-avoided one is
+ * idle. Returns what was set (masked with the pset's CPUs).
+ */
+void sweet_sched_cpu_masks(uint64_t preferred, uint64_t migrate, uint64_t *set_preferred, uint64_t *set_migrate);
+void
+sweet_sched_cpu_masks(uint64_t preferred, uint64_t migrate, uint64_t *set_preferred, uint64_t *set_migrate)
+{
+	processor_set_t pset = pset_array[0];
+	*set_preferred = *set_migrate = 0;
+	if (pset == PROCESSOR_SET_NULL) {
+		return;
+	}
+	spl_t s = splsched();
+	pset_lock(pset);
+	pset->perfcontrol_cpu_preferred_bitmask = preferred & pset->cpu_bitmask;
+	pset->perfcontrol_cpu_migration_bitmask = migrate & pset->cpu_bitmask & ~pset->perfcontrol_cpu_preferred_bitmask;
+	*set_preferred = pset->perfcontrol_cpu_preferred_bitmask;
+	*set_migrate = pset->perfcontrol_cpu_migration_bitmask;
+	pset_unlock(pset);
+	splx(s);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
