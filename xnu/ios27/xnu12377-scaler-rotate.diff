+/*
+ * sweet_scaler.c: sysctls for the CPU AppleM2ScalerCSCDriver stand-in (iokit/Kernel/arm/SweetM2Scaler.cpp).
+ * 2026-11-19 (ios-sweet, Claude): landscape games were black because backboardd's QuartzCore copies its portrait
+ * surface into landscape ones through the scaler (IOSurfaceAcceleratorTransformSurface, ~65 a second), which the
+ * stand-in refused.
+ *
+ *   kern.sweet_scaler_rot   (rw) how a request whose destination is the source turned (W x H -> H x W) is done:
+ *                           0 refuse (as before), 1 clockwise, 2 counter-clockwise (default 1)
+ *   kern.sweet_scaler_last  (r)  the latest refused or rotated request, 0x170 bytes in hex, with its surfaces
+ *   kern.sweet_scaler_stats (r)  counters
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/sysctl.h>
+#include <sys/errno.h>
+#include <kern/kalloc.h>
+
+int sweet_scaler_rot = 1;
+uint8_t sweet_scaler_last[0x170];
+char sweet_scaler_last_what[160];
+uint32_t sweet_scaler_last_n;
+uint64_t sweet_scaler_count_copied, sweet_scaler_count_rotated, sweet_scaler_count_refused, sweet_scaler_count_us;
+
+SYSCTL_INT(_kern, OID_AUTO, sweet_scaler_rot, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_scaler_rot, 0,
+    "SweetM2Scaler: turned requests 0 refuse, 1 clockwise, 2 counter-clockwise");
+
+static int
+sysctl_sweet_scaler_last(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	const size_t cap = 2048;
+	char *s = kalloc_data(cap, Z_WAITOK | Z_ZERO);
+	if (s == NULL) {
+		return ENOMEM;
+	}
+	size_t n = (size_t)snprintf(s, cap, "#%u %s", sweet_scaler_last_n, sweet_scaler_last_what);
+	for (uint32_t o = 0; o < sizeof(sweet_scaler_last) && n + 16 < cap; o += 4) {
+		uint32_t v;
+		bcopy(sweet_scaler_last + o, &v, sizeof(v));
+		if (o % 32 == 0) {
+			n += (size_t)snprintf(s + n, cap - n, "\n+%03x:", o);
+		}
+		n += (size_t)snprintf(s + n, cap - n, " %08x", v);
+	}
+	int e = SYSCTL_OUT(req, s, strlen(s) + 1);
+	kfree_data(s, cap);
+	return e;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_scaler_last, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, NULL, 0, sysctl_sweet_scaler_last, "A",
+    "SweetM2Scaler: the latest refused or rotated request (hex)");
+
+static int
+sysctl_sweet_scaler_stats(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	char s[200];
+	uint64_t done = sweet_scaler_count_copied + sweet_scaler_count_rotated;
+	snprintf(s, sizeof(s), "copied %llu rotated %llu refused %llu | rot %d | avg %llu us per done request",
+	    sweet_scaler_count_copied, sweet_scaler_count_rotated, sweet_scaler_count_refused, sweet_scaler_rot,
+	    done ? sweet_scaler_count_us / done : 0);
+	return SYSCTL_OUT(req, s, strlen(s) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_scaler_stats, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, NULL, 0, sysctl_sweet_scaler_stats, "A",
+    "SweetM2Scaler: counters");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
