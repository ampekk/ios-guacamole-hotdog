+/* 2026-11-19: a request whose destination is the source turned (W x H into H x W, both 32-bit RGB): QuartzCore's
+ * copy_iosurface in landscape (backboardd, 828x1792 -> 1792x828 about 65 times a second). Its rectangles are not
+ * decoded yet (they are nonzero); the whole surface is turned. Direction from kern.sweet_scaler_rot (bsd/dev/
+ * sweet_scaler.c): 1 clockwise (the source's top row becomes the right column), 2 counter-clockwise. Done in 32x32
+ * tiles so the column-wise reads stay in cache. */
+extern "C" {
+extern int sweet_scaler_rot;
+extern uint8_t sweet_scaler_last[0x170];
+extern char sweet_scaler_last_what[160];
+extern uint32_t sweet_scaler_last_n;
+extern uint64_t sweet_scaler_count_copied, sweet_scaler_count_rotated, sweet_scaler_count_refused, sweet_scaler_count_us;
+}
+
+static bool
+sweet_scaler_is32(SweetSurface *s)
+{
+    return s && (sweet_scaler_fourcc(s->pixelFormat, 'B','G','R','A') || sweet_scaler_fourcc(s->pixelFormat, 'R','G','B','A'));
+}
+
+static bool
+sweet_scaler_turned(SweetSurface *src, SweetSurface *dst)
+{
+    return sweet_scaler_is32(src) && sweet_scaler_is32(dst) && src->width && src->height &&
+        src->width != src->height && src->width == dst->height && src->height == dst->width;
+}
+
+static bool
+sweet_scaler_rotate(SweetSurface *src, SweetSurface *dst, int dir)
+{
+    if (dir != 1 && dir != 2) return false;
+    uintptr_t sb = src->kernelAddress(), db = dst->kernelAddress();
+    if (!sb || !db) return false;
+    uint32_t sw = src->width, sh = src->height, dw = dst->width, dh = dst->height;
+    uint32_t sp = src->bytesPerRow, dp = dst->bytesPerRow;
+    if (sw > 16384 || sh > 16384 || sp < sw * 4 || dp < dw * 4) return false;
+    uint64_t srcEnd = (uint64_t)(sh - 1) * sp + (uint64_t)sw * 4 + src->offset;
+    uint64_t dstEnd = (uint64_t)(dh - 1) * dp + (uint64_t)dw * 4 + dst->offset;
+    if (srcEnd > src->allocSize || dstEnd > dst->allocSize) return false;
+    const uint8_t *s = (const uint8_t *)sb + src->offset;
+    uint8_t *d = (uint8_t *)db + dst->offset;
+    bool swapRB = src->pixelFormat != dst->pixelFormat;
+    for (uint32_t ty = 0; ty < dh; ty += 32) {
+        for (uint32_t tx = 0; tx < dw; tx += 32) {
+            uint32_t ey = ty + 32 < dh ? ty + 32 : dh, ex = tx + 32 < dw ? tx + 32 : dw;
+            for (uint32_t y = ty; y < ey; y++) {
+                uint32_t *q = (uint32_t *)(d + (uint64_t)y * dp);
+                for (uint32_t x = tx; x < ex; x++) {
+                    /* clockwise: dst(x,y) = src(y, dw-1-x); counter-clockwise: dst(x,y) = src(dh-1-y, x) */
+                    uint32_t sx = dir == 1 ? y : dh - 1 - y;
+                    uint32_t sy = dir == 1 ? dw - 1 - x : x;
+                    uint32_t v = *(const uint32_t *)(s + (uint64_t)sy * sp + (uint64_t)sx * 4);
+                    if (swapRB) v = (v & 0xff00ff00u) | ((v >> 16) & 0xffu) | ((v & 0xffu) << 16);
+                    q[x] = v;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+static void
+sweet_scaler_note(const uint8_t *in, const char *what, SweetSurface *src, SweetSurface *dst, uint32_t srcID, uint32_t dstID)
+{
+    bcopy(in, sweet_scaler_last, sizeof(sweet_scaler_last));
+    sweet_scaler_last_n++;
+    snprintf(sweet_scaler_last_what, sizeof(sweet_scaler_last_what), "%s src=%u %08x %ux%u rows %u dst=%u %08x %ux%u rows %u", what,
+        srcID, src ? src->pixelFormat : 0, src ? src->width : 0, src ? src->height : 0, src ? src->bytesPerRow : 0,
+        dstID, dst ? dst->pixelFormat : 0, dst ? dst->width : 0, dst ? dst->height : 0, dst ? dst->bytesPerRow : 0);
+}
