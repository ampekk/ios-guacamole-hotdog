-__attribute__((noreturn))
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <pexpert/pexpert.h>
+extern int sweet_tb24;  /* osfmk/arm64/machine_routines.c */
+static unsigned sweet_tb24_logged;
+
+/*
+ * sweet 2026-11-17: with the 24 MHz timebase (pexpert/arm/pe_identify_machine.c) EL0 has no access to the generic
+ * timer (USER_TIMEBASE_NONE clears CNTKCTL_EL1.EL0VCTEN/EL0PCTEN), so a direct MRS of the counter or its frequency
+ * traps here. Answer it in the kernel's 24 MHz units: CNTVCT/CNTPCT(SS) = mach_absolute_time(), CNTFRQ = 24 MHz.
+ * ISS for EC 0x18: Op0 [21:20], Op2 [19:17], Op1 [16:14], CRn [13:10], Rt [9:5], CRm [4:1], read [0].
+ */
+static bool
+sweet_tb24_mrs(arm_saved_state_t *state, uint64_t esr)
+{
+	uint32_t iss = (uint32_t)ESR_ISS(esr);
+	unsigned op0 = (iss >> 20) & 3, op2 = (iss >> 17) & 7, op1 = (iss >> 14) & 7, crn = (iss >> 10) & 15;
+	unsigned rt = (iss >> 5) & 31, crm = (iss >> 1) & 15;
+	uint64_t v;
+	const char *what;
+
+	if (!sweet_tb24 || !(iss & 1) || op0 != 3 || op1 != 3 || crn != 14 || crm != 0) {
+		return false;
+	}
+	switch (op2) {
+	case 0:
+		v = gPEClockFrequencyInfo.timebase_frequency_hz;
+		what = "CNTFRQ_EL0";
+		break;
+	case 1:
+	case 2:
+	case 5:
+	case 6:
+		v = mach_absolute_time();
+		what = op2 == 1 ? "CNTPCT_EL0" : op2 == 2 ? "CNTVCT_EL0" : op2 == 5 ? "CNTPCTSS_EL0" : "CNTVCTSS_EL0";
+		break;
+	default:
+		return false;
+	}
+	if (rt != 31) {
+		saved_state64(state)->x[rt] = v;
+	}
+	add_saved_state_pc(state, 4);
+	if (sweet_tb24_logged < 16) {
+		sweet_tb24_logged++;
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		printf("SWEET TB24: EL0 read of %s in %s pc 0x%llx (emulated, 24 MHz)\n", what, name,
+		    (uint64_t)get_saved_state_pc(state) - 4);
+	}
+	return true;
+}
+#endif
+
