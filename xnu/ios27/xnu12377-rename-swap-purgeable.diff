+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * RENAME_SWAP on a filesystem without it (SWEET HFS: hfs_vnop_renamex supports only VFS_RENAME_EXCL and returns
+ * ENOTSUP). iOS 27's PosterFoundation (pf_nukeDirectoryAtURL "swap failed") and PosterKit (PRUpdatingService
+ * "relocation failed") swap directories with renamex_np(RENAME_SWAP) - APFS has it - so wallpaper extensions
+ * could never publish anything (Settings > Wallpaper spins). Done here as three exclusive renames through a
+ * temporary name next to @to:  to -> tmp, from -> to, tmp -> from,  undone step by step if one fails. Not
+ * atomic (a crash in between leaves the tmp name), which nothing here relies on. Boot-arg sweetswap=0: ENOTSUP.
+ */
+static int
+sweet_rename_swap(vfs_context_t ctx, int fromfd, user_addr_t from, int tofd, user_addr_t to, u_int flags)
+{
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("sweetswap", &on, sizeof(on));
+	if (!on) {
+		return ENOTSUP;
+	}
+	static volatile SInt32 seq;
+	char *buf = kalloc_data(3 * MAXPATHLEN, Z_WAITOK | Z_ZERO);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	char *f = buf, *t = buf + MAXPATHLEN, *tmp = buf + 2 * MAXPATHLEN;
+	size_t n;
+	int error = copyinstr(from, f, MAXPATHLEN, &n);
+	if (error == 0) {
+		error = copyinstr(to, t, MAXPATHLEN, &n);
+	}
+	if (error == 0) {
+		size_t tl = strlen(t);
+		while (tl > 1 && t[tl - 1] == '/') {    /* "dir/" -> "dir" */
+			t[--tl] = 0;
+		}
+		if (snprintf(tmp, MAXPATHLEN, "%s.sweetswap-%d-%u", t, proc_selfpid(), (unsigned)OSIncrementAtomic(&seq)) >=
+		    MAXPATHLEN) {
+			error = ENAMETOOLONG;
+		}
+	}
+	u_int ex = flags | RENAME_EXCL;
+	if (error == 0) {
+		error = renameat_internal(ctx, tofd, CAST_USER_ADDR_T(t), tofd, CAST_USER_ADDR_T(tmp), UIO_SYSSPACE, ex);
+	}
+	if (error == 0) {
+		error = renameat_internal(ctx, fromfd, CAST_USER_ADDR_T(f), tofd, CAST_USER_ADDR_T(t), UIO_SYSSPACE, ex);
+		if (error != 0) {
+			(void)renameat_internal(ctx, tofd, CAST_USER_ADDR_T(tmp), tofd, CAST_USER_ADDR_T(t), UIO_SYSSPACE, ex);
+		} else {
+			error = renameat_internal(ctx, tofd, CAST_USER_ADDR_T(tmp), fromfd, CAST_USER_ADDR_T(f), UIO_SYSSPACE,
+			    ex);
+			if (error != 0) {
+				(void)renameat_internal(ctx, tofd, CAST_USER_ADDR_T(t), fromfd, CAST_USER_ADDR_T(f), UIO_SYSSPACE, ex);
+				(void)renameat_internal(ctx, tofd, CAST_USER_ADDR_T(tmp), tofd, CAST_USER_ADDR_T(t), UIO_SYSSPACE, ex);
+			}
+		}
+	}
+	kfree_data(buf, 3 * MAXPATHLEN);
+	return error;
+}
+#endif
+
