+/*
+ * SWEET: iOS 27.2 launchd aborts right at its first service spawn ("service state: spawning"), with or
+ * without xpcproxy elision. Log every failing posix_spawn of launchd (pid 1) with its path and errno.
+ */
+static int posix_spawn_sweet_impl(proc_t ap, struct posix_spawn_args *uap, int32_t *retval);
+
+int
+posix_spawn(proc_t ap, struct posix_spawn_args *uap, int32_t *retval)
+{
+	int error = posix_spawn_sweet_impl(ap, uap, retval);
+	if (error != 0 && ap == initproc) {
+		char path[160];
+		size_t len = 0;
+		if (copyinstr(uap->path, path, sizeof(path), &len) != 0) {
+			strlcpy(path, "?", sizeof(path));
+		}
+		printf("SWEET SPAWN: launchd posix_spawn %s -> %d\n", path, error);
+	}
+	return error;
+}
